---
// The navy intro band under each service page hero (original layout): photo, one hello line with the About link, three short facts.
// Same layout on Websites, Tech, and Production (EN + ES); only the facts change from page to page.
import { Image } from 'astro:assets';
import headshot from '../assets/alexandria-cuellar.jpg';
import { langFromPath, localize } from '../i18n';

interface Props { facts: [string, string][] }
const { facts } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = {
  en: { hi: "Hi, I'm Alexandria,", line: "founder of Auva Studio. You'll work with me directly from the first call to launch.", more: 'More about me' },
  es: { hi: 'Hola, soy Alexandria,', line: 'fundadora de Auva Studio. Trabajará directamente conmigo desde la primera llamada hasta el lanzamiento.', more: 'Más sobre mí' },
}[lang];
---
<section class="hello-band" aria-label="Alexandria Cuellar">
  <div class="wrap hello"><Image src={headshot} alt="" width={120} height={120} densities={[1, 2]} /><span><b>{t.hi}</b> {t.line} <a href={localize('/about/', lang)}>{t.more}</a><ul class="hello-facts">{facts.map(([n, label]) => <li><b>{n}</b> {label}</li>)}</ul></span></div>
</section>
