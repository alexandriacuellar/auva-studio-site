---
// Inquiry section that closes the Websites, Consulting, and AI pages, and opens the Contact page (kind="general").
// The site is static, so the form posts to Web3Forms, which emails each message.
// The access key lives in src/data/site.ts; it is meant to be public.
// Links can preselect a choice with ?topic= or ?package=, followed by #start.
import Icon from './Icon.astro';
import { site } from '../data/site';

// topic preselects the website choice on a service's own page, such as topic="gbp".
interface Props { kind: 'website' | 'consulting' | 'ai' | 'general'; alt?: boolean; hero?: boolean; topic?: string }
const { kind, alt = false, hero = false, topic = 'website' } = Astro.props;
const isWebsite = kind === 'website';
const isAi = kind === 'ai';
const isGeneral = kind === 'general';
const Heading = hero ? 'h1' : 'h2';
const intro = isGeneral && !hero
  ? { eyebrow: 'Send a message', title: 'Tell me <em>about your project.</em>', lede: "Share a few details and I'll follow up personally with questions or a suggested next step." }
  : isGeneral
  ? { eyebrow: 'Contact', title: "Let's talk about <em>what you're working on.</em>", lede: "Book a free 30-minute call, or send a message and I'll reply within 24–48 hours. No detailed plan needed." }
  : isAi
  ? { eyebrow: 'Start exploring', title: 'Tell me <em>about your idea.</em>', lede: 'Early ideas and half-formed questions are welcome. No formal brief needed.' }
  : { eyebrow: 'Start a conversation', title: "Tell me <em>what you're working on.</em>", lede: 'Early ideas, projects already underway, and work alongside your current team or vendors are all welcome. No formal brief needed.' };
const subject = isGeneral ? 'New inquiry from auvastudio.com' : isWebsite ? 'New website inquiry from auvastudio.com' : isAi ? 'New AI & Emerging Tech inquiry from auvastudio.com' : 'New consulting inquiry from auvastudio.com';
const websiteTopics = [
  ['website', 'A new website (from $1,500)'],
  ['improve', 'Improve my current site'],
  ['store', 'An online store'],
  ['diagnostic', 'Website Diagnostic ($199)'],
  ['gbp', 'Google Business Profile ($500)'],
  ['care', 'Help after launch (updates and fixes)'],
  ['brand', 'Brand Essentials ($1,000)'],
];
// Each website service page gets its own heading, lede, and next step.
const replyLine = 'I read every message personally and reply within 24–48 hours.';
// Paid services list their buying steps in order, so the route to pay is plain.
const websiteIntro = ({
  website: { title: 'Tell me about <em>your website.</em>', lede: "Share a few details and I'll follow up personally with questions or a recommended package.", next: `${replyLine} You'll get a short written agreement with your package, price, and schedule before anything begins.` },
  diagnostic: { title: 'Get your <em>Website Diagnostic.</em>', lede: "Send your website address and anything that's bothering you about it.", button: 'Request my Diagnostic', steps: ['<b>Send this form.</b> I reply within 24–48 hours to confirm.', '<b>Pay $199</b> by secure payment link.', '<b>Get your report</b> within 5 business days.'] },
  gbp: { title: 'Get your profile <em>set up right.</em>', lede: "Send your business name and whether you already have a profile. I'll confirm which option fits.", button: 'Request my profile service', steps: ['<b>Send this form.</b> I reply within 24–48 hours with the option that fits.', '<b>Pay $500</b> by secure payment link.', '<b>I do the work</b> and send your profile guide.'] },
  care: { title: 'What would you like <em>changed?</em>', lede: 'Tell me what to update, or ask how updates work.', next: `${replyLine} If a request will take longer than about 30 minutes, I tell you the price first.` },
  brand: { title: 'Start your <em>Brand Essentials.</em>', lede: "Share a bit about your business and the look you're after.", button: 'Request Brand Essentials', steps: ['<b>Send this form.</b> I reply within 24–48 hours with a few questions.', '<b>Confirm the details and price</b> in writing before any work begins.', '<b>Choose your favorite</b> of two logo concepts.'] },
} as Record<string, { title: string; lede: string; next?: string; button?: string; steps?: string[] }>)[topic] ?? null;
const formAction = 'https://api.web3forms.com/submit';
---
<section id="start" class:list={{ alt, hero }}>
  <div class="wrap about-grid">
    <div>
      {isWebsite ? (
        <>
          <h2 class="mag-head" set:html={(websiteIntro ?? { title: 'Tell me about <em>your website.</em>' }).title} />
          <p class="lede">{websiteIntro?.lede}</p>
        </>
      ) : (
        <>
          <Heading class="mag-head" set:html={intro.title} />
          <p class="lede">{intro.lede}</p>
          <a class="btn" href={site.booking} target="_blank" rel="noopener" style="margin-top: 8px">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
          {isGeneral ? (
            hero ? <p class="muted small" style="margin-top: 12px">I read every message personally. You can also email <a href={`mailto:${site.email}`}>{site.email}</a>.</p> : <p class="muted small" style="margin-top: 12px">I read every message personally.</p>
          ) : (
            <p class="muted small" style="margin-top: 12px">Or send a message with the form.</p>
          )}
        </>
      )}
      <div class="values" style="margin-top: 28px">
        <div class="card card-row"><div class="icon"><Icon name="clock" /></div><div><h3>What happens next</h3>{websiteIntro?.steps ? (
          <ol class="next-steps">{websiteIntro.steps.map((st) => <li set:html={st} />)}</ol>
        ) : (
          <p class="muted">{isGeneral ? 'Any work is scoped and priced in writing before it begins.' : isWebsite && websiteIntro ? websiteIntro.next : `${replyLine} Any work is scoped and priced in writing before it begins.`}</p>
        )}</div></div>
        {isWebsite && (
          <div class="card card-row"><div class="icon"><Icon name="chat" /></div><div><h3>Prefer to talk?</h3><p class="muted"><a href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call</a> instead.</p></div></div>
        )}
      </div>
    </div>
    <div class="card">
      <form action={formAction} method="POST" class="inquiry">
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value={subject} />
        <input type="hidden" name="from_name" value="Auva Studio website" />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-row">
          <label>Name<input name="name" autocomplete="name" required /></label>
          <label>Email<input type="email" name="email" autocomplete="email" required /></label>
        </div>
        <div class="form-row">
          <label>Business or organization<input name="business" autocomplete="organization" /></label>
          <label><span>Phone <span class="opt">(optional)</span></span><input type="tel" name="phone" autocomplete="tel" /></label>
        </div>
        {isGeneral ? (
          <>
            <label>What's this about?
              <select name="topic">
                <option value="website">Website</option>
                <option value="consulting">Consulting or project support</option>
                <option value="ai">AI & Emerging Tech</option>
                <option value="unsure" selected>Not sure yet</option>
              </select>
            </label>
            <label><span>What are you working on? <span class="opt">(optional)</span></span><textarea name="message" rows="5"></textarea></label>
          </>
        ) : isWebsite ? (
          <>
            <div class="form-row">
              <label>What do you need?
                <select name="topic">
                  {websiteTopics.map(([value, label]) => <option value={value} selected={value === topic}>{label}</option>)}
                </select>
              </label>
              <label><span>Current website <span class="opt">(optional)</span></span><input type="url" name="website" placeholder="https://" /></label>
            </div>
            <input type="hidden" name="package" value="" />
            <label><span>Tell me about your business <span class="opt">(optional)</span></span><textarea name="message" rows="5"></textarea></label>
          </>
        ) : (
          <>
              {isAi ? (
                <label>Interested in
                  <select name="topic">
                    <option value="unsure">Not sure yet</option>
                    <option value="workshop">Team AI Workshop</option>
                    <option value="readiness">AI Readiness Plan</option>
                    <option value="ai-sprint">AI Prototype Sprint</option>
                    <option value="review">Concept & Feasibility Review</option>
                    <option value="xr-sprint">XR Prototype Sprint</option>
                    <option value="production">Production Support</option>
                  </select>
                </label>
              ) : (
                <label>Area
                  <select name="topic">
                    <option value="unsure">Not sure yet</option>
                    <option value="planning">Technology Planning</option>
                    <option value="analysis">Business Analysis & Process Review</option>
                    <option value="delivery">Project Management</option>
                    <option value="ai">AI & Emerging Tech</option>
                  </select>
                </label>
              )}
            <label><span>{isAi ? 'What are you exploring?' : "What's going on?"} <span class="opt">(optional)</span></span><textarea name="message" rows="5"></textarea></label>
          </>
        )}
        <button class="btn" type="submit">{(isWebsite && websiteIntro?.button) || 'Send message'}</button>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  // Preselect choices from links such as ?topic=diagnostic or ?package=Expanded%20Presence.
  const params = new URLSearchParams(location.search);
  for (const name of ['topic', 'package']) {
    const value = params.get(name);
    const select = document.querySelector<HTMLSelectElement>(`form.inquiry select[name="${name}"]`);
    if (value && select && [...select.options].some((o) => (o.value || o.text) === value)) select.value = value;
  }
  // Package buttons pass their choice along in a hidden field.
  const pkg = params.get('package');
  const pkgInput = document.querySelector<HTMLInputElement>('form.inquiry input[name="package"]');
  if (pkg && pkgInput) pkgInput.value = pkg;

  // Send without leaving the page; without JavaScript the form still posts normally.
  for (const form of document.querySelectorAll<HTMLFormElement>('form.inquiry')) {
    const status = form.querySelector<HTMLElement>('.form-status');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      if (status) status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
        const data = await res.json();
        if (!data.success) throw new Error(data.message);
        form.reset();
        (window as any).auvaConvert?.('form');
        if (status) status.textContent = "Thanks! Your message is on its way. You'll hear back within 24–48 hours.";
      } catch {
        if (status) status.textContent = 'Something went wrong. Please email me instead.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
