---
import Icon from './Icon.astro';
import * as en from '../data/site';
import * as es from '../data/site.es';
import { langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const { packages, packageBasics, samples } = lang === 'es' ? es : en;
const base = lang === 'es' ? '/es/websites/' : '/websites/';
const t = {
  en: { recommended: 'Recommended', once: 'once I have your content', sample: (n: string) => `See a sample ${n} site`, start: (n: string) => `Start with ${n}`, bigger: "<b>Need something different?</b> More than 20 pages, an online store, donations, member logins, or custom features. Let's talk about what you need and find the right fit. It might be a custom package, quoted for your project.", custom: 'Talk about a custom site', customPkg: 'Custom website', basics: 'Every package includes', notIncluded: 'Not included', upgrade: '<b>Start small, grow later.</b> Upgrade any time and pay only the difference. <b>Fixed prices, no surprises.</b> All prices are one-time project fees, and a $199 Website Diagnostic is credited toward your new website. <b>Need to spread out the cost?</b> I offer payment plans. <a href="#start">Ask me about one</a>.' },
  es: { recommended: 'Recomendado', once: 'una vez que tenga su contenido', sample: (n: string) => `Ver un sitio de muestra del paquete ${n}`, start: (n: string) => `Empezar con ${n}`, bigger: '<b>¿Necesita algo diferente?</b> Más de 20 páginas, una tienda en línea, donaciones, acceso para miembros o funciones especiales. Hablemos de lo que necesita y encontremos la mejor opción para usted. Puede ser un paquete a la medida, con presupuesto según su proyecto.', custom: 'Hablemos de un sitio a la medida', customPkg: 'Sitio a la medida', basics: 'Todos los paquetes incluyen', notIncluded: 'No incluido', upgrade: '<b>Empiece en pequeño y crezca después.</b> Cambie a un paquete mayor cuando quiera y pague solo la diferencia. <b>Precios fijos, sin sorpresas.</b> Todos los precios son pagos únicos por proyecto, y el Diagnóstico Web de $199 se abona a su sitio nuevo. <b>¿Prefiere pagar en partes?</b> Ofrezco planes de pago. <a href="#start">Pregúnteme por uno</a>.' },
}[lang];
---
<div class="pk-basics">
  <p class="pk-basics-title">{t.basics}</p>
  <ul class="ticks">{packageBasics.map((b) => <li><Icon name="tick" size={18} />{b}</li>)}</ul>
</div>
<div class="grid grid-3 packages">
  {packages.map((p) => (
    <article id={p.id} class:list={['card', 'package', { featured: p.featured }]}>
      {p.featured && <span class="rec">{t.recommended}</span>}
      <span class="tag">{p.eyebrow}</span>
      <h3>{p.name}</h3>
      <p class="muted">{p.blurb}</p>
      <p class="price">{p.price}</p>
      <dl class="pk-specs">
        {p.specs.map(([k, v]) => (
          <div><dt>{k}</dt><dd class:list={{ none: !v }}>{v ?? <><span aria-hidden="true">–</span><span class="sr-only">{t.notIncluded}</span></>}</dd></div>
        ))}
      </dl>
      <p class="time"><Icon name="clock" size={18} />{p.timeline} {t.once}</p>
      {(() => { const sm = samples.find((x) => x.package === p.name); return sm && <a class="sample-link" href={`/samples/${sm.slug}/`}>{t.sample(p.short)} <Icon name="arrow" size={16} /></a>; })()}
      <a class:list={['btn', { 'btn-ghost': !p.featured }]} href={`${base}?package=${encodeURIComponent(p.name)}#start`}>{t.start(p.short)}</a>
    </article>
  ))}
</div>
<div class="custom-band">
  <p set:html={t.bigger} />
  <a class="btn btn-ghost" href={`${base}?topic=website&package=${encodeURIComponent(t.customPkg)}#start`}>{t.custom}</a>
</div>
<p class="upgrade" set:html={t.upgrade} />
