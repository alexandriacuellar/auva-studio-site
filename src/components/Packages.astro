---
import Icon from './Icon.astro';
import { packages, samples } from '../data/site';

const [ess, exp, com] = packages;
const Y = true, N = false;
// Feature comparison for "Compare all features". Keep in step with the package cards above.
const rows: [string, (string | boolean)[]][] = [
  ['Price', [ess.price, exp.price, com.price]],
  ['Pages', ['1 scrolling page or up to 3', 'Up to 10', 'Up to 20, more quoted']],
  ['Page designs', ['1', 'Up to 3', 'Up to 6']],
  ['Planning call and content plan', [Y, Y, Y]],
  ['Copy polished, gaps filled in', [Y, Y, Y]],
  ['Made for phones first', [Y, Y, Y]],
  ['Contact form and map', [Y, Y, Y]],
  ['Set up for Google and AI search', [Y, Y, Y]],
  ['Google Business Profile guidance', [Y, Y, Y]],
  ['Visitor stats', ['Simple', 'Which pages bring calls', 'Which pages bring calls']],
  ['Content Editing Dashboard', [N, 'Add from $1,750', 'Included']],
  ['30-day search checkup', [N, N, Y]],
  ['Online store or donations', ['Quoted', 'Quoted', 'Quoted']],
  ['Revision rounds', ['2', '3', '4']],
  ['Timeline, once I have your content', [ess.timeline, exp.timeline, com.timeline]],
];
---
<div class="grid grid-3 packages">
  {packages.map((p) => (
    <article id={p.name.split(' ')[0].toLowerCase()} class:list={['card', 'package', { featured: p.featured }]}>
      {p.featured && <span class="rec">Recommended</span>}
      <span class="tag">{p.eyebrow}</span>
      <h3>{p.name}</h3>
      <p class="muted">{p.blurb}</p>
      <p class="price">{p.price}</p>
      <ul class="ticks">
        {p.features.map((f, i) => (
          <li><Icon name="tick" size={18} />{i === 0 && f.startsWith('Everything') ? <b>{f}</b> : f}</li>
        ))}
      </ul>
      {p.extra && <p class="extra"><Icon name="gear" size={18} />{p.extra}</p>}
      <p class="time"><Icon name="clock" size={18} />{p.timeline} once I have your content</p>
      {(() => { const sm = samples.find((x) => x.package === p.name); return sm && <a class="sample-link" href={`/samples/${sm.slug}/`}>See a sample {p.name.split(' ')[0]} site <span aria-hidden="true">→</span></a>; })()}
      <a class:list={['btn', { 'btn-ghost': !p.featured }]} href={`/websites/?package=${encodeURIComponent(p.name)}#start`}>Start with {p.name.split(' ')[0]}</a>
    </article>
  ))}
</div>
<details class="compare-all">
  <summary>Compare all features</summary>
  <div class="compare-wrap">
    <table>
      <thead>
        <tr><th scope="col"><span class="sr-only">Feature</span></th>{packages.map((p) => <th scope="col" class:list={{ us: p.featured }}>{p.name.split(' ')[0]}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map(([label, cells]) => (
          <tr>
            <th scope="row">{label}</th>
            {cells.map((c, i) => (
              <td class:list={{ us: packages[i].featured }}>
                {c === true ? <><Icon name="tick" size={18} /><span class="sr-only">Included</span></> : c === false ? <><span aria-hidden="true" class="none">–</span><span class="sr-only">Not included</span></> : c}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</details>
<p class="upgrade"><b>Start small, grow later.</b> Upgrade any time and pay only the difference. <b>Fixed prices, no surprises.</b> All prices are one-time project fees, and a $199 Website Diagnostic is credited toward your new website.</p>
