---
// Free "What can you automate?" check (StoryBrand review item 20, alexandria 2026-11-06).
// Visitors tick the tasks their team does by hand; the results show how each one would run.
// Rule from alexandria: every task here must be buildable with Make or Zapier and common small-business apps,
// because if they hire her she builds it. Check that before adding a task.
import '../styles/pages/website-check.css';
import { site } from '../data/site';
import { localize } from '../i18n';
interface Props { lang: 'en' | 'es' }
const { lang } = Astro.props;

const copy = {
  en: {
    groups: [
      { name: 'Customers', tasks: [
        { id: 'reply', task: 'Replying to new website inquiries', how: 'Every form message gets an instant thank-you email and lands in one list, like a Google Sheet or Trello board.', tools: 'Your website form, Gmail or Outlook, Google Sheets or Trello' },
        { id: 'nudge', task: 'Keeping track of which inquiries still need an answer', how: 'A daily message to you, by email or Slack, listing inquiries nobody has answered in 2 days.', tools: 'Google Sheets or Trello, Gmail or Slack' },
        { id: 'reviews', task: 'Asking happy customers for a Google review', how: 'When a job is marked done or an invoice is paid, the customer gets a thank-you with your review link, and one gentle reminder.', tools: 'QuickBooks, Square, or Google Sheets, plus Gmail' },
        { id: 'booking', task: 'Following up after someone books a call or appointment', how: 'When someone books, they get a welcome email with what to expect, and their details land in your list.', tools: 'Calendly or Acuity, Gmail, Google Sheets' },
        { id: 'onboard', task: 'Welcoming new clients', how: 'When a client signs or pays a deposit, they get a welcome email, and a client folder and a project card are created for you.', tools: 'Stripe, QuickBooks, or a form, Gmail, Google Drive, Trello or Asana' },
        { id: 'newsletter', task: 'Adding new contacts to your email list', how: 'People who tick "sign me up" on your form are added to your newsletter list automatically.', tools: 'Your website form, Mailchimp' },
      ] },
      { name: 'Money', tasks: [
        { id: 'invoices', task: 'Chasing unpaid invoices', how: 'A friendly reminder goes out when an invoice is overdue, and you get a weekly list of what is still open.', tools: 'QuickBooks, Stripe, or Square, Gmail' },
        { id: 'orders', task: 'Telling your team about new orders', how: 'Each new order is posted in Slack or sent by email, and added to a Google Sheet, so nothing is missed.', tools: 'Shopify, Square, or Stripe, Slack or Gmail, Google Sheets' },
        { id: 'receipts', task: 'Saving receipts and invoices from your email', how: 'Attachments from the senders you choose are saved to the right Google Drive folder, named by date.', tools: 'Gmail, Google Drive' },
      ] },
      { name: 'Office', tasks: [
        { id: 'copy', task: 'Copying information from one app to another', how: 'Form entries, sign-ups, or orders are copied into your spreadsheet or contact list, with no retyping.', tools: 'Your forms and apps, Google Sheets or HubSpot' },
        { id: 'report', task: 'Putting together a weekly or monthly report', how: 'Numbers from your spreadsheet are gathered into a short summary email, sent on the same day every week or month.', tools: 'Google Sheets, Gmail' },
        { id: 'tasks', task: 'Turning emails into to-dos', how: 'Emails you star or label become tasks with a due date in your project tool.', tools: 'Gmail, Trello, Asana, or ClickUp' },
      ] },
    ],
    pick: 'Tick everything your team does by hand.',
    count: (n: number) => `${n} selected`,
    none: 'Tick at least one task to see your results.',
    submit: 'See what I can automate',
    eyebrow: 'Your results',
    title: (n: number) => n === 1 ? 'This task can <em>run on its own.</em>' : `These ${n} tasks can <em>run on their own.</em>`,
    lede: 'Each one is one workflow, set up in your accounts with a short how-to guide. Automation is $500 per workflow, a founding price for my first 5 clients.',
    start: 'Start here',
    how: 'How it would work',
    builtWith: 'Built with',
    ask: 'Ask about automation, $500',
    call: 'Book a free call about my list',
    callNote: (list: string) => `Free automation check: I'd like to talk about automating ${list}.`,
    fine: 'Automations with several steps usually need your own paid Zapier or Make plan, about $20 to $30 a month, and a few apps, like Calendly, only connect on their paid plans. I\'ll tell you before we start.',
    sendTitle: 'Send me your list',
    sendText: "I'll reply personally with which one I'd start with, and what it would take. Free and optional.",
    name: 'Name', email: 'Email', business: 'Business or organization', optional: '(optional)',
    other: 'Anything else you do by hand?',
    sendBtn: 'Send my list',
    sending: 'Sending…',
    sent: "Thanks! I'll look at your list and reply within 24–48 hours.",
    failed: 'Something went wrong. Please email me instead.',
    subject: 'New automation check from auvastudio.com',
    change: 'Change my answers',
    askHref: '/automation-ai-projects/automation/?topic=automation#start',
  },
  es: {
    groups: [
      { name: 'Clientes', tasks: [
        { id: 'reply', task: 'Responder las consultas nuevas de su sitio web', how: 'Cada mensaje del formulario recibe al instante un correo de agradecimiento y queda en una sola lista, como una hoja de Google Sheets o un tablero de Trello.', tools: 'El formulario de su sitio, Gmail u Outlook, Google Sheets o Trello' },
        { id: 'nudge', task: 'Saber qué consultas siguen sin respuesta', how: 'Un mensaje diario para usted, por correo o Slack, con las consultas que nadie ha respondido en 2 días.', tools: 'Google Sheets o Trello, Gmail o Slack' },
        { id: 'reviews', task: 'Pedir reseñas de Google a clientes contentos', how: 'Cuando un trabajo se marca como terminado o se paga una factura, el cliente recibe un agradecimiento con el enlace para dejar su reseña, y un recordatorio amable.', tools: 'QuickBooks, Square o Google Sheets, más Gmail' },
        { id: 'booking', task: 'Dar seguimiento cuando alguien reserva una llamada o cita', how: 'Cuando alguien reserva, recibe un correo de bienvenida con lo que puede esperar, y sus datos quedan en su lista.', tools: 'Calendly o Acuity, Gmail, Google Sheets' },
        { id: 'onboard', task: 'Dar la bienvenida a clientes nuevos', how: 'Cuando un cliente firma o paga el depósito, recibe un correo de bienvenida, y se crean para usted una carpeta del cliente y una tarjeta del proyecto.', tools: 'Stripe, QuickBooks o un formulario, Gmail, Google Drive, Trello o Asana' },
        { id: 'newsletter', task: 'Agregar contactos nuevos a su lista de correo', how: 'Quienes marcan "quiero suscribirme" en su formulario se agregan solos a la lista de su boletín.', tools: 'El formulario de su sitio, Mailchimp' },
      ] },
      { name: 'Dinero', tasks: [
        { id: 'invoices', task: 'Cobrar facturas pendientes', how: 'Sale un recordatorio amable cuando una factura está vencida, y usted recibe cada semana una lista de lo que sigue pendiente.', tools: 'QuickBooks, Stripe o Square, Gmail' },
        { id: 'orders', task: 'Avisar a su equipo de pedidos nuevos', how: 'Cada pedido nuevo se publica en Slack o se envía por correo, y se agrega a una hoja de Google Sheets, para que nada se pierda.', tools: 'Shopify, Square o Stripe, Slack o Gmail, Google Sheets' },
        { id: 'receipts', task: 'Guardar recibos y facturas que llegan por correo', how: 'Los archivos adjuntos de los remitentes que usted elija se guardan en la carpeta correcta de Google Drive, con la fecha en el nombre.', tools: 'Gmail, Google Drive' },
      ] },
      { name: 'Oficina', tasks: [
        { id: 'copy', task: 'Copiar información de una aplicación a otra', how: 'Los formularios, suscripciones o pedidos se copian a su hoja de cálculo o lista de contactos, sin volver a escribir nada.', tools: 'Sus formularios y aplicaciones, Google Sheets o HubSpot' },
        { id: 'report', task: 'Preparar un informe semanal o mensual', how: 'Las cifras de su hoja de cálculo se juntan en un correo breve de resumen, que sale el mismo día cada semana o cada mes.', tools: 'Google Sheets, Gmail' },
        { id: 'tasks', task: 'Convertir correos en tareas', how: 'Los correos que marca con estrella o una etiqueta se convierten en tareas con fecha de entrega en su herramienta de proyectos.', tools: 'Gmail, Trello, Asana o ClickUp' },
      ] },
    ],
    pick: 'Marque todo lo que su equipo hace a mano.',
    count: (n: number) => `${n} ${n === 1 ? 'seleccionada' : 'seleccionadas'}`,
    none: 'Marque al menos una tarea para ver sus resultados.',
    submit: 'Ver qué puedo automatizar',
    eyebrow: 'Sus resultados',
    title: (n: number) => n === 1 ? 'Esta tarea puede <em>hacerse sola.</em>' : `Estas ${n} tareas pueden <em>hacerse solas.</em>`,
    lede: 'Cada una es un flujo de trabajo, configurado en sus cuentas con una guía breve. La automatización cuesta $500 por flujo de trabajo, un precio de fundación para mis primeros 5 clientes.',
    start: 'Empiece aquí',
    how: 'Cómo funcionaría',
    builtWith: 'Con',
    ask: 'Pregunte por la automatización, $500',
    call: 'Reserve una llamada gratis sobre su lista',
    callNote: (list: string) => `Revisión gratis de automatización: quiero hablar de automatizar ${list}.`,
    fine: 'Las automatizaciones con varios pasos suelen necesitar su propio plan de pago de Zapier o Make, de unos $20 a $30 al mes, y algunas aplicaciones, como Calendly, solo se conectan con sus planes de pago. Se lo digo antes de empezar.',
    sendTitle: 'Envíeme su lista',
    sendText: 'Le respondo personalmente con cuál empezaría yo y qué haría falta. Gratis y opcional.',
    name: 'Nombre', email: 'Correo', business: 'Negocio u organización', optional: '(opcional)',
    other: '¿Algo más que hagan a mano?',
    sendBtn: 'Enviar mi lista',
    sending: 'Enviando…',
    sent: '¡Gracias! Reviso su lista y le respondo en 24 a 48 horas.',
    failed: 'Algo salió mal. Por favor, escríbame por correo.',
    subject: 'Nueva revisión de automatización desde auvastudio.com (ES)',
    change: 'Cambiar mis respuestas',
    askHref: '/es/automation-ai-projects/automation/?topic=automation#start',
  },
}[lang];

const tasks = copy.groups.flatMap((g) => g.tasks);
const t = { count: copy.count('{n}'), none: copy.none, title1: copy.title(1), titleN: copy.title(99), start: copy.start, how: copy.how, builtWith: copy.builtWith, callNote: copy.callNote('{list}'), sending: copy.sending, sent: copy.sent, failed: copy.failed };
---
<section class="alt">
  <div class="wrap check-wrap">
    <form class="card check auto-check" id="check" novalidate>
      <p class="auto-pick">{copy.pick}</p>
      {copy.groups.map((g) => (
        <fieldset class="auto-group">
          <legend>{g.name}</legend>
          <div class="auto-tasks">
            {g.tasks.map((x) => (
              <label class="auto-task"><input type="checkbox" name="task" value={x.id} /><span>{x.task}</span></label>
            ))}
          </div>
        </fieldset>
      ))}
      <div class="check-foot">
        <p class="muted small" id="progress" aria-live="polite">{copy.count(0)}</p>
        <button class="btn" type="submit">{copy.submit}</button>
      </div>
    </form>

    <div class="results" id="results" hidden tabindex="-1">
      <div class="card score-card">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2 class="mag-head" id="res-title"></h2>
        <p class="lede">{copy.lede}</p>
        <div class="hero-actions">
          <a class="btn" href={copy.askHref}>{copy.ask}</a>
          <a class="btn btn-ghost" id="call" href={site.booking} target="_blank" rel="noopener">{copy.call}</a>
        </div>
      </div>

      <ol class="auto-results" id="list"></ol>
      <p class="small muted">{copy.fine}</p>

      <div class="card">
        <h3>{copy.sendTitle}</h3>
        <p class="muted">{copy.sendText}</p>
        <form action="https://api.web3forms.com/submit" method="POST" class="inquiry" id="send">
          <input type="hidden" name="access_key" value={site.web3formsKey} />
          <input type="hidden" name="subject" value={copy.subject} />
          <input type="hidden" name="from_name" value="Auva Studio website" />
          <input type="hidden" name="tasks" />
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="form-row">
            <label>{copy.name}<input name="name" autocomplete="name" required /></label>
            <label>{copy.email}<input type="email" name="email" autocomplete="email" required /></label>
          </div>
          <label><span>{copy.business} <span class="opt">{copy.optional}</span></span><input name="business" autocomplete="organization" /></label>
          <label><span>{copy.other} <span class="opt">{copy.optional}</span></span><textarea name="other" rows="3"></textarea></label>
          <button class="btn" type="submit">{copy.sendBtn}</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>

      <p class="small muted"><a href="#check" id="retake">{copy.change}</a></p>
    </div>
  </div>
</section>

<script is:inline define:vars={{ tasks, t, booking: site.booking }}>
  const form = document.getElementById('check');
  const progress = document.getElementById('progress');
  const results = document.getElementById('results');
  const picked = () => [...form.querySelectorAll('input[name="task"]:checked')].map((i) => tasks.find((x) => x.id === i.value));
  form.addEventListener('change', () => { progress.textContent = t.count.replace('{n}', picked().length); });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const list = picked();
    if (!list.length) { progress.textContent = t.none; form.querySelector('input[name="task"]').focus(); return; }
    document.getElementById('res-title').innerHTML = list.length === 1 ? t.title1 : t.titleN.replace('99', list.length);
    const ol = document.getElementById('list');
    ol.innerHTML = '';
    list.forEach((x, i) => {
      const li = document.createElement('li');
      li.className = 'card auto-result is-in';
      li.innerHTML = '<p class="eyebrow"></p><h3></h3><p class="muted"><b></b> <span></span></p><p class="auto-tools"><b></b> <span></span></p>';
      const eb = li.querySelector('.eyebrow');
      if (i === 0) eb.textContent = t.start; else eb.remove();
      li.querySelector('h3').textContent = x.task;
      const [how, tools] = li.querySelectorAll('p:not(.eyebrow)');
      how.querySelector('b').textContent = t.how + ':';
      how.querySelector('span').textContent = x.how;
      tools.querySelector('b').textContent = t.builtWith + ':';
      tools.querySelector('span').textContent = x.tools;
      ol.append(li);
    });
    const names = list.map((x) => x.task.toLowerCase()).join('; ');
    document.getElementById('call').href = `${booking}?a1=${encodeURIComponent(t.callNote.replace('{list}', names))}&utm_source=auvastudio&utm_campaign=automation-check`;
    document.getElementById('send').tasks.value = list.map((x) => `- ${x.task}`).join('\n');
    results.hidden = false;
    results.querySelectorAll('.card').forEach((c) => c.classList.add('is-in'));
    results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    results.focus({ preventScroll: true });
  });

  document.getElementById('retake').addEventListener('click', () => { results.hidden = true; });

  const send = document.getElementById('send');
  const status = send.querySelector('.form-status');
  send.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!send.reportValidity()) return;
    const btn = send.querySelector('button[type="submit"]');
    btn.disabled = true;
    status.textContent = t.sending;
    try {
      const res = await (await fetch(send.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(send) })).json();
      if (!res.success) throw new Error(res.message);
      window.auvaConvert?.('form');
      status.textContent = t.sent;
      btn.hidden = true;
    } catch {
      status.textContent = t.failed;
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .auto-pick { font-weight: 600; color: var(--ink); margin: 0 0 8px; }
  .auto-group { padding: 18px 0; border-bottom: 1px solid var(--border); }
  .auto-group legend::before { content: none; }
  .auto-group legend { font-family: var(--font-head); font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--primary); margin-bottom: 12px; }
  .auto-tasks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .auto-task { position: relative; display: flex; cursor: pointer; }
  .auto-task input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .auto-task span { flex: 1; padding: 12px 14px 12px 44px; border: 2px solid var(--border); border-radius: 14px; background: var(--white); font-weight: 600; line-height: 1.35; position: relative; transition: border-color .15s, background .15s; }
  .auto-task span::before { content: ''; position: absolute; left: 14px; top: 13px; width: 18px; height: 18px; border: 2px solid var(--border); border-radius: 5px; background: var(--white); }
  .auto-task input:checked + span { border-color: var(--primary); background: var(--surface); }
  .auto-task input:checked + span::before { background: var(--primary); border-color: var(--primary); box-shadow: inset 0 0 0 3px var(--white); }
  .auto-task input:focus-visible + span { outline: 3px solid var(--bright); outline-offset: 2px; }
  .auto-results { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .auto-result h3 { margin: 0 0 8px; }
  .auto-result p { margin: 0 0 6px; }
  .auto-result .eyebrow { color: var(--success); margin-bottom: 6px; }
  .auto-tools { font-size: 0.92rem; color: var(--ink); }
  .auto-check .check-foot { border-top: 0; }
  @media (max-width: 640px) { .auto-tasks { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .auto-task span { transition: none; } }
</style>
