---
// One row of tool logos for a service page. Sits inside an existing section (no section of its own).
import { toolSets } from '../data/tools';
import { toolIcons } from '../data/toolIcons';
interface Props { set: string; lang?: 'en' | 'es'; title?: string; lede?: string }
const { set, lang = 'en', title, lede } = Astro.props;
const heading = title ?? (lang === 'es' ? 'Herramientas y plataformas con las que trabajo' : 'Tools and platforms I work with');
---
<div class="tool-block">
  <h3 class="tool-title">{heading}</h3>
  {lede && <p class="muted tool-lede">{lede}</p>}
  <ul class="tool-grid">
    {toolSets[set].map((tool) => (
      <li class="tool">
        {tool.icon
          ? <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d={toolIcons[tool.icon]} /></svg>
          : <span class="tool-mono" aria-hidden="true">{tool.mark}</span>}
        <span class="tool-name">{tool.name}</span>
      </li>
    ))}
  </ul>
</div>
<style>
  .tool-block { margin-top: 56px; }
  .tool-title { font-size: 1.35rem; margin-bottom: 6px; }
  .tool-lede { max-width: 680px; margin-bottom: 0; }
  .tool-grid { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 12px; }
  .tool { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; min-height: 104px; padding: 16px 10px; background: var(--white); border: 1px solid var(--border); border-radius: 14px; text-align: center; }
  .tool svg { fill: var(--ink); }
  .tool-mono { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: var(--ink); color: var(--white); font-family: var(--font-head); font-size: 0.62rem; font-weight: 800; letter-spacing: 0.02em; }
  .tool-name { font-size: 0.88rem; font-weight: 600; color: var(--ink); line-height: 1.2; }
  @media (max-width: 520px) { .tool-grid { grid-template-columns: repeat(3, 1fr); gap: 8px; } .tool { min-height: 92px; padding: 12px 6px; } .tool-name { font-size: 0.8rem; } }
</style>
