---
import { site } from '../data/site';
import Icon from './Icon.astro';
import { langFromPath, localize } from '../i18n';
interface Props { title?: string; text?: string; promises?: string[] }
const lang = langFromPath(Astro.url.pathname);
const t = {
  en: { title: 'Bring me a problem, <em>project, or idea.</em>', text: "Tell me what's slowing you down, and you'll leave the call with a clear next step.", book: 'Book a free 30-minute call', message: 'Send a message' },
  es: { title: 'Tráigame un problema, <em>un proyecto o una idea.</em>', text: 'Cuénteme qué le está frenando y saldrá de la llamada con un siguiente paso claro.', book: 'Reserve una llamada gratis de 30 minutos', message: 'Envíe un mensaje' },
}[lang];
const { title = t.title, text = t.text, promises } = Astro.props;
---
<section class="cta">
  <div class="wrap">
    <h2 class="mag-head" set:html={title} />
    <p>{text}</p>
    <div class="cta-actions">
      <a class="btn" href={site.booking} target="_blank" rel="noopener">{t.book}</a>
      <a class="btn btn-outline-light" href={localize('/contact/', lang)}>{t.message}</a>
    </div>
    {promises && <ul class="promise-strip">{promises.map((p) => <li><Icon name="tick" size={16} />{p}</li>)}</ul>}
  </div>
</section>
