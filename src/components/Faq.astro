---
interface Props { faqs: { q: string; a: string; id?: string }[]; title?: string; lede?: string; alt?: boolean }
const { faqs, title = 'Before you <em>reach out.</em>', lede, alt = false } = Astro.props;
// FAQ data helps search engines and AI tools quote these answers directly.
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<section id="faq" class:list={{ alt }}>
  <div class="wrap about-grid">
    <div>
      <p class="eyebrow">Frequently asked questions</p>
      <h2 class="mag-head" set:html={title} />
      {lede && <p class="lede">{lede}</p>}
    </div>
    <div class="faq">
      {faqs.map((f) => (
        <details class="card" id={f.id}>
          <summary>{f.q}</summary>
          <p class="muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script>
  // Open the matching question when a link points to it, such as #faq-diagnostic.
  const openFromHash = () => {
    const el = location.hash && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) { el.open = true; el.classList.add('is-in'); el.scrollIntoView({ block: 'center' }); }
  };
  openFromHash();
  addEventListener('hashchange', openFromHash);
</script>
