---
// MOCKUP (2026-11-03): Game and XR Production sub page.
import Base from '../../../layouts/Base.astro';
import '../../../styles/pages/production-emerging-tech.css';
import Icon from '../../../components/Icon.astro';
import InquiryForm from '../../../components/InquiryForm.astro';
import Faq from '../../../components/Faq.astro';
import { site, testimonials, aiOffers } from '../../../data/site';

const review = aiOffers.find((o) => o.id === 'review')!;
const production = aiOffers.find((o) => o.id === 'production')!;
const offers = [
  { icon: 'search', title: review.title, price: review.price, text: 'I review your scope, milestones, and risks, and give you a plan your team can follow. About 2 weeks.', items: ['Scope, milestones, and risks reviewed', 'A plan and schedule your team can follow', 'Project tools set up if you need them'], topic: 'review' },
  { icon: 'star', title: production.title, price: '$65/hr, or monthly from $650', text: 'A producer inside your team: plans, schedules, design documents, playtests, and keeping everyone aligned. Join at the start or partway through.', items: ['Monthly: 10 hrs $650, 20 hrs $1,200, or 40 hrs $2,200', 'Agile workflow, sprints, design documents, and playtests', '3-month minimum for monthly'], topic: 'production' },
];
const faqs = [
  { q: 'Can you join a game or XR project already underway?', a: 'Yes. I review where things stand, set up a plan and schedule, and keep the team moving from there.' },
  { q: 'Which engines and platforms have you worked with?', a: 'Unity and Meta Quest, plus Meta Horizon Worlds. I manage the work and the schedule; your developers build in the engine you use.' },
  { q: 'Do you work remotely?', a: 'Yes. Most studio work is remote, across time zones, with the tools your team already uses.' },
];
---
<Base title="Game and XR Production (mockup)" description="Mockup of the Game and XR Production sub page.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">A producer for game and XR teams, <em>without a full-time hire.</em></h1>
      <p class="lede">Plans, schedules, design documents, and playtests that keep your team aligned and your launch on track.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="#offers">See how I help</a>
      </div>
    </div>
  </section>

  <section class="alt" id="offers">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Start with a plan, <em>or bring me onto the team.</em></h2>
        <p class="lede">14+ game and XR projects managed for indie studios since 2023.</p>
      </div>
      <div class="grid grid-2">
        {offers.map((p) => (
          <div class="card offer" id={p.topic}>
            <div class="icon"><Icon name={p.icon} size={32} /></div>
            <h3>{p.title}</h3>
            <p class="svc-meta"><b>{p.price}</b></p>
            <p class="muted">{p.text}</p>
            <ul class="ticks">{p.items.map((i) => <li><Icon name="tick" size={18} />{i}</li>)}</ul>
            <a class="more" href={`?topic=${p.topic}#start`} style="margin-top: 12px">Ask about this <Icon name="arrow" size={16} /></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="proof">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">From the studios <em>I've worked with.</em></h2>
      </div>
      <div class="grid grid-3">
        {testimonials.map((t) => (
          <figure class="card quote">
            <blockquote>“{t.quote}”</blockquote>
            <figcaption><b>{t.name}</b><span class="muted">{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Faq faqs={faqs} alt />
  <InquiryForm kind="ai" topic="production" />
</Base>
