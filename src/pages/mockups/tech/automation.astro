---
// MOCKUP (2026-11-02): Automation sub page of Tech, Automation & AI.
import Base from '../../../layouts/Base.astro';
import '../../../styles/pages/production-emerging-tech.css';
import Icon from '../../../components/Icon.astro';
import InquiryForm from '../../../components/InquiryForm.astro';
import Faq from '../../../components/Faq.astro';
import { site } from '../../../data/site';
import { base, safety, vendors } from './_data';

const examples = [
  { icon: 'mail', title: 'Lead follow-up', text: 'Every website inquiry gets an instant reply and lands in one list, with a nudge to you if nobody answers in 2 days.' },
  { icon: 'star', title: 'Review requests', text: 'After a job or visit, a thank-you with your Google review link and one gentle reminder.' },
  { icon: 'gear', title: 'Your own', text: 'Client onboarding, a monthly report, or another task your team does by hand.' },
];

const faqs = [
  { q: 'Does every automation use AI?', a: "No. Most don't need it. I use AI only where it helps, like sorting messages or drafting a reply you approve." },
  { q: 'What if an app we use changes and an automation stops?', a: 'Fixes are free for 30 days. After that, a fix is usually under an hour at my $125 hourly rate, quoted first.' },
  { q: 'Which tools do you use?', a: 'Zapier or Make, connected to the apps you already have, like Gmail, Google Sheets, your website form, and your booking or invoicing tool.' },
  vendors,
];
---
<Base title="Automation (mockup)" description="Mockup of the Automation sub page.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <p class="small"><a href={`${base}/`}>Tech, Automation & AI</a></p>
      <h1 class="mag-head">Automate the busywork, <em>$500 per workflow.</em></h1>
      <p class="lede">I connect the tools you already use so routine work happens on its own. Set up in your accounts, with a short how-to guide.</p>
      <div class="hero-actions">
        <a class="btn" href="?topic=automation#start">Ask about automation <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call</a>
      </div>
    </div>
  </section>

  <section class="alt" id="examples">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">What I can <em>automate.</em></h2>
        <p class="lede">One workflow is one task from start to finish. Here are the most common.</p>
      </div>
      <div class="grid grid-3">
        {examples.map((e) => (
          <div class="card">
            <div class="icon"><Icon name={e.icon} size={32} /></div>
            <h3>{e.title}</h3>
            <p class="muted">{e.text}</p>
          </div>
        ))}
      </div>
      <p class="small muted" style="margin-top: 24px">Automations with several steps usually need your own paid Zapier or Make plan, about $20 to $30 a month. I'll tell you before we start.</p>
    </div>
  </section>

  <section id="safe">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Built to be safe, <em>and yours.</em></h2>
      </div>
      <div class="grid grid-2">
        {safety.map((s) => (
          <div class="card">
            <div class="icon"><Icon name={s.icon} size={32} /></div>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </div>
        ))}
      </div>
      <p class="muted" style="margin-top: 32px"><b>Not sure what to automate first?</b> Start with a <a href={`${base}/#planning`}>$250 Tech Review</a>, credited toward your first workflow.</p>
    </div>
  </section>

  <Faq faqs={faqs} alt />
  <InquiryForm kind="consulting" topic="automation" />
</Base>
