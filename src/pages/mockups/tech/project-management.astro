---
// MOCKUP (2026-11-02): Project Management sub page of Tech, Automation & AI.
import Base from '../../../layouts/Base.astro';
import '../../../styles/pages/production-emerging-tech.css';
import Icon from '../../../components/Icon.astro';
import InquiryForm from '../../../components/InquiryForm.astro';
import Faq from '../../../components/Faq.astro';
import { site, testimonials } from '../../../data/site';
import { base, vendors, inPerson } from './_data';

const quote = testimonials.find((t) => t.name === 'Aaron Sorrels')!;

const packages = [
  { icon: 'layers', title: 'Project workspace setup', price: 'From $400', topic: 'workspace', text: 'Get work out of email and spreadsheets and into one tool, like Asana, ClickUp, monday.com, Notion, or Trello. You choose the tool, or I’ll recommend one. More boards or projects to move are quoted, usually $750 to $1,500.', items: ['1 board with your stages', 'Up to 3 templates for repeat work', 'Up to 5 current projects moved in', 'A 1-hour team training and 30 days of questions'] },
  { icon: 'check', title: 'Project Kickoff Plan', price: '$650', topic: 'delivery', text: 'Before a project starts: a clear scope, timeline, owners, and risks, ready to bring into your tool.', items: ['Up to 2 planning sessions with your team', 'Scope and milestones in writing', 'Who does what, and when', 'Written plan within 5 business days', 'A task list that imports into Asana, ClickUp, monday.com, Notion, and most other tools', 'Credited toward your first month of project management'] },
  { icon: 'compass', title: 'Monthly project management', price: 'From $650/mo', topic: 'delivery', text: 'Someone to keep your project on track, run check-ins, and handle vendors, without a full-time hire.', items: ['10 hrs $650, 20 hrs $1,200, 40 hrs $2,200', 'A short written update every week', '3-month minimum'] },
];

const faqs = [
  { q: 'Which one should I start with?', a: 'If your team has no shared tool yet, start with the workspace setup. If a big project is about to start, start with the Kickoff Plan. If the project is already moving and needs someone to run it, go monthly.' },
  vendors,
  inPerson,
];
---
<Base title="Project Management (mockup)" description="Mockup of the Project Management sub page.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <p class="small"><a href={`${base}/`}>Tech, Automation & AI</a></p>
      <h1 class="mag-head">Projects that finish, <em>without a full-time hire.</em></h1>
      <p class="lede">A clear plan, one place for the work, and someone to keep your team and vendors on schedule.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="#packages">See packages</a>
      </div>
    </div>
  </section>

  <section class="alt" id="packages">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Three ways <em>to get organized.</em></h2>
        <p class="lede">Start with one. Each one leads into the next when you're ready.</p>
      </div>
      <div class="grid grid-3">
        {packages.map((p) => (
          <div class="card offer">
            <div class="icon"><Icon name={p.icon} size={32} /></div>
            <h3>{p.title}</h3>
            <p class="svc-meta"><b>{p.price}</b></p>
            <p class="muted">{p.text}</p>
            <ul class="ticks">{p.items.map((i) => <li><Icon name="tick" size={18} />{i}</li>)}</ul>
            <a class="more" href={`?topic=${p.topic}#start`} style="margin-top: 12px">Ask about this <Icon name="arrow" size={16} /></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="proof">
    <div class="wrap">
      <figure class="card quote" style="max-width: 720px; margin: 0 auto">
        <blockquote>“{quote.quote}”</blockquote>
        <figcaption><b>{quote.name}</b><span class="muted">{quote.role}</span></figcaption>
      </figure>
    </div>
  </section>

  <Faq faqs={faqs} alt />
  <InquiryForm kind="consulting" topic="delivery" />
</Base>
