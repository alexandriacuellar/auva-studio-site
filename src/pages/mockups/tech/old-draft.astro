---
// MOCKUP (2026-11-02): proposed rebuild of /technology-consulting/ as fixed-scope packages.
// Hidden: noindex via public/_headers (/mockups/*), not in the sitemap, not linked. Prices are suggestions for alexandria to decide.
import Base from '../../../layouts/Base.astro';
import '../../../styles/pages/production-emerging-tech.css';
import Icon from '../../../components/Icon.astro';
import HelloBand from '../../../components/HelloBand.astro';
import InquiryForm from '../../../components/InquiryForm.astro';
import Faq from '../../../components/Faq.astro';
import { site, testimonials } from '../../../data/site';

const quote = testimonials.find((t) => t.name === 'Aaron Sorrels')!;

const audiences = [
  { icon: 'globe', title: 'Shops, restaurants, and local services', text: 'Inquiries slip through, reviews never get asked for, and invoices need chasing.' },
  { icon: 'book', title: 'Nonprofits', text: 'A small team doing the same tasks twice, on a tight budget.' },
  { icon: 'key', title: 'Startups', text: 'A first product, new systems, and a project that needs someone keeping it on track.' },
  { icon: 'chart', title: 'Offices and growing teams', text: 'More people and more projects, with work spread across email, chats, and spreadsheets.' },
  { icon: 'bulb', title: 'Teams curious about AI', text: "You know AI could help, but not where to start or what's safe to share with it." },
];


const aiPackages = [
  { icon: 'bulb', title: '1-on-1 AI Session', price: '$150', text: 'For owners and solo pros. 90 minutes, just you and me, working on your own tasks in the AI tool you choose.', items: ['Set up safely on your account', 'Practice on your real work', 'Your saved prompts to keep'], link: 'Ask about this', topic: 'ai-session' },
  { icon: 'chat', title: 'Team AI Workshop', price: 'Coming soon', text: 'The same hands-on approach for up to 10 people, with safe account setup, saved prompts, and one-page AI rules for your team.', items: ['Practice on real tasks together', 'What is safe to share, and what is not', 'A one-page guide to keep'], link: 'Ask to be first in line', topic: 'workshop' },
];

const projectPackages = [
  { icon: 'layers', title: 'Project workspace setup', price: 'From $400', text: 'Get work out of email and spreadsheets and into one tool, like Asana, ClickUp, monday.com, Notion, or Trello. You choose the tool, or I’ll recommend one. More boards or projects to move are quoted, usually $750 to $1,500.', items: ['1 board with your stages', 'Up to 3 templates for repeat work', 'Up to 5 current projects moved in', 'A 1-hour team training and 30 days of questions'] },
  { icon: 'check', title: 'Project Kickoff Plan', price: '$650', text: 'Before a project starts: a clear scope, timeline, owners, and risks, ready to bring into your tool.', items: ['Up to 2 planning sessions with your team', 'Scope and milestones in writing', 'Who does what, and when', 'Written plan within 5 business days', 'A task list that imports into Asana, ClickUp, monday.com, Notion, and most other tools', 'Credited toward your first month of project management'] },
  { icon: 'compass', title: 'Monthly project management', price: 'From $650/mo', text: 'Someone to keep your project on track, run check-ins, and handle vendors, without a full-time hire.', items: ['10 hrs $650, 20 hrs $1,200, 40 hrs $2,200', 'A short written update every week', '3-month minimum'] },
];

const aiTasks = [
  { icon: 'mail', title: 'Answer customer emails faster', text: 'Draft replies to common questions, then check and send.' },
  { icon: 'book', title: 'Write job posts and descriptions', text: 'Turn a few notes into a clear first draft.' },
  { icon: 'clock', title: 'Turn meetings into to-dos', text: 'Summaries and next steps, without retyping your notes.' },
  { icon: 'chat', title: 'Draft social posts and newsletters', text: 'A week of ideas and drafts in your own voice.' },
  { icon: 'search', title: 'Find answers in your own documents', text: 'Ask your handbook, policies, or price list a question.' },
  { icon: 'layers', title: 'First drafts of quotes and proposals', text: 'Start from a draft instead of a blank page.' },
];

const safety = [
  { icon: 'key', title: 'Your accounts, your data', text: 'Everything is built in accounts you own. You add me as a user and remove me when the work is done.' },
  { icon: 'shield', title: 'You approve every message', text: 'Nothing goes to a customer until you have read and approved the wording.' },
  { icon: 'book', title: 'A how-to guide for each one', text: 'Plain steps to pause, change, or turn it off, so you are never stuck with it.' },
  { icon: 'wrench', title: '30 days of fixes', text: 'If something breaks in the first 30 days, I fix it at no charge.' },
];

const faqs = [
  { q: 'Is it safe to use AI with our business data?', a: 'It can be, with business accounts and the right settings. Every AI session covers what is safe to share.' },
  { q: 'What if an app we use changes and an automation stops?', a: 'Fixes are free for 30 days. After that, a fix is usually under an hour at my $125 hourly rate, quoted first.' },
  { q: 'Do you work in person?', a: 'Yes, from New York City and Westchester up to Albany, though most work happens remotely. On-site time is $65 an hour, and any travel outside the Mid-Hudson Valley is agreed in writing before booking.' },
  { q: 'Can you work with our current vendors or IT provider?', a: 'Yes. I often work alongside existing teams and vendors, and can help you review their proposals.' },
];

---
<Base title="Tech, Automation & AI (mockup)" description="Mockup of the Tech, Automation & AI page.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Less busywork, better tools, <em>projects that finish.</em></h1>
      <p class="lede">The right software for how you work, automation for the repetitive work, and AI your team can use with confidence.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="#packages">See packages</a>
      </div>
    </div>
  </section>

  <HelloBand facts={["<b>20+</b> years in web development", "<b>14+</b> projects managed", "<b>AI</b> in my daily work"]} />

  <section class="alt" id="who">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Who I <em>work with.</em></h2>
      </div>
      <div class="grid grid-3 who">
        {audiences.map((a) => (
          <div class="card">
            <div class="icon"><Icon name={a.icon} size={32} /></div>
            <h3>{a.title}</h3>
            <p class="muted">{a.text}</p>
          </div>
        ))}
        <div class="card who-other">
          <div class="icon"><Icon name="chat" size={32} /></div>
          <h3>Something else?</h3>
          <p>Tell me what's slowing your team down, and I'll suggest where to start.</p>
          <a class="more" href="?topic=unsure#start" style="margin-top: 12px">Talk it through <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <section id="packages">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Fixed packages, <em>priced up front.</em></h2>
        <p class="lede">Pick the one that fits, or start with a Tech Review and I'll tell you which ones are worth it.</p>
      </div>

      <div class="card card-row bigger" id="planning">
        <div class="icon"><Icon name="search" size={36} /></div>
        <div>
          <h3>Not sure where to start? Tech Review, $250</h3>
          <p class="muted">A 60-minute call about your tools and how work gets done, then a written report within 5 business days with your top fixes in order. Credited toward any package within 90 days.</p>
          <a class="more" href="?topic=planning#start" style="margin-top: 12px">Book a Tech Review <Icon name="arrow" size={16} /></a>
        </div>
      </div>

      <div class="card card-row bigger" style="margin-top: 24px" id="automation">
        <div class="icon"><Icon name="gear" size={36} /></div>
        <div>
          <h3>Automation setup, $500 per workflow</h3>
          <p class="muted">I connect the tools you already use so routine work happens on its own. One workflow, set up in your accounts, with a short how-to guide.</p>
          <ul class="ticks">
            <li><Icon name="tick" size={18} /><span><b>Lead follow-up:</b> every website inquiry gets an instant reply and lands in one list, with a nudge to you if nobody answers in 2 days.</span></li>
            <li><Icon name="tick" size={18} /><span><b>Review requests:</b> after a job or visit, a thank-you with your Google review link and one gentle reminder.</span></li>
            <li><Icon name="tick" size={18} /><span><b>Your own:</b> client onboarding, a monthly report, or another task your team does by hand.</span></li>
          </ul>
          <p class="small muted" style="margin-top: 12px">Automations with several steps usually need your own paid Zapier or Make plan, about $20 to $30 a month. I'll tell you before we start.</p>
          <a class="more" href="?topic=automation#start" style="margin-top: 12px">Ask about automation <Icon name="arrow" size={16} /></a>
        </div>
      </div>

      <div class="offer-group" style="margin-top: 48px" id="ai">
        <h3 class="offer-group-title">AI for you and your team</h3>
        <p class="muted">No technical skills needed. Using ChatGPT, Claude, Gemini, or Meta AI.</p>
        <div class="grid grid-2">
          {aiPackages.map((p) => (
            <div class="card offer">
              <div class="icon"><Icon name={p.icon} size={32} /></div>
              <h3>{p.title}</h3>
              <p class="svc-meta"><b>{p.price}</b></p>
              <p class="muted">{p.text}</p>
              <ul class="ticks">{p.items.map((i) => <li><Icon name="tick" size={18} />{i}</li>)}</ul>
              <a class="more" href={`?topic=${p.topic}#start`} style="margin-top: 12px">{p.link} <Icon name="arrow" size={16} /></a>
            </div>
          ))}
        </div>
      </div>

      <div class="offer-group" id="delivery">
        <h3 class="offer-group-title">Tools and projects</h3>
        <p class="muted">Get work out of email and spreadsheets, and keep projects moving.</p>
        <div class="grid grid-2">
          {projectPackages.map((p) => (
            <div class="card offer">
              <div class="icon"><Icon name={p.icon} size={32} /></div>
              <h3>{p.title}</h3>
              <p class="svc-meta"><b>{p.price}</b></p>
              <p class="muted">{p.text}</p>
              <ul class="ticks">{p.items.map((i) => <li><Icon name="tick" size={18} />{i}</li>)}</ul>
              <a class="more" href={`?topic=${p.title.includes('workspace') ? 'workspace' : 'delivery'}#start`} style="margin-top: 12px">Ask about this <Icon name="arrow" size={16} /></a>
            </div>
          ))}
        </div>
      </div>
      <p class="muted" style="margin-top: 32px">Just need advice? Consulting sessions are $65 an hour. Want an AI chatbot on your website? See <a href="/websites/#addons">website add-ons</a>.</p>
    </div>
  </section>

  <section class="alt" id="ai-uses">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Put AI to work <em>in the work you already do.</em></h2>
        <p class="lede">I use AI tools in my own work every day. Here's what small teams use them for.</p>
      </div>
      <div class="grid grid-3 ai-tasks">
        {aiTasks.map((t) => (
          <div class="card card-row">
            <div class="icon"><Icon name={t.icon} size={28} /></div>
            <div><h3>{t.title}</h3><p class="muted small">{t.text}</p></div>
          </div>
        ))}
      </div>
      <p class="small muted" style="margin-top: 20px"><b>Tools I use.</b> ChatGPT, Claude, Gemini, Meta AI, and Zapier.</p>
    </div>
  </section>

  <section id="safe">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Built to be safe, <em>and yours.</em></h2>
        <p class="lede">The same rules for every package.</p>
      </div>
      <div class="grid grid-2">
        {safety.map((s) => (
          <div class="card">
            <div class="icon"><Icon name={s.icon} size={32} /></div>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt" id="how">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">How it <em>works.</em></h2>
      </div>
        <ol class="steps steps-4">
          <li><span class="num" aria-hidden="true">1</span><h3>Free call</h3><p>Tell me what eats your week. I'll point you to a package, or a Tech Review if it isn't clear yet.</p></li>
          <li><span class="num" aria-hidden="true">2</span><h3>Written scope and price</h3><p>What I'll set up, in which tools, and the price, before any work starts.</p></li>
          <li><span class="num" aria-hidden="true">3</span><h3>Set up and test</h3><p>I build it in your accounts. You approve the wording and we test it together.</p></li>
          <li><span class="num" aria-hidden="true">4</span><h3>Handover</h3><p>A short how-to guide, a walkthrough with your team, and 30 days of fixes.</p></li>
        </ol>
      <figure class="card quote" style="max-width: 720px; margin: 48px auto 0">
        <blockquote>“{quote.quote}”</blockquote>
        <figcaption><b>{quote.name}</b><span class="muted">{quote.role}</span></figcaption>
      </figure>
    </div>
  </section>

  <Faq faqs={faqs} />
  <InquiryForm kind="consulting" alt />
</Base>
