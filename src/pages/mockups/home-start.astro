---
// Mockup for review (noindex via public/_headers): Home "Find your situation" as a 3-column board.
import Base from '../../layouts/Base.astro';
import '../../styles/pages/home.css';
import Icon from '../../components/Icon.astro';

const columns = [
  {
    icon: 'globe', name: 'Websites', href: '/websites/',
    items: [
      { title: 'I need a website', text: "You're starting something new, or you've never had one.", href: '/websites/', to: 'Website packages', icon: 'globe' },
      { title: "My website isn't working for me", text: "It's outdated, slow, or hard to update.", href: '/websites/diagnostic/', to: 'Website Diagnostic', icon: 'search' },
      { title: "Customers can't find me on Google Maps", text: 'Your listing is missing, out of date, or buried.', href: '/websites/google-business-profile/', to: 'Google Business Profile', icon: 'star' },
    ],
  },
  {
    icon: 'bulb', name: 'Automation, AI & Projects', href: '/technology-consulting/',
    items: [
      { title: 'We do the same tasks by hand every week', text: 'Follow-ups, data entry, and reports that could run on their own.', href: '/technology-consulting/automation/', to: 'Automation', icon: 'gear' },
      { title: 'I want to use AI, but I’m not sure where to start', text: "Or what's safe to share with it.", href: '/technology-consulting/ai/', to: 'AI for you and your team', icon: 'bulb' },
      { title: 'This project needs someone to lead it', text: 'Scope, schedule, vendors, and people, kept on track.', href: '/technology-consulting/project-management/', to: 'Project management', icon: 'check' },
    ],
  },
  {
    icon: 'bolt', name: 'AR, VR & Production', href: '/production-emerging-tech/',
    items: [
      { title: 'I want customers to see my product before they buy', text: 'Your product in 3D, in their room, right from their phone.', href: '/production-emerging-tech/ar/#ar-product', to: 'AR packages', icon: 'layers' },
      { title: 'I want my menu, packaging, or flyer to do more', text: 'Scan it and it comes to life, with buttons to order or book.', href: '/production-emerging-tech/ar/#ar-menu', to: 'AR packages', icon: 'book' },
      { title: "We're making a game or XR project", text: 'An experienced producer to keep it on track.', href: '/production-emerging-tech/studios/', to: 'Game and XR production', icon: 'bolt' },
    ],
  },
];
---
<Base title="Mockup: Find your situation" description="Mockup for review.">
  <section class="home-routes">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Not sure where to start? <em>Find your situation.</em></h2>
        <p class="lede">Pick the one that sounds most like you.</p>
      </div>
      <div class="sit-board">
        {columns.map((c) => (
          <div class="sit-col">
            <a class="sit-col-head" href={c.href}><Icon name={c.icon} size={20} /> {c.name}</a>
            <ul>
              {c.items.map((x) => (
                <li><a class="sit-card" href={x.href}>
                  <b>{x.title}</b>
                  <span class="muted">{x.text}</span>
                  <span class="sit-to">{x.to} <Icon name="arrow" size={16} /></span>
                </a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="sit-else">
        <p><b>Something else?</b> Too many apps, or not sure what you need. Start with a <a href="/technology-consulting/#planning">$250 Tech Review</a> or <a href="/contact/">tell me what's happening</a>.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .sit-board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; }
  .sit-col-head { display: flex; align-items: center; gap: 10px; padding: 0 4px 14px; margin-bottom: 14px; border-bottom: 2px solid var(--primary); font-family: var(--font-head); font-weight: 700; color: var(--ink); text-decoration: none; }
  .sit-col-head :global(svg) { color: var(--primary); }
  .sit-col-head:hover { color: var(--primary); }
  .sit-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .sit-card { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 20px; background: var(--white); border: 1px solid var(--border); border-radius: 16px; color: inherit; text-decoration: none; transition: border-color .15s, box-shadow .15s, transform .15s; }
  .sit-card b { font-family: var(--font-head); font-size: 1.05rem; line-height: 1.3; }
  .sit-card .muted { font-size: 0.95rem; }
  .sit-to { display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 6px; color: var(--primary); font-weight: 700; font-size: 0.9rem; }
  .sit-card:hover { border-color: var(--primary); box-shadow: var(--shadow); transform: translateY(-2px); }
  .sit-card:hover b { color: var(--primary); }
  .sit-card:focus-visible { outline: 3px solid var(--bright); outline-offset: 2px; }
  .sit-else { margin-top: 32px; padding: 20px 24px; border: 1px dashed var(--border); border-radius: 16px; text-align: center; background: var(--paper); }
  .sit-else p { margin: 0; }
  @media (max-width: 900px) { .sit-board { grid-template-columns: 1fr; gap: 32px; } }
  @media (prefers-reduced-motion: reduce) { .sit-card { transition: none; } .sit-card:hover { transform: none; } }
</style>
