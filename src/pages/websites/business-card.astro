---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import Faq from '../../components/Faq.astro';
import PayBar from '../../components/PayBar.astro';
import PhoneViewer from '../../components/PhoneViewer.astro';
import { serviceSchema } from '../../data/site';
import { cardStyles } from '../../data/cardDemos';

// Written for someone who has never heard of a QR code page or a Google Business Profile.
const steps = [
  { title: 'They scan your card', text: 'Customers point their phone camera at the square code on your printed card, flyer, or window. No app needed.' },
  { title: 'Your card opens', text: 'Your business shows up on their phone: your name, photo, hours, and what you offer.' },
  { title: 'They reach you in one tap', text: 'One tap to call or text you, get directions, or save your number in their phone.' },
];

const included = [
  'Your digital card, made in your colors with your logo or photo',
  'Buttons to call, text, email, and get directions',
  'Your hours (it shows when you are open), your services, and your Facebook or Instagram',
  'A "Save contact" button that adds you to their phone',
  'A printed business card design with the scan code on it, ready to send to a printer',
  'Your own link to share by text or email',
  'One round of changes, ready in about a week',
];

const addons = [
  { title: 'Your Google Business Profile', price: '+$500', text: 'I set up your profile, or improve the one you have, so people find your hours, photos, and reviews, and I link it to your card. $850 for both.' },
  { title: 'Two languages', price: '+$150', text: 'Your card in a second language of your choice, like Spanish, with a button to switch. Covers your team’s cards too.' },
  { title: 'Cards for your team', price: '$95 per person', text: 'A matching card for each person on your team, with their own name, photo, link, and printed card design. Ten or more people? I’ll quote it for your team.' },
  { title: 'Need a logo?', price: '$1,000', text: 'You don’t need a logo for your digital or printed card. Your photo or initials work great. If you’d like one, a designer I work with can create your logo and colors, and I’ll add it to your card when it’s ready.', href: '/websites/brand-essentials/' },
];

const groups = cardStyles.map((g, i) => ({
  label: `Style ${i + 1}`,
  meta: `${g.length} looks`,
  looksLabel: `Looks in style ${i + 1}`,
  items: g.map((d) => ({ slug: d.slug, name: d.name, short: d.look, href: `/samples/cards/${d.slug}/` })),
}));

const faqs = [
  { q: 'What do I need to send you?', a: 'Your logo or a photo of you, your phone number and email, your hours, a short list of what you offer, a photo of your work or your space, and your Google Business Profile link if you have one.' },
  { q: 'Is there a monthly fee?', a: 'No. You pay $350 once. The only ongoing cost is your web address (like yourbusiness.com), about $20 a year, paid to the company you buy it from, in your name.' },
  { q: 'Do you print the business cards?', a: 'I design them and send you the files, and you order from any online printer. That way you choose the paper and how many, and you pay the printer directly.' },
  { q: 'Do I need a website already?', a: 'No. Your digital card can be the first place people find you online. If you already have a website, the card can live on it and link back to it. Either way, your card goes at yourbusiness.com/card, so the code on your printed cards keeps working if you add a full website later.' },
  { q: 'Do I need the Google Business Profile add-on?', a: 'No. But if you don’t have a profile yet, it’s a good idea to create one, since it’s how people find you on Google and Google Maps. I can set it up for you, or improve the one you have.' },
  { q: 'Can I change it later?', a: 'Yes. Fixes are free for 30 days. After that, each change is $59.' },
  { q: 'Is this the same as a full website?', a: 'No. Your card is one screen with the basics. A full website has room for your story, photos, reviews, and a contact form, and starts at $1,500. If you add the Google Business Profile setup and want a full website within 6 months, you save $150 to $550 on it.' },
];

const schema = serviceSchema([
  { name: 'Digital Business Card Website', description: 'A digital business card that opens on any phone: buttons to call, text, and get directions, hours, services, save contact, and a printed card design with a QR code.', price: '$350' },
], '/websites/business-card/');
---
<Base title="Digital Business Card" seoTitle="Digital Business Card Website, $350 | Auva Studio" schema={schema} description="A digital business card for Hudson Valley small businesses. Customers scan it and call, text, or save your number in one tap. $350 one time, no monthly fee.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">A business card <em>that opens on their phone.</em></h1>
      <p class="lede">Your printed card gets a code that customers scan with their phone camera. Your digital card opens right there, with one tap to call you, text you, find you, or save your number.</p>
      <div class="hero-actions">
        <a class="btn" href="#start">Get yours, $350</a>
        <a class="btn btn-ghost" href="#demos">See examples <Icon name="arrow" size={18} /></a>
      </div>
      <p class="hero-note">Pay once. No monthly fee, and no app for your customers to download.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">How it <em>works.</em></h2>
      </div>
      <ol class="steps steps-3">
        {steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band-cream">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">What you get <em>for $350.</em></h2>
        <p class="lede">Made for you, and ready in about a week.</p>
      </div>
      <div class="grid grid-2">
        <div class="card">
          <div class="icon"><Icon name="mail" size={32} /></div>
          <h3>Your digital business card</h3>
          <p class="price">$350</p>
          <ul class="ticks">{included.map((i) => <li><Icon name="tick" size={18} />{i}</li>)}</ul>
          <a class="btn" href="#start">Get yours, $350</a>
        </div>
        <div class="card">
          <div class="icon"><Icon name="layers" size={32} /></div>
          <h3>Add if you want</h3>
          <ul style="list-style:none;margin:8px 0 0;padding:0">
            {addons.map((a) => (
              <li style="display:grid;gap:2px;padding:10px 0;border-bottom:1px solid var(--line, #e3e7ef)">
                <strong>{a.href ? <a href={a.href}>{a.title}</a> : a.title}, {a.price}</strong>
                <span class="muted">{a.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="alt" id="demos">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">See <em>examples.</em></h2>
        <p class="lede">Six styles and 19 looks, shown on sample businesses with made-up details. Pick a style and a look, then scroll and tap inside the phone, just like your customers would. Want to see a real one? <a href="/card/">Here's mine.</a></p>
      </div>
      <PhoneViewer groups={groups} tabsLabel="Card styles" frameLabel="example card on a phone" />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="band">
        <div>
          <h2>No app. No monthly fee.</h2>
          <p>App cards look like the app, carry its logo, and stop working when you stop paying. Yours is made in your colors, lives at your own web address, comes with your printed card design, and stays yours.</p>
        </div>
        <div>
          <p class="price" style="font-size: 4rem">$350</p>
          <p>Once. Yours to keep.</p>
          <a class="btn" href="#start">Get yours</a>
        </div>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} alt />
  <InquiryForm kind="website" topic="card" />
  <PayBar label="Get yours, $350" />
</Base>
