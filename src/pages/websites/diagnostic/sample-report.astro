---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';

// A sample Website Diagnostic report for a made-up business, so visitors can see what they'd get for $199.
const checks = [
  { title: 'Phones', rating: 'Needs work', text: 'The site fits a phone screen, but the menu covers half the page when it opens, and the phone number can’t be tapped to call.' },
  { title: 'Speed', rating: 'Needs work', text: 'Google’s speed score is 41 out of 100 on phones and 78 on computers. The home page photos add up to about 14 MB, which is most of the wait.' },
  { title: 'Google search', rating: 'Fix first', text: 'Every page is titled “Home” or “Page,” so Google has little to show in results. The class pages don’t mention the town, so they rarely come up for “pottery classes near me.”' },
  { title: 'Google profile and reviews', rating: 'Good', text: '4.8 stars from 37 reviews, with recent replies. The hours on the profile don’t match the hours on the website.' },
  { title: 'First impression', rating: 'Needs work', text: 'The home page opens with “Welcome!” and a photo of a shelf. It takes a scroll to learn that the studio teaches classes.' },
  { title: 'Next steps', rating: 'Fix first', text: 'The only way to book a class is a link in the footer. There’s no button near the top of any page.' },
];

const fixes = [
  { title: 'Add a “Book a class” button to the top of every page', why: 'Most visitors come to book. Right now they have to hunt for it.', who: 'You can do this', time: 'About 30 minutes' },
  { title: 'Make the phone number tappable', why: 'Phone visitors can call in one tap instead of copying the number.', who: 'You can do this', time: 'About 10 minutes' },
  { title: 'Say what you do in the first line', why: 'For example: “Pottery classes and handmade pieces in the Hudson Valley.” Visitors and Google both know what you offer right away.', who: 'You can do this', time: 'About 20 minutes' },
  { title: 'Give every page its own title', why: 'For example: “Beginner Wheel Classes | Larkspur Lane Pottery.” This is what shows up in Google results.', who: 'You can do this', time: 'About 1 hour' },
  { title: 'Shrink the home page photos', why: 'Smaller files would cut the load time on phones roughly in half without changing how the photos look.', who: 'You or a developer', time: 'About 1 hour' },
  { title: 'Match your hours everywhere', why: 'When your website and Google profile disagree, customers show up to a locked door, and Google trusts both less.', who: 'You can do this', time: 'About 10 minutes' },
];

const tone: Record<string, string> = { Good: 'good', 'Needs work': 'warn', 'Fix first': 'fix' };
---
<Base title="Sample Website Diagnostic Report" description="A sample Website Diagnostic report for a made-up pottery studio: what I check, what I found, and what to fix first." noindex>
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <a class="bd-pill" href="/websites/diagnostic/">Website Diagnostic</a>
      <h1 class="mag-head">A sample <em>Diagnostic report.</em></h1>
      <p class="lede">This is what you'd get for $199. The business is made up, but the report follows the same format I use for real sites.</p>
      <div class="hero-actions">
        <a class="btn" href="/websites/diagnostic/#start">Request a Diagnostic</a>
        <a class="btn btn-ghost" href="/website-check/">Take the free website check <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap report">
      <div class="report-head">
        <div>
          <p class="muted small">Website Diagnostic for</p>
          <h2>Larkspur Lane Pottery</h2>
          <p class="muted">A made-up pottery studio that teaches classes and sells handmade pieces.</p>
        </div>
        <div class="verdict">
          <p class="small">My recommendation</p>
          <p class="verdict-line">Fix it, don't rebuild it.</p>
          <p class="small">The site works. Six small fixes, most of them things you can do yourself, would make the biggest difference.</p>
        </div>
      </div>

      <h2 class="mag-head">What I found.</h2>
      <div class="grid grid-3 plain-grid">
        {checks.map((c) => (
          <div>
            <p class:list={['rating', tone[c.rating]]}>{c.rating}</p>
            <h3>{c.title}</h3>
            <p class="muted">{c.text}</p>
          </div>
        ))}
      </div>

      <h2 class="mag-head" style="margin-top: 64px">What to fix first, in order.</h2>
      <ol class="fix-list">
        {fixes.map((f, i) => (
          <li class="card">
            <span class="fix-num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{f.title}</h3>
              <p class="muted">{f.why}</p>
              <p class="small fix-meta"><b>{f.who}</b>, {f.time.toLowerCase()}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="card" style="margin-top: 40px">
        <h3>When a rebuild would make sense</h3>
        <p class="muted">If you later want online class booking, a shop, and a gift card page all on one site, your current builder will start to get in the way. That's the point where a new site pays for itself. Until then, these fixes are the better spend.</p>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="band">
        <div>
          <h2>Get a report like this for your site.</h2>
          <p>Within 5 business days, in plain English, with what to fix first. It's yours to use with any developer.</p>
        </div>
        <div>
          <p class="price" style="font-size: 4rem">$199</p>
          <p>Credited toward your new website with me.</p>
          <a class="btn" href="/websites/diagnostic/#start">Request a Diagnostic</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .report-head { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: start; margin-bottom: 56px; }
  .report-head h2 { margin: 0 0 6px; }
  .report-head p { margin: 0; }
  .verdict { background: var(--night); color: var(--white); border-radius: var(--radius); padding: 24px 28px; }
  .verdict p { color: #c4d2f0; }
  .verdict .verdict-line { font-family: var(--font-head); font-size: 1.5rem; font-weight: 800; color: var(--white); margin: 4px 0 8px; }
  .rating { display: inline-block; font-size: 0.85rem; font-weight: 700; border-radius: 999px; padding: 3px 12px; margin: 0 0 10px; }
  .rating.good { background: #e3f5ec; color: #12704a; }
  .rating.warn { background: #fdf0dc; color: #8a5300; }
  .rating.fix { background: #fde6e4; color: #a3271c; }
  .fix-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .fix-list li { display: flex; gap: 18px; align-items: flex-start; padding: 22px 24px; }
  .fix-list h3 { font-size: 1.1rem; margin: 2px 0 6px; }
  .fix-list p { margin: 0; }
  .fix-num { flex: none; width: 36px; height: 36px; border-radius: 50%; border: 2px solid var(--primary); color: var(--primary); font-weight: 800; display: grid; place-items: center; }
  .fix-meta { margin-top: 8px !important; color: var(--primary); }
  @media (max-width: 760px) { .report-head { grid-template-columns: 1fr; } }
</style>
