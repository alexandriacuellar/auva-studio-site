---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import Faq from '../../components/Faq.astro';
import { care, plans, monthly, serviceSchema, site } from '../../data/site';

const atLaunch = [
  { icon: 'chat', title: 'A walkthrough', text: 'I show you around your new site and answer your questions.' },
  { icon: 'book', title: 'A how-to guide', text: 'Plain steps for the things you might want to do on your own.' },
  { icon: 'wrench', title: '30 days of fixes and small tweaks', text: 'Anything that needs adjusting in the first month, at no extra cost.' },
  { icon: 'key', title: 'Everything in your name', text: 'Your domain, hosting, and accounts, so you never depend on me to get in.' },
];

// Four ways to get help after launch, shown like the website package cards.
const paths = [
  { tag: 'Now and then', name: 'Pay as you go', price: '$59', unit: 'per update', blurb: 'Send me what to change and I take care of it.', items: ['Up to about 30 minutes of edits per update, sent together in one request', 'Done within 2 business days', 'Buy 5 updates ahead for $249 and save $46', 'New pages and features at $125/hr, quoted first. Need 4 or more pages? Upgrading your package often costs less.', 'No commitment. Pay only when you need something.'], cta: 'Send an update', href: '#start' },
  { tag: 'A little each month', name: plans[0].name, price: '$99', unit: 'a month', blurb: 'For sites with a few small changes most months.', items: ['1 hour of updates a month, about 2 updates', 'A monthly check that your forms, links, and buttons work', 'Done within 2 business days', 'Unused time carries over one month', "3-month minimum, then 30 days' notice to stop"], cta: 'Start monthly updates', href: '#start' },
  { tag: 'More each month', name: plans[1].name, price: '$179', unit: 'a month', blurb: 'For busy sites with lots of changes each month.', items: ['2 hours a month for updates, CMS changes, or a simple new page in one of your existing page designs', 'The same monthly check', 'A search review every 3 months, with what to fix', 'Done within 1 business day', "3-month minimum, then 30 days' notice to stop"], cta: 'Start monthly updates plus', href: '#start' },
  { tag: 'Every month', name: 'Monthly web producer', price: 'From $650', unit: 'a month for 5 hours', blurb: monthly.text, items: [...monthly.outcomes, 'Same-day help with urgent problems', "3-month minimum, then 30 days' notice to stop"], cta: "Let's talk about what you need", href: site.booking, featured: true },
];

const faqs = [
  { q: "What counts as one update?", a: "Up to about 30 minutes of edits, sent together in one request, like new hours, a few new photos, and a typo fix. If a request will take longer, I tell you first." },
  { q: "Do I need a monthly plan?", a: "No. Most sites I build have no plugins to keep patched, so you can pay only when you want a change. If you change things most months, a plan is simpler, and you can start, switch, or stop one any time after the first 3 months." },
  { q: "Can you help with a site you didn't build?", a: "Pay-as-you-go updates are for sites I build. For a site built by someone else, we start with a Website Diagnostic, and then a monthly plan or a small one-time change may fit." },
  { q: "What does my site cost to run?", a: "Your domain is about $20 a year, and hosting is free or low cost for most sites I build, in your name. If your site needs a platform with a monthly fee, I'll tell you before we start." },
];

const schema = serviceSchema([
  ...care.map((c) => ({ name: `Help After Launch: ${c.name}`, description: c.text, price: c.price })),
  ...plans.map((p) => ({ name: `Help After Launch: ${p.name}`, description: p.text, price: p.price })),
  { name: `Help After Launch: ${monthly.name}`, description: monthly.text, price: monthly.price },
  { name: 'CMS (content management system)', description: 'A simple dashboard to update page text, photos, and collections like news or events yourself, with no code.', price: 'From $1,750' },
], '/websites/help-after-launch/');
---
<Base title="Help After Launch" seoTitle="Website Updates and Help After Launch, $59 per Update | Auva Studio" schema={schema} description="Website updates when you need them: $59 per update, monthly update plans from $99, a monthly web producer from $650, or a CMS so you can make changes yourself.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Help when you need it, <em>or every month.</em></h1>
      <p class="lede">Keep your site current without paying for upkeep you don't need. Send me a change when something's new, update it yourself, or keep me on as your web producer to improve your site every month.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call</a>
        <a class="btn btn-ghost" href="/websites/#packages">See website packages <Icon name="arrow" size={18} /></a>
      </div>
      <p class="hero-note">Updates are $59 each, or pick a monthly plan from $99. Start any time, at launch or later.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Included with every website.</h2>
      </div>
      <div class="grid grid-4 plain-grid">
        {atLaunch.map((a) => (
          <div>
            <div class="icon"><Icon name={a.icon} size={28} /></div>
            <h3>{a.title}</h3>
            <p class="muted">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt" id="care">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">After launch, <em>four ways to get help.</em></h2>
        <p class="lede">No monthly fee unless you want one. Pick what fits how often your site changes, and start or switch plans any time.</p>
      </div>
      <div class="grid grid-4 packages">
        {paths.map((p) => (
          <article id={p.featured ? 'monthly' : undefined} class:list={['card', 'package', { featured: p.featured }]}>
            <span class="tag">{p.tag}</span>
            <h3>{p.name}</h3>
            <p class="muted">{p.blurb}</p>
            <p class="price">{p.price} <span class="price-unit">{p.unit}</span></p>
            <ul class="ticks">{p.items.map((i) => <li><Icon name="tick" size={18} />{i}</li>)}</ul>
            <a class:list={['btn', { 'btn-ghost': !p.featured }]} href={p.href} {...(p.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{p.cta}</a>
          </article>
        ))}
      </div>
      <p class="fine">Monthly hours are one flexible allowance across anything on the list, and unused hours carry over one month. Third-party fees, like platforms or apps, are separate. I keep your site's foundations solid, so it stays fast, secure, and easy for Google to read. Rankings and sales also depend on your content and marketing, so I don't promise them, but I'll show you what's working.</p>
    </div>
  </section>

  <section id="cms">
    <div class="wrap">
      <div class="card" style="display:grid;gap:12px">
        <h2 class="mag-head">Rather <em>update it yourself?</em></h2>
        <p class="muted">A CMS (content management system) is a simple dashboard where you update your text, photos, news, and events yourself. No code needed. <b style="color: var(--primary)">From $1,750</b>, one time, with training, an editor guide, and 30 days of support. Up to 2 collections, like news posts or events. Included in Complete Presence.</p>
        <p><a class="btn btn-ghost" href="#start">Ask about a CMS</a></p>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} />
  <InquiryForm kind="website" topic="care" alt />
</Base>
