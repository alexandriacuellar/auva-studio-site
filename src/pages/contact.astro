---
import Base from '../layouts/Base.astro';
import '../styles/pages/contact.css';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../data/site';

const faqs = [
  { q: 'What happens on the free 30-minute call?', a: "We talk about what you're working on, what's getting in the way, and what a good outcome looks like. You leave with a suggested next step, with no obligation." },
  { q: "What does it cost to get started?", a: "The first call is free. Fixed prices start at $199 for a Website Diagnostic and $250 for a Tech Review, and nothing begins until you approve a written scope and price." },
];
---
<Base title="Contact" seoTitle="Contact Alexandria Cuellar | Auva Studio" description="Book a free 30-minute call or send a message about a website, AI and automation, or a game, XR, AR, or VR project. I reply within 24 to 48 hours.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Let's talk about <em>what you're working on.</em></h1>
      <p class="lede">Book a free 30-minute call, or send a message and I'll reply within 24–48 hours. No detailed plan needed.</p>
    </div>
  </section>

  <InquiryForm kind="general" alt />

  <section id="explore">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Want <em>more detail first?</em></h2>
      </div>
      <div class="grid grid-3 routes">
        <a class="card card-row" href="/websites/">
          <div class="icon"><Icon name="globe" /></div>
          <div>
            <h3>I need a website</h3>
            <p class="muted small">A new site, improvements to your current one, a Diagnostic, Google Business Profile setup, or help after launch.</p>
            <span class="more">Explore website services <Icon name="arrow" size={16} /></span>
          </div>
        </a>
        <a class="card card-row" href="/automation-ai-projects/">
          <div class="icon"><Icon name="compass" /></div>
          <div>
            <h3>I need help with tools, automation, AI, or a project</h3>
            <p class="muted small">Automation, 1-on-1 AI sessions, project workspace setup, project management, or a Tech Review.</p>
            <span class="more">Explore Automation, AI & Projects <Icon name="arrow" size={16} /></span>
          </div>
        </a>
        <a class="card card-row" href="/ar-vr-production/">
          <div class="icon"><Icon name="bolt" /></div>
          <div>
            <h3>I have a game, XR, or AR project</h3>
            <p class="muted small">Production support, a Production Plan Review, or a small AR project.</p>
            <span class="more">Explore AR, VR & Production <Icon name="arrow" size={16} /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <Faq alt faqs={faqs} lede="You don't need a detailed plan before reaching out. Start with what you're trying to improve, resolve, or build." />

</Base>
