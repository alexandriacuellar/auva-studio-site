---
import Base from '../../layouts/Base.astro';
import AutomationCheck from '../../components/AutomationCheck.astro';
---
<Base title="What Can You Automate?" seoTitle="Free Automation Check: What Can You Automate? | Auva Studio" description="Tick the tasks your team does by hand and see which ones can run on their own, and how.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">What can <em>you automate?</em></h1>
      <p class="lede">Tick the tasks your team does by hand. You'll see which ones can run on their own, how each would work, and which apps it would use.</p>
      <p class="hero-note">Free. Takes about a minute. No email needed. Your answers stay on your screen unless you choose to send them.</p>
    </div>
  </section>
  <AutomationCheck lang="en" />
</Base>
