---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/alexandria-cuellar.jpg';
import Icon from '../components/Icon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Faq from '../components/Faq.astro';

const faqs = [
  { q: "What's in the Tech Review?", a: 'A 60-minute call about your tools and how work gets done, then a written report within 5 business days with your top fixes in order, rough costs, and where automation or AI would help. It costs $250, credited toward any setup with me that starts within 90 days.' },
  { q: 'Which project tools do you set up?', a: "Asana, ClickUp, Jira, monday.com, Notion, and Trello, and others as your team needs them. If you don't have one yet, I'll help you choose." },
  { q: 'Do you offer one-time and ongoing support?', a: 'Yes. Work ranges from a single setup or session to ongoing project management, billed by the hour or in monthly blocks.' },
  { q: 'Do you work in person?', a: "Most work happens remotely. When an on-site visit would help, we'll plan it together. On-site time is billed at the $65 hourly consulting rate. I work in person from New York City and Westchester up to Albany. Outside the Mid-Hudson Valley, travel time is billed at half my hourly rate and expenses such as mileage and lodging at cost, all agreed in writing before booking." },
  { q: 'How does monthly project management work?', a: 'A project manager who works with your team part time, from $650 a month for 10 hours, with a 3-month minimum. 20 hours is $1,200 and 40 hours is $2,200 a month.' },
  { q: 'Can you work with our current vendors or IT provider?', a: 'Yes. I often work alongside existing teams and vendors, and can help you evaluate their proposals.' },
  { q: 'Do we need technical skills to use AI?', a: 'No. Workshops are built for non-technical teams, using tools like ChatGPT, Claude, and Gemini in your real work.' },
  { q: 'Is it safe to use AI with our business data?', a: 'It can be, with the right tools and settings. Every workshop covers privacy and quality risks, and a Tech Review recommends tools that fit your rules.' },
];
import { consulting, aiOffers, site, testimonials, serviceSchema } from '../data/site';

const aiConsulting = aiOffers.filter((o) => o.group === 'consulting');
const schema = serviceSchema([...consulting, ...aiConsulting].map((c) => ({ name: c.title, description: c.text, price: c.price })), '/technology-consulting/');

// Everyday tasks small teams hand to AI. Examples only, with no promised results.
const aiTasks = [
  { icon: 'mail', title: 'Answer customer emails faster', text: 'Draft replies to common questions, then check and send.' },
  { icon: 'book', title: 'Write job posts and descriptions', text: 'Turn a few notes into a clear first draft.' },
  { icon: 'clock', title: 'Turn meetings into to-dos', text: 'Summaries and next steps, without retyping your notes.' },
  { icon: 'chat', title: 'Draft social posts and newsletters', text: 'A week of ideas and drafts in your own voice.' },
  { icon: 'search', title: 'Find answers in your own documents', text: 'Ask your handbook, policies, or price list a question.' },
  { icon: 'layers', title: 'First drafts of quotes and proposals', text: 'Start from a draft instead of a blank page.' },
];

// Every consulting price in one place.
---
<Base title="Tech, Automation & AI" seoTitle="Tech, Automation & AI Help for Small Businesses | Auva Studio" schema={schema} description="A $250 Tech Review, automation setup, project workspace setup, AI workshops, and project management for small businesses, nonprofits, startups, and growing teams in the Hudson Valley and beyond.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Less busywork, better tools, <em>projects that finish.</em></h1>
      <p class="lede">Too many apps, a process held together with workarounds, or a project that keeps slipping? I help small businesses, nonprofits, and growing teams choose the right tools, automate the busywork, put AI to work, and keep projects on track.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="#planning">Start with a $250 Tech Review</a>
      </div>
      <ul class="hero-strip">{['Fixed price to start', 'Plain-English plan', 'Works with your current vendors', 'Developer and project manager'].map((t) => <li><Icon name="tick" size={16} />{t}</li>)}</ul>
    </div>
  </section>

  <section class="hello-band" aria-label="Alexandria Cuellar">
    <div class="wrap hello"><Image src={headshot} alt="" width={120} height={120} densities={[1, 2]} /><span><b>Hi, I'm Alexandria.</b> I'm a software developer and technical project manager with 20+ years in software. I know how the technology works and how to keep a team on schedule, and you'll work with me directly. <a href="/about/">More about me</a><ul class="hello-facts"><li><b>20+</b> years in software</li><li><b>14+</b> projects managed</li><li><b>Jira, Trello, Notion, ClickUp</b></li></ul></span></div>
  </section>

  <section class="alt" id="problems">
    <div class="wrap about-grid">
      <div>
        <h2 class="mag-head">Sound <em>familiar?</em></h2>
        <p class="lede">Pick the one closest to yours. Each one shows the service that fixes it.</p>
      </div>
      <ul class="route-list">
        <li><a href="#planning"><span class="icon"><Icon name="compass" /></span><span><b>You pay for apps nobody uses</b><span class="muted">Or you have so many tools that none of them talk to each other.</span></span></a></li>
        <li><a href="#planning"><span class="icon"><Icon name="search" /></span><span><b>You need new software and don't know which</b><span class="muted">Booking, point of sale, accounting, email, or a customer list, with too many options to compare.</span></span></a></li>
        <li><a href="#automation"><span class="icon"><Icon name="chart" /></span><span><b>Your team types the same thing twice</b><span class="muted">Information lives in three places, so mistakes and extra work pile up.</span></span></a></li>
        <li><a href="#automation"><span class="icon"><Icon name="gear" /></span><span><b>Follow-ups and reports eat your week</b><span class="muted">Reminder emails, new-client paperwork, and the same monthly report, all by hand.</span></span></a></li>
        <li><a href="#automation"><span class="icon"><Icon name="clock" /></span><span><b>A simple task takes hours</b><span class="muted">Spreadsheets, workarounds, and "that's how we've always done it."</span></span></a></li>
        <li><a href="#ai"><span class="icon"><Icon name="bolt" /></span><span><b>You know AI could help, but not where</b><span class="muted">Your team tried a chatbot once, or nobody has had time to figure it out.</span></span></a></li>
        <li><a href="#delivery"><span class="icon"><Icon name="check" /></span><span><b>A tech project keeps slipping</b><span class="muted">A new system, a move, or an upgrade with no one clearly in charge.</span></span></a></li>
        <li><a href="#delivery"><span class="icon"><Icon name="shield" /></span><span><b>You need someone on your side with a vendor</b><span class="muted">Someone who understands the tech and asks the right questions.</span></span></a></li>
      </ul>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Five ways <em>I help.</em></h2>
        <p class="lede">Every one starts with a free call, and you get a written price before any work begins. Just need advice? Consulting sessions are $65/hr.</p>
      </div>
      <div class="grid grid-2">
        <div class="card card-row" id="planning">
          <div class="icon"><Icon name="search" size={36} /></div>
          <div>
            <h3>Start with a Tech Review</h3>
            <p class="svc-meta"><span>Tech Review</span> <b>$250</b></p>
            <p class="muted">One call about how your business runs, then a written report with your top fixes: which tools to keep, cut, or connect, and where automation or AI would actually help.</p>
            <ul class="ticks small"><li><Icon name="tick" size={16} />A 60-minute call and a look at your tools</li><li><Icon name="tick" size={16} />A written report within 5 business days</li><li><Icon name="tick" size={16} />Your top fixes in order, with rough costs</li><li><Icon name="tick" size={16} />$250 credited toward any setup within 90 days</li></ul>
            <a class="more" href="/technology-consulting/?topic=planning#start" style="margin-top: 12px">Ask about this</a>
          </div>
        </div>
        <div class="card card-row" id="automation">
          <div class="icon"><Icon name="gear" size={36} /></div>
          <div>
            <h3>Automate the busywork</h3>
            <p class="svc-meta"><span>Automation setup</span> <b>From $500</b></p>
            <p class="muted">I connect the tools you already use so routine work happens on its own, like follow-up emails, new-client onboarding, monthly reports, or copying details from one app to another. Not every automation needs AI.</p>
            <ul class="ticks small"><li><Icon name="tick" size={16} />One workflow, set up in your own accounts</li><li><Icon name="tick" size={16} />A short how-to guide for your team</li><li><Icon name="tick" size={16} />Any tool fees are billed to you directly, in your name</li><li><Icon name="tick" size={16} />Some tasks are better done by a person, and I'll tell you which</li></ul>
            <a class="more" href="/technology-consulting/?topic=automation#start" style="margin-top: 12px">Ask about this</a>
          </div>
        </div>
        <div class="card card-row" id="workspace">
          <div class="icon"><Icon name="layers" size={36} /></div>
          <div>
            <h3>Get your projects organized</h3>
            <p class="svc-meta"><span>Project workspace setup</span> <b>From $1,500</b></p>
            <p class="muted">I set up the tool your team plans work in, like Asana, ClickUp, Jira, monday.com, Notion, or Trello, with boards, templates, and a clear view of who's doing what. Then I train your team to use it.</p>
            <ul class="ticks small"><li><Icon name="tick" size={16} />Set up in your own account</li><li><Icon name="tick" size={16} />Templates for the work you repeat</li><li><Icon name="tick" size={16} />A training session for your team</li><li><Icon name="tick" size={16} />30 days of questions after setup</li></ul>
            <a class="more" href="/technology-consulting/?topic=workspace#start" style="margin-top: 12px">Ask about this</a>
          </div>
        </div>
        <div class="card card-row" id="ai-card">
          <div class="icon"><Icon name="bolt" size={36} /></div>
          <div>
            <h3>Put AI to work</h3>
            <p class="svc-meta"><span>Team AI Workshop</span> <b>$750</b></p>
            <p class="muted">A 90-minute hands-on session for up to 10 people. Your team practices ChatGPT, Claude, or Gemini on real work and leaves with a one-page guide.</p>
            <ul class="ticks small"><li><Icon name="tick" size={16} />Practice on your real tasks, not demos</li><li><Icon name="tick" size={16} />Privacy and quality covered</li><li><Icon name="tick" size={16} />Made for non-technical teams</li></ul>
            <a class="more" href="#ai" style="margin-top: 12px">See AI for your team <Icon name="arrow" size={16} /></a>
          </div>
        </div>
        <div class="card card-row card-wide" id="delivery">
          <div class="icon"><Icon name="check" size={36} /></div>
          <div>
            <h3>Someone to run the project</h3>
            <p class="svc-meta"><span>Project Management</span> <b>$65/hr, or monthly from $650</b></p>
            <p class="muted">A part-time project manager who plans the work, keeps your team and vendors on schedule, and flags problems early, without a full-time hire.</p>
            <ul class="ticks small"><li><Icon name="tick" size={16} />A plan and schedule everyone can follow</li><li><Icon name="tick" size={16} />Your team and vendors kept in step</li><li><Icon name="tick" size={16} />Early warning on delays and risks</li><li><Icon name="tick" size={16} />Monthly: 10 hrs $650, 20 hrs $1,200, or 40 hrs $2,200, with a 3-month minimum</li></ul>
            <a class="more" href="/technology-consulting/?topic=delivery#start" style="margin-top: 12px">Ask about this</a>
            <p class="small muted" style="margin-top: 12px">Making a game or XR project? See <a href="/production-emerging-tech/#production">Production Support</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="alt" id="ai">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Put AI to work <em>in the work you already do.</em></h2>
        <p class="lede">I use AI tools in my own work every day. I'll show your team where they help with the tasks you already do, which tools to trust, and how to use them safely.</p>
      </div>
      <h3 class="glance-title" style="margin-top: 0">What small teams use AI for</h3>
      <div class="grid grid-3 ai-tasks">
        {aiTasks.map((t) => (
          <div class="card card-row">
            <div class="icon"><Icon name={t.icon} size={28} /></div>
            <div><h3>{t.title}</h3><p class="muted small">{t.text}</p></div>
          </div>
        ))}
      </div>
      <p id="workshop" style="margin-top: 28px"><a class="btn" href="/technology-consulting/?topic=workshop#start">Ask about the Team AI Workshop, $750</a></p>
      <p class="small muted" style="margin-top: 20px"><b>Tools I use.</b> ChatGPT, Claude, Gemini, Meta AI, and Zapier. Want a chatbot on your website that answers customer questions? See <a href="/websites/#addons">AI chatbots and web apps</a>.</p>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">How it <em>works.</em></h2>
        <p class="lede">Simple to start, with no surprises along the way.</p>
      </div>
      <ol class="steps steps-4">
        <li><span class="num" aria-hidden="true">1</span><h3>Free call</h3><p>Tell me what's going on. I'll tell you honestly whether I can help and where to start.</p></li>
        <li><span class="num" aria-hidden="true">2</span><h3>Written scope and price</h3><p>A short proposal with what I'll do, how long it takes, and the price, before any work begins.</p></li>
        <li><span class="num" aria-hidden="true">3</span><h3>The work</h3><p>Sessions, research, and hands-on help. You work with me directly and get updates as we go.</p></li>
        <li><span class="num" aria-hidden="true">4</span><h3>Handover</h3><p>Clear documents and training, so your team can keep going without me.</p></li>
      </ol>
    </div>
  </section>

  <section class="alt" id="who">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Who I <em>work with.</em></h2>
      </div>
      <div class="grid grid-3 who">
        <div class="card">
          <div class="icon"><Icon name="globe" size={32} /></div>
          <h3>Small businesses</h3>
          <p class="small muted">Shops, restaurants, inns, practices, and local services.</p>
          <p class="who-text">Too many tools and not enough time. Pick the right ones, set them up, and get your team using them.</p>
          <a class="more" href="?topic=unsure#start" style="margin-top: 12px">Talk it through</a>
        </div>
        <div class="card">
          <div class="icon"><Icon name="book" size={32} /></div>
          <h3>Nonprofits & Culture</h3>
          <p class="small muted">Museums, arts councils, land trusts, and community groups.</p>
          <p class="who-text">Make a tight budget go further. Choose tools, plan upgrades, and keep grant-funded projects on track.</p>
          <a class="more" href="?topic=unsure#start" style="margin-top: 12px">Talk it through</a>
        </div>
        <div class="card">
          <div class="icon"><Icon name="key" size={32} /></div>
          <h3>Startups</h3>
          <p class="small muted">Early teams building a first product or setting up their systems.</p>
          <p class="who-text">Turn an idea into a plan, with clear requirements, the right vendors, and a project manager without a full-time hire.</p>
          <a class="more" href="?topic=unsure#start" style="margin-top: 12px">Talk it through</a>
        </div>
        <div class="card">
          <div class="icon"><Icon name="chart" size={32} /></div>
          <h3>Growing teams</h3>
          <p class="small muted">Companies adding people, locations, or services.</p>
          <p class="who-text">Fix the workflows that break as you grow, and keep big projects moving.</p>
          <a class="more" href="?topic=unsure#start" style="margin-top: 12px">Talk it through</a>
        </div>
        <div class="card">
          <div class="icon"><Icon name="layers" size={32} /></div>
          <h3>Agencies and designers</h3>
          <p class="who-text">Need a reliable developer behind your team? I partner with marketing agencies, creative studios, and independent designers.</p>
          <a class="more" href="/development-partnerships/" style="margin-top: 12px">See Development Partnerships <Icon name="arrow" size={16} /></a>
        </div>
        <div class="card who-other">
          <div class="icon"><Icon name="chat" size={32} /></div>
          <h3>Something else?</h3>
          <p>Tell me what you're working on, and I'll suggest where to start.</p>
          <a class="more" href="?topic=unsure#start" style="margin-top: 12px">Talk it through</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Organized, dependable, and <em>easy to work with.</em></h2>
        <p class="lede">From teams I've managed projects for.</p>
      </div>
      <div class="grid grid-3">
        {testimonials.map((t) => (
          <figure class="card quote">
            <blockquote>“{t.quote}”</blockquote>
            <figcaption><b>{t.name}</b><span class="muted">{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Faq faqs={faqs} alt />
  <InquiryForm kind="consulting" />
</Base>
