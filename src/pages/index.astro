---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/pages/home.css';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { categories, journey, site, testimonials } from '../data/site';
const featured = testimonials.find((t) => t.name === 'Matthew Udy');
import hero from '../assets/cover-hero-workspace.png';
import headshot from '../assets/alexandria-cuellar.jpg';
import siteMockup from '../assets/website-mockup-happy-tails.png';

const situations = [
  { title: 'You need a website', text: "You don't have one yet, or you're starting something new.", href: '/websites/', icon: 'globe' },
  { title: 'Your website needs attention', text: "It's outdated, slow, hard to update, or not bringing in inquiries.", href: '/websites/#diagnostic', icon: 'search' },
  { title: "You're facing a technology decision", text: 'Too many tools, platforms, or vendors, and no clear way to choose.', href: '/technology-consulting/#planning', icon: 'compass' },
  { title: 'A project needs structure', text: 'Priorities, timelines, or vendors need someone to pull them together.', href: '/technology-consulting/#delivery', icon: 'check' },
  { title: 'A process is slowing your team down', text: 'Too many steps, handoffs, or workarounds to get one thing done.', href: '/technology-consulting/#analysis', icon: 'chart' },
  { title: 'You see an AI opportunity', text: 'You want AI that saves real time, not AI for its own sake.', href: '/ai-emerging-tech/#ai-team', icon: 'bolt' },
  { title: 'You have an emerging-tech idea', text: 'An early concept, prototype, or immersive experience you want to test.', href: '/ai-emerging-tech/#xr', icon: 'layers' },
];
const strip = ['Published prices', 'Written quote before work starts', 'You own everything', 'Work with me directly'];
---
<Base>
  <section class="hero bd-hero">
    <div class="wrap bd-hero-inner">
      <p class="bd-pill">Websites, Consulting, and AI & Emerging Tech</p>
      <h1 class="mag-head">Make technology <em>work for your business.</em></h1>
      <p class="lede">A digital technology and solutions studio for small businesses, startups, nonprofits, and growing teams.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="#services">How I help</a>
      </div>
      <ul class="hero-strip">{strip.map((t) => <li><Icon name="tick" size={16} />{t}</li>)}</ul>
      <figure class="bd-stage">
        <Image src={hero} alt="Sunlit workspace with a laptop, coffee mug, and plants" widths={[800, 1200, 1600]} sizes="(max-width: 1180px) 100vw, 1080px" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="alt">
    <div class="wrap about-grid">
      <div>
        <h2 class="mag-head">What are you <em>working on?</em></h2>
        <p class="lede">You don't need to know which service you need. Start with the situation that sounds most like yours.</p>
        <p class="muted">Not sure which fits? Real problems often span more than one. <a href="/contact/">Tell me what's happening</a> and I'll suggest a next step.</p>
      </div>
      <ul class="route-list">
        {situations.map((x) => (
          <li><a href={x.href}>
            <span class="icon"><Icon name={x.icon} /></span>
            <span><b>{x.title}</b><span class="muted">{x.text}</span></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Three ways <em>I help.</em></h2>
        <p class="lede">Start with a conversation or a focused review. I recommend only what you need, then help you put it in place.</p>
      </div>
      <div class="grid grid-3">
        {categories.map((c) => (
          <a class="card category bd-card" href={c.href}>
            <div class="bd-media">
              {c.href === '/technology-consulting/' && (<div class="bd-art bd-art-plan" aria-hidden="true">
            <div class="float f1"><span class="k">Technology plan</span><b>3 options compared</b><span class="bar"><i style="width:82%"></i></span><span class="bar"><i style="width:56%"></i></span></div>
            <div class="float f2"><span class="k">This week</span><ul><li><Icon name="tick" size={14} />Requirements signed off</li><li><Icon name="tick" size={14} />Vendor call booked</li></ul></div>
          </div>)}
              {c.href === '/ai-emerging-tech/' && (<div class="bd-art bd-art-ai" aria-hidden="true">
            <div class="float f1 chat"><span class="k">Team AI Workshop</span><p class="q">Can AI draft our weekly client update?</p><p class="a">Yes, with a check step before it goes out.</p></div>
            <div class="float f2"><span class="k">Prototype Sprint</span><span class="bar"><i style="width:66%"></i></span></div>
          </div>)}
              {c.href === '/websites/' && <Image src={siteMockup} alt="A sample nonprofit website shown on a laptop and a phone on a sunny desk" widths={[480, 800]} sizes="(max-width: 960px) 100vw, 380px" loading="eager" />}
            </div>
            <div class="bd-body">
              <span class="bd-tag">{c.href === '/websites/' ? 'From $1,500' : c.href === '/ai-emerging-tech/' ? 'From $500' : 'From $65/hr'}</span>
              <h3 style={`view-transition-name: svc-${c.href.replaceAll('/', '')}`}>{c.title}</h3>
              <p class="muted">{c.text}</p>
              <ul class="ticks">{c.items.map((it) => <li><Icon name="tick" size={18} />{it}</li>)}</ul>
              <span class="more">{c.cta} <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
      <p class="hero-checks" style="text-align: center; margin-top: 28px">Not ready to talk? Try a free 2-minute check: <a href="/website-check/">your website</a> or <a href="/google-profile-check/">your Google profile</a>.</p>
    </div>
  </section>

  <section class="alt" id="about">
    <div class="wrap home-about">
      <Image class="home-about-photo" src={headshot} alt="Alexandria Cuellar" width={260} height={260} densities={[1, 2]} />
      <div class="home-about-text">
        <h2 class="mag-head">Practical technology guidance, <em>built around people.</em></h2>
        <p class="lede">I founded Auva Studio to help small businesses, startups, nonprofits, and growing teams make confident technology decisions, starting with your goals. I help with <a href="/websites/">websites</a>, <a href="/technology-consulting/">technology consulting</a>, and <a href="/ai-emerging-tech/">AI &amp; Emerging Tech</a>.</p>
        <p class="home-about-name"><b>Alexandria Cuellar</b>, digital technology and solutions consultant<br /><span class="muted">When I'm not working, you'll find me on long walks with my dog, Midna, around the Mid-Hudson Valley.</span></p>
        <figure class="quote home-about-quote">
        <blockquote>“{featured.quote}”</blockquote>
        <figcaption><b>{featured.name}</b><span class="muted">{featured.role}</span></figcaption>
      </figure>
        <div class="home-about-actions">
          <a class="btn btn-ghost" href="/about/">More about me <Icon name="arrow" size={18} /></a>
          <a class="founder-link" href="https://www.linkedin.com/company/auva-studio/" target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> Follow Auva Studio on LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Simple to start, <em>clear at every step.</em></h2>
        <p class="lede">Whatever you need, it starts the same way.</p>
      </div>
      <ol class="steps steps-3">
        {journey.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="work-foot">
        <p><a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a></p>
        <div class="name-note">
          <h3><span class="name-star" aria-hidden="true"></span>What's in a name?</h3>
          <p class="muted">The amber star at the end of every set of steps is Auva, or Delta Virginis (officially Minelauva), a cool red giant star in the constellation Virgo.</p>
          <p class="name-line">A little inspiration from the stars, a little curiosity about what's possible.</p>
        </div>
      </div>
    </div>
  </section>
  <Cta />
</Base>
