---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/pages/home.css';
import Icon from '../components/Icon.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Cta from '../components/Cta.astro';
import { categories, site, testimonials } from '../data/site';
const featured = testimonials.find((t) => t.name === 'Matthew Udy');
import hero from '../assets/cover-hero-workspace.png';
import headshot from '../assets/alexandria-cuellar.jpg';

const situations = [
  { title: 'You need a website', text: "You don't have one yet, or you're starting something new.", href: '/websites/', icon: 'globe' },
  { title: 'Your website needs attention', text: "It's outdated, slow, hard to update, or not bringing in inquiries.", href: '/websites/diagnostic/', icon: 'search' },
  { title: "Customers can't find you on Google Maps", text: 'Your Google profile is missing, thin, or has the wrong details.', href: '/websites/google-business-profile/', icon: 'star' },
  { title: "Your tools aren't working for you", text: "Too many apps, too many workarounds, or you're not sure where AI fits.", href: '/technology-consulting/#planning', icon: 'compass' },
  { title: 'Your team does the same tasks by hand', text: 'Follow-ups, data entry, and reports that could run on their own.', href: '/technology-consulting/#automation', icon: 'gear' },
  { title: 'A project needs a leader', text: 'A technology project needs someone to keep scope, schedule, vendors, and people on track.', href: '/technology-consulting/#delivery', icon: 'check' },
  { title: "You're making a game, XR, or AR project", text: 'Get a producer to keep it on track, or start small with an AR project that opens on a phone.', href: '/production-emerging-tech/', icon: 'bolt' },
];
const strip = ['Published prices', 'Written quote before work starts', 'You own everything', 'Work with me directly'];
---
<Base>
  <section class="hero bd-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Make technology <em>work for your business.</em></h1>
      <p class="lede">Auva Studio is a digital technology and solutions studio in the Hudson Valley. I build websites, set up tools and automation, and produce games and XR.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="#services">How I help</a>
      </div>
      <ul class="hero-strip">{strip.map((t) => <li><Icon name="tick" size={16} />{t}</li>)}</ul>
      <figure class="bd-stage">
        <Image src={hero} alt="Sunlit workspace with a laptop, coffee mug, and plants" widths={[800, 1200, 1600]} sizes="(max-width: 1180px) 100vw, 1080px" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="alt">
    <div class="wrap about-grid">
      <div>
        <h2 class="mag-head">What are you <em>working on?</em></h2>
        <p class="lede">You don't need to know which service you need. Start with the situation that sounds most like yours.</p>
        <p class="muted">Not sure which fits? Real problems often span more than one. <a href="/contact/">Tell me what's happening</a> and I'll suggest a next step.</p>
      </div>
      <ul class="route-list">
        {situations.map((x) => (
          <li><a href={x.href}>
            <span class="icon"><Icon name={x.icon} /></span>
            <span><b>{x.title}</b><span class="muted">{x.text}</span></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Three ways <em>I help.</em></h2>
        <p class="lede">Start with a conversation or a focused review. I recommend only what you need, then help you put it in place.</p>
      </div>
      <ServiceCards categories={categories} lang="en" />
      <p class="hero-checks" style="text-align: center; margin-top: 64px">Not ready to talk? Try a free 2-minute check: <a href="/website-check/">your website</a> or <a href="/google-profile-check/">your Google profile</a>.</p>
    </div>
  </section>

  <section class="alt" id="about">
    <div class="wrap home-about">
      <Image class="home-about-photo" src={headshot} alt="Alexandria Cuellar" width={260} height={260} densities={[1, 2]} />
      <div class="home-about-text">
        <h2 class="mag-head">Practical technology guidance, <em>built around people.</em></h2>
        <p class="lede">My background is in software development and technical project management. I spent nearly 20 years as one of many developers behind local newspaper websites, including the Times Herald-Record, and since 2023 I've managed 14+ VR and mobile game projects. I founded Auva Studio to put that experience to work for small businesses, startups, nonprofits, and growing teams. I help with <a href="/websites/">websites</a>, <a href="/technology-consulting/">tech, automation, and AI</a>, and <a href="/production-emerging-tech/">production for games, XR, and AR</a>.</p>
        <p class="home-about-name"><b>Alexandria Cuellar</b>, founder of Auva Studio<br />I build websites, set up tools and automation, and produce games and XR.<br /><span class="muted">When I'm not working, you'll find me on long walks with my dog, Midna, around the Mid-Hudson Valley.</span></p>
        <figure class="quote home-about-quote">
        <blockquote>“{featured.quote}”</blockquote>
        <figcaption><b>{featured.name}</b><span class="muted">{featured.role}</span></figcaption>
      </figure>
        <div class="home-about-actions">
          <a class="btn btn-ghost" href="/about/">More about me <Icon name="arrow" size={18} /></a>
          <a class="founder-link" href="https://www.linkedin.com/company/auva-studio/" target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> Follow Auva Studio on LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <Cta />
</Base>
