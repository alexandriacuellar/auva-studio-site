---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/pages/home.css';
import Icon from '../components/Icon.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Cta from '../components/Cta.astro';
import { categories, site, testimonials } from '../data/site';
const featured = testimonials.find((t) => t.name === 'Matthew Udy');
import headshot from '../assets/alexandria-cuellar.jpg';

const columns = [
  {
    icon: 'globe', name: 'Websites', href: '/websites/',
    items: [
      { title: 'I need a website', text: "You're starting something new, or you've never had one.", href: '/websites/', to: 'Website packages' },
      { title: "My website isn't working for me", text: "It's outdated, slow, or hard to update.", href: '/websites/diagnostic/', to: 'Website Diagnostic' },
      { title: "Customers can't find me on Google Maps", text: 'Your listing is missing, out of date, or buried.', href: '/websites/google-business-profile/', to: 'Google Business Profile' },
    ],
  },
  {
    icon: 'bulb', name: 'Automation, AI & Projects', href: '/automation-ai-projects/',
    items: [
      { title: 'We do the same tasks by hand every week', text: 'Follow-ups, data entry, and reports that could run on their own.', href: '/automation-ai-projects/automation/', to: 'Automation' },
      { title: "I want to use AI, but I'm not sure where to start", text: "Or what's safe to share with it.", href: '/automation-ai-projects/ai/', to: 'AI for you and your team' },
      { title: 'This project needs someone to lead it', text: 'Scope, schedule, vendors, and people, kept on track.', href: '/automation-ai-projects/project-management/', to: 'Project management' },
    ],
  },
  {
    icon: 'bolt', name: 'AR, VR & Production', href: '/ar-vr-production/',
    items: [
      { title: 'I want customers to see my product before they buy', text: 'Your product in 3D, in their room, right from their phone. No app needed.', href: '/ar-vr-production/ar/#ar-product', to: 'AR packages' },
      { title: 'I want my menu, packaging, or flyer to do more', text: 'Scan it and it comes to life, with buttons to order or book.', href: '/ar-vr-production/ar/#ar-menu', to: 'AR packages' },
      { title: "We're making a game or XR project", text: 'An experienced producer to keep scope, schedule, and the team on track.', href: '/ar-vr-production/studios/', to: 'Game and XR production' },
    ],
  },
];
const strip = ['Published prices', 'Written quote before work starts', 'You own everything', 'Work with me directly'];
---
<Base>
  <section class="hero bd-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Make technology <em>work for your business.</em></h1>
      <p class="lede">Websites, automation, and AI for small businesses in the Hudson Valley, plus AR, VR, and game production.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="#services">How I help</a>
      </div>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Three ways <em>I help.</em></h2>
        <p class="lede">Start with a conversation or a focused review. I recommend only what you need, then help you put it in place.</p>
      </div>
      <ServiceCards categories={categories} lang="en" />
      <p class="hero-checks" style="text-align: center; margin-top: 64px">Not ready to talk? Try a free 2-minute check: <a href="/website-check/">your website</a> or <a href="/google-profile-check/">your Google profile</a>.</p>
    </div>
  </section>

  <section class="home-routes">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Not sure where to start? <em>Find your situation.</em></h2>
        <p class="lede">Pick the one that sounds most like you.</p>
      </div>
      <div class="sit-board">
        {columns.map((c) => (
          <div class="sit-col">
            <a class="sit-col-head" href={c.href}><Icon name={c.icon} size={20} /> {c.name}</a>
            <ul>
              {c.items.map((x) => (
                <li><a class="sit-card" href={x.href}>
                  <b>{x.title}</b>
                  <span class="muted">{x.text}</span>
                  <span class="sit-to">{x.to} <Icon name="arrow" size={16} /></span>
                </a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="sit-else"><b>Something else?</b> Not sure what you need? <a href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call</a> or <a href="/contact/">tell me what's happening</a>.</p>
    </div>
  </section>

  <section class="home-about-band" id="about">
    <div class="wrap home-about">
      <Image class="home-about-photo" src={headshot} alt="Alexandria Cuellar" width={200} height={200} densities={[1, 2]} />
      <div class="home-about-text">
        <h2 class="mag-head">Practical technology guidance, <em>built around people.</em></h2>
        <p class="lede">Hi, I'm Alexandria, founder of Auva Studio. I bring 20+ years in web development and project management to small businesses, startups, nonprofits, and growing teams. I also hold a Mixed Reality (XR) Certificate and use AI in my work every day.</p>
        <figure class="quote home-about-quote">
        <blockquote>“{featured.quote}”</blockquote>
        <figcaption><b>{featured.name}</b><span class="muted">{featured.role}</span></figcaption>
      </figure>
        <div class="home-about-actions">
          <a class="btn btn-ghost" href="/about/">More about me <Icon name="arrow" size={18} /></a>
          <a class="founder-link" href="https://www.linkedin.com/company/auva-studio/" target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> Follow Auva Studio on LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <Cta promises={strip} />
</Base>
