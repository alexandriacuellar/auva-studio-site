---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { categories, journey, site, testimonials } from '../data/site';
const featured = testimonials.find((t) => t.name === 'Matthew Udy');
import headshot from '../assets/alexandria-cuellar.jpg';
import siteMockup from '../assets/website-mockup-happy-tails.png';

const situations = [
  { title: 'Your website needs attention', text: "It's outdated, slow, hard to update, or not bringing in inquiries.", href: '/websites/', icon: 'globe' },
  { title: "You're facing a technology decision", text: 'Too many tools, platforms, or vendors, and no clear way to choose.', href: '/technology-consulting/#planning', icon: 'compass' },
  { title: 'A project needs structure', text: 'Priorities, timelines, or vendors need someone to pull them together.', href: '/technology-consulting/#delivery', icon: 'check' },
  { title: 'You see an AI opportunity', text: 'You want AI that saves real time, not AI for its own sake.', href: '/ai-emerging-tech/#ai-team', icon: 'bolt' },
  { title: 'You have an emerging-tech idea', text: 'An early concept, prototype, or immersive experience you want to test.', href: '/ai-emerging-tech/#xr', icon: 'layers' },
];

// The hero star chart: the three services as points of a small constellation around Delta Virginis, the star Auva is named after.
// Positions are percentages of the chart: x/y on wide screens, mx/my on phones (the chart is taller there).
const pts = {
  web: { x: 14, y: 64, mx: 22, my: 30 },
  con: { x: 42, y: 30, mx: 72, my: 16 },
  star: { x: 60, y: 58, mx: 50, my: 54 },
  ai: { x: 84, y: 32, mx: 72, my: 80 },
  m1: { x: 27, y: 84, mx: 12, my: 62 },
  m2: { x: 93, y: 64, mx: 92, my: 50 },
  m3: { x: 74, y: 84, mx: 28, my: 88 },
};
type Pt = keyof typeof pts;
const links: [Pt, Pt][] = [['web', 'con'], ['con', 'star'], ['star', 'ai'], ['web', 'm1'], ['m1', 'star'], ['ai', 'm2'], ['star', 'm3']];
const nodes: { id: Pt; label: string; href: string }[] = [
  { id: 'web', label: 'Websites', href: '/websites/' },
  { id: 'con', label: 'Consulting', href: '/technology-consulting/' },
  { id: 'ai', label: 'AI & Emerging Tech', href: '/ai-emerging-tech/' },
];
const minor: Pt[] = ['m1', 'm2', 'm3'];
const at = (k: Pt) => `--x:${pts[k].x}%;--y:${pts[k].y}%;--mx:${pts[k].mx}%;--my:${pts[k].my}%`;
const strip = ['Fixed prices', 'Fast, accessible sites', 'You own everything', 'Found on Google and AI search'];
---
<Base>
  <section class="hero bd-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Make technology <em>work for your business.</em></h1>
      <p class="lede">Auva Studio is a digital technology and solutions studio for small businesses, startups, nonprofits, and growing teams. I build websites, help you choose the right tools, run your technology projects, and help you explore AI & Emerging Tech.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="#services">How I help</a>
      </div>
      <ul class="hero-strip">{strip.map((t) => <li><Icon name="tick" size={16} />{t}</li>)}</ul>
      <figure class="sky-wrap">
        <div class="sky" role="group" aria-label="The three services as a small constellation around Delta Virginis">
          {(['wide', 'tall'] as const).map((v) => (
            <svg class={`sky-lines sky-${v}`} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              {links.map(([a, b]) => v === 'wide'
                ? <line x1={pts[a].x} y1={pts[a].y} x2={pts[b].x} y2={pts[b].y} vector-effect="non-scaling-stroke" />
                : <line x1={pts[a].mx} y1={pts[a].my} x2={pts[b].mx} y2={pts[b].my} vector-effect="non-scaling-stroke" />)}
            </svg>
          ))}
          {minor.map((k) => <span class="sky-dot" style={at(k)} aria-hidden="true"></span>)}
          <span class="sky-star" style={at('star')}><span class="sky-glyph" aria-hidden="true"></span><span class="sky-label">Delta Virginis</span></span>
          {nodes.map((n) => <a class="sky-node" href={n.href} style={at(n.id)}><span class="sky-pt" aria-hidden="true"></span><span class="sky-label">{n.label}</span></a>)}
        </div>
        <figcaption class="sky-note"><b>What's in a name?</b> Auva takes its name from Delta Virginis, a red giant star in the constellation Virgo, about 198 light-years from Earth. A little inspiration from the stars, a little curiosity about what's possible.</figcaption>
        <p class="bd-chip">
          <Image src={headshot} alt="" width={56} height={56} densities={[1, 2]} />
          <span><b>Hi, I'm Alexandria.</b> You'll work with me directly, from the first call to handover.</span>
        </p>
      </figure>
    </div>
  </section>

  <section class="alt">
    <div class="wrap about-grid">
      <div>
        <h2 class="mag-head">What are you <em>working on?</em></h2>
        <p class="lede">You don't need to know which service you need. Start with the situation that sounds most like yours.</p>
        <p class="muted">Not sure which fits? Real problems often span more than one. <a href="/contact/">Tell me what's happening</a> and I'll suggest a next step.</p>
      </div>
      <ul class="route-list">
        {situations.map((x) => (
          <li><a href={x.href}>
            <span class="icon"><Icon name={x.icon} /></span>
            <span><b>{x.title}</b><span class="muted">{x.text}</span></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Three ways <em>I help.</em></h2>
        <p class="lede">Start with a conversation or a focused review. I recommend only what you need, then help you put it in place.</p>
      </div>
      <div class="grid grid-3">
        {categories.map((c) => (
          <a class="card category bd-card" href={c.href}>
            <div class="bd-media">
              {c.href === '/technology-consulting/' && (<div class="bd-art bd-art-plan" aria-hidden="true">
            <div class="float f1"><span class="k">Technology plan</span><b>3 options compared</b><span class="bar"><i style="width:82%"></i></span><span class="bar"><i style="width:56%"></i></span></div>
            <div class="float f2"><span class="k">This week</span><ul><li><Icon name="tick" size={14} />Requirements signed off</li><li><Icon name="tick" size={14} />Vendor call booked</li></ul></div>
          </div>)}
              {c.href === '/ai-emerging-tech/' && (<div class="bd-art bd-art-ai" aria-hidden="true">
            <div class="float f1 chat"><span class="k">Team AI Workshop</span><p class="q">Can AI draft our weekly client update?</p><p class="a">Yes, with a check step before it goes out.</p></div>
            <div class="float f2"><span class="k">Prototype Sprint</span><span class="bar"><i style="width:66%"></i></span></div>
          </div>)}
              {c.href === '/websites/' && <Image src={siteMockup} alt="A sample nonprofit website shown on a laptop and a phone on a sunny desk" widths={[480, 800]} sizes="(max-width: 960px) 100vw, 380px" loading="eager" />}
            </div>
            <div class="bd-body">
              <span class="bd-tag">{c.href === '/websites/' ? 'Websites' : c.href === '/ai-emerging-tech/' ? 'AI & Emerging Tech' : 'Consulting'}</span>
              <h3 style={`view-transition-name: svc-${c.href.replaceAll('/', '')}`}>{c.title}</h3>
              <p class="muted">{c.text}</p>
              <ul class="ticks">{c.items.map((it) => <li><Icon name="tick" size={18} />{it}</li>)}</ul>
              <span class="more">{c.cta} <Icon name="arrow" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="alt" id="about">
    <div class="wrap about-grid">
      <div>
        <h2 class="mag-head">Practical technology guidance, <em>built around people.</em></h2>
        <p class="lede">I founded Auva Studio to help small businesses, startups, nonprofits, and growing teams make confident technology decisions, starting with your goals, not a product to sell.</p>
        <p>I've spent more than 20 years helping organizations use technology to solve problems. For nearly two decades I built websites and digital products for newspaper companies, and since 2023 I've managed 14+ VR experiences and mobile games for indie game studios. Now I bring that experience to businesses that need a website, want more from the tools they have, or are curious about AI and emerging technology.</p>
        <div class="founder">
          <Image src={headshot} alt="Alexandria Cuellar" width={72} height={72} densities={[1, 2]} />
          <p><b>Alexandria Cuellar</b>, digital technology and solutions consultant<br /><span class="muted">When I'm not working, you'll find me on long walks with my dog, Midna, around the Mid-Hudson Valley.</span><br /><a class="founder-link" href="https://www.linkedin.com/company/auva-studio/" target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> Follow Auva Studio on LinkedIn</a></p>
        </div>
        <figure class="quote quote-inline">
          <blockquote>“{featured.quote}”</blockquote>
          <figcaption><b>{featured.name}</b><span class="muted">{featured.role}</span></figcaption>
        </figure>
      </div>
      <ul class="principles">
        <li><h3>Start with the problem</h3><p class="muted">Technology should make something clearer, easier, or more reliable.</p></li>
        <li><h3>Fit your business</h3><p class="muted">Your goals, budget, and systems shape every recommendation.</p></li>
        <li><h3>Keep it simple</h3><p class="muted">The simplest solution that does the job well.</p></li>
        <li><h3>Leave you confident</h3><p class="muted">Clear explanations and systems you can maintain.</p></li>
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Simple to start, <em>clear at every step.</em></h2>
        <p class="lede">Whatever you need, it starts the same way.</p>
      </div>
      <ol class="steps steps-3">
        {journey.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p style="margin-top: 28px"><a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>
  <Cta />
</Base>

<style>
  /* Home hero: headline and buttons over a star chart of the three services. */
  .bd-hero { padding: 80px 0 96px; }
  .bd-hero-inner { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .bd-hero-inner .lede { margin: 0 auto 32px; max-width: 640px; }
  .bd-hero-inner .hero-actions { justify-content: center; }
  .hero-strip { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 20px; font-size: 0.95rem; color: var(--muted); }
  .hero-strip li { display: inline-flex; align-items: center; gap: 6px; }
  .hero-strip svg { color: var(--success); flex: none; }
  @media (max-width: 640px) { .hero-strip { display: grid; grid-template-columns: auto auto; justify-content: center; text-align: left; font-size: 0.88rem; gap: 6px 16px; } }
  .bd-hero h1 { max-width: 15ch; }

  /* The star chart. Points sit at --x/--y (wide) or --mx/--my (phones); lines are drawn in the SVG underneath. */
  .sky-wrap { position: relative; margin: 56px 0 0; width: 100%; max-width: 1080px; text-align: left; }
  .sky { position: relative; aspect-ratio: 2 / 1; border-radius: 28px; overflow: hidden; background-color: var(--night);
    background-image: radial-gradient(circle at 8% 22%, rgb(255 255 255 / 0.5) 0 1px, transparent 2px), radial-gradient(circle at 22% 12%, rgb(255 255 255 / 0.35) 0 1px, transparent 2px),
      radial-gradient(circle at 33% 52%, rgb(255 255 255 / 0.3) 0 1px, transparent 2px), radial-gradient(circle at 51% 16%, rgb(255 255 255 / 0.45) 0 1px, transparent 2px),
      radial-gradient(circle at 66% 30%, rgb(255 255 255 / 0.3) 0 1px, transparent 2px), radial-gradient(circle at 79% 60%, rgb(255 255 255 / 0.4) 0 1px, transparent 2px),
      radial-gradient(circle at 88% 14%, rgb(255 255 255 / 0.35) 0 1px, transparent 2px), radial-gradient(circle at 46% 90%, rgb(255 255 255 / 0.3) 0 1px, transparent 2px),
      radial-gradient(circle at 96% 86%, rgb(255 255 255 / 0.4) 0 1px, transparent 2px), radial-gradient(circle at 4% 70%, rgb(255 255 255 / 0.3) 0 1px, transparent 2px); }
  .sky-lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sky-lines line { stroke: rgb(196 210 240 / 0.45); stroke-width: 1.5; stroke-linecap: round; }
  .sky-tall { display: none; }
  .sky-dot, .sky-star, .sky-node { position: absolute; left: var(--x); top: var(--y); }
  .sky-dot { width: 6px; height: 6px; margin: -3px 0 0 -3px; border-radius: 50%; background: #c4d2f0; }
  .sky-node { display: flex; flex-direction: column; align-items: center; transform: translate(-50%, -7px); color: var(--white); text-decoration: none; }
  .sky-pt { width: 14px; height: 14px; border-radius: 50%; background: var(--white); box-shadow: 0 0 0 5px rgb(255 255 255 / 0.14); transition: box-shadow 0.2s, transform 0.2s; }
  .sky-label { margin-top: 10px; padding: 0 6px; border-radius: 6px; background: var(--night); white-space: nowrap; font-family: var(--font-head); font-weight: 600; font-size: 1.05rem; }
  .sky-node:hover .sky-pt, .sky-node:focus-visible .sky-pt { transform: scale(1.25); box-shadow: 0 0 0 8px rgb(255 255 255 / 0.2); }
  .sky-node:hover .sky-label, .sky-node:focus-visible .sky-label { text-decoration: underline; text-underline-offset: 4px; }
  .sky-star { display: flex; flex-direction: column; align-items: center; transform: translate(-50%, -22px); }
  .sky-glyph { width: 44px; height: 44px; background: var(--star); clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%); filter: drop-shadow(0 0 10px rgb(243 154 59 / 0.9)); }
  .sky-star .sky-label { margin-top: 6px; font-family: var(--font-body); font-weight: 500; font-size: 0.85rem; color: #f6c48f; }
  .sky-note { position: absolute; top: 26px; left: 30px; max-width: 330px; margin: 0; font-size: 0.88rem; line-height: 1.5; color: #c4d2f0; }
  .sky-note b { display: block; color: var(--white); font-family: var(--font-head); font-weight: 600; font-size: 0.95rem; margin-bottom: 2px; }
  .bd-chip { position: absolute; right: 28px; bottom: -28px; margin: 0; display: flex; gap: 14px; align-items: center; text-align: left; max-width: 400px; background: var(--white); border: 1px solid var(--border); border-radius: 18px; padding: 14px 18px; box-shadow: var(--shadow-strong); font-size: 0.95rem; }
  .bd-chip img { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex: none; }
  /* The one moment of motion: the lines draw in from left to right, then the star lights up. */
  @media (prefers-reduced-motion: no-preference) {
    .sky-lines { animation: sky-draw 1.6s cubic-bezier(0.4, 0, 0.2, 1) 0.4s both; }
    .sky-glyph { animation: sky-light 0.9s ease-out 1.5s both; }
    @keyframes sky-draw { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
    @keyframes sky-light { from { opacity: 0; transform: scale(0.4) rotate(-45deg); } to { opacity: 1; transform: none; } }
  }
  @media (max-width: 760px) {
    .sky { aspect-ratio: 4 / 5; }
    .sky-wide { display: none; }
    .sky-tall { display: block; }
    .sky-dot, .sky-star, .sky-node { left: var(--mx); top: var(--my); }
    .sky-label { font-size: 0.95rem; }
    .sky-note { position: static; max-width: none; margin-top: 16px; color: var(--muted); }
    .sky-note b { color: var(--ink); }
    .bd-chip { position: relative; right: auto; bottom: auto; margin: 16px 0 0; max-width: none; }
  }

  /* Where to start: plain rows that link to the right service */
  .route-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .route-list a { display: flex; gap: 18px; align-items: flex-start; padding: 20px 4px; border-bottom: 1px solid var(--border); color: inherit; text-decoration: none; }
  .route-list .icon { color: var(--primary); flex: none; margin-top: 2px; }
  .route-list b { display: block; font-family: var(--font-head); font-size: 1.15rem; margin-bottom: 2px; }
  .route-list .muted { display: block; }
  .route-list a:hover b { color: var(--primary); }

  /* About: four principles as a plain list */
  .principles { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .principles li { padding-left: 18px; border-left: 3px solid var(--border); }
  .principles h3 { margin: 0 0 2px; font-size: 1.15rem; }
  .principles p { margin: 0; }

  /* Service cards with an image on top, as on Boosh's "Three ways we help you grow". */
  .bd-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .bd-media { aspect-ratio: 4 / 3; overflow: hidden; background: var(--surface); }
  .bd-media img { width: 100%; height: 100%; object-fit: cover; }
  .bd-body { padding: 26px 28px 30px; display: flex; flex-direction: column; flex: 1; }
  .bd-body .more { margin-top: auto; }
  .bd-tag { align-self: flex-start; font-size: 0.85rem; font-weight: 700; color: var(--primary); background: var(--tint); border-radius: 999px; padding: 4px 12px; margin-bottom: 14px; }

  /* Illustrated panels: floating interface cards on a soft gradient, standing in for photos still to be taken. */
  .bd-art { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .bd-art-plan { background: var(--tint); }
  .bd-art-ai { background: #e6e0ff; }
  .float { position: absolute; background: var(--white); border-radius: 16px; padding: 16px 18px; box-shadow: 0 18px 40px rgba(18, 35, 94, 0.16); font-size: 0.9rem; line-height: 1.4; display: flex; flex-direction: column; gap: 8px; }
  .float .k { font-family: var(--font-head); font-size: 0.8rem; font-weight: 700; color: var(--primary); }
  .float b { font-family: var(--font-head); font-size: 1.05rem; }
  .float ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .float li { display: flex; gap: 8px; align-items: center; }
  .float li svg { color: var(--success); flex: none; }
  .float li.todo { color: var(--muted); padding-left: 22px; }
  .bar { display: block; height: 8px; border-radius: 99px; background: var(--surface); }
  .bar i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--primary), var(--bright)); }
  .f1 { left: 8%; top: 9%; width: 52%; }
  .f2 { right: 7%; top: 40%; width: 46%; }
  .f3 { left: 14%; bottom: 8%; width: 44%; }
  .tl { display: flex; justify-content: space-between; position: relative; padding: 6px 0; }
  .tl::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; background: var(--border); }
  .tl i { position: relative; width: 14px; height: 14px; border-radius: 50%; background: var(--white); border: 3px solid var(--primary); }
  .tl i.on { background: var(--primary); }
  .chat .q { margin: 0; align-self: flex-end; background: var(--primary); color: var(--white); padding: 8px 12px; border-radius: 12px 12px 2px 12px; }
  .chat .a { margin: 0; background: var(--surface); padding: 8px 12px; border-radius: 12px 12px 12px 2px; }
  .bd-art-ai .f1 { width: 62%; }
  .bd-art-ai .f2 { top: 52%; }
  .bd-art-ai .f3 { bottom: 7%; }
  .badge { flex-direction: row; align-items: center; gap: 10px; }
  .badge svg { color: var(--primary); flex: none; }
  .badge b { font-size: 1.6rem; margin-left: auto; }

  .float { font-size: 0.8rem; padding: 12px 14px; gap: 6px; }
  .float b { font-size: 0.95rem; }
  .bd-art .f1 { left: 7%; top: 9%; width: 66%; }
  .bd-art .f2 { right: 6%; top: auto; bottom: 9%; width: 58%; }
  @media (max-width: 640px) {
    .bd-hero { padding: 56px 0 64px; }
  }
</style>
