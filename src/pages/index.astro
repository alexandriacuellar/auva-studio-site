---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/pages/home.css';
import Icon from '../components/Icon.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Cta from '../components/Cta.astro';
import { categories, site, testimonials } from '../data/site';
const featured = testimonials.find((t) => t.name === 'Matthew Udy');
import headshot from '../assets/alexandria-cuellar.jpg';

const situations = [
  { title: 'I need a website', text: "You're starting something new, or you've never had one.", href: '/websites/', to: 'Websites', icon: 'globe' },
  { title: "My website isn't working for me", text: "It's outdated, slow, hard to update, or customers can't find you on Google Maps.", href: '/websites/diagnostic/', to: 'Website Diagnostic', icon: 'search' },
  { title: "My tools don't fit how we work", text: "Too many apps, too many workarounds, and you're not sure where AI fits.", href: '/technology-consulting/#planning', to: 'Automation, AI & Projects', icon: 'compass' },
  { title: 'We do the same tasks by hand every week', text: 'Follow-ups, data entry, and reports that could run on their own.', href: '/technology-consulting/automation/', to: 'Automation', icon: 'gear' },
  { title: 'This project needs someone to lead it', text: 'Someone to keep scope, schedule, vendors, and people on track.', href: '/technology-consulting/project-management/', to: 'Project Management', icon: 'check' },
  { title: 'I want customers to see my product before they buy', text: 'Your product in 3D, in their room or on their counter, right from their phone. No app needed.', href: '/production-emerging-tech/#ar-product', to: 'Production & Emerging Tech', icon: 'layers' },
  { title: 'I want my menu, packaging, or flyer to do more', text: 'Scan it with a phone and it comes to life, with buttons to order, book, or follow.', href: '/production-emerging-tech/#ar-menu', to: 'Production & Emerging Tech', icon: 'book' },
  { title: "We're making a game or XR project", text: 'An experienced producer to keep scope, schedule, and the team on track.', href: '/production-emerging-tech/#production', to: 'Production & Emerging Tech', icon: 'bolt' },
];
const strip = ['Published prices', 'Written quote before work starts', 'You own everything', 'Work with me directly'];
---
<Base>
  <section class="hero bd-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Make technology <em>work for your business.</em></h1>
      <p class="lede">Websites, automation, and AI for small businesses in the Hudson Valley, plus production for games and XR.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="#services">How I help</a>
      </div>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Three ways <em>I help.</em></h2>
        <p class="lede">Start with a conversation or a focused review. I recommend only what you need, then help you put it in place.</p>
      </div>
      <ServiceCards categories={categories} lang="en" />
      <p class="hero-checks" style="text-align: center; margin-top: 64px">Not ready to talk? Try a free 2-minute check: <a href="/website-check/">your website</a> or <a href="/google-profile-check/">your Google profile</a>.</p>
    </div>
  </section>

  <section class="home-routes">
    <div class="wrap about-grid">
      <div>
        <h2 class="mag-head">Not sure where to start? <em>Find your situation.</em></h2>
        <p class="lede">Pick the one that sounds most like you, or <a href="/contact/">tell me what's happening</a>.</p>
      </div>
      <ul class="route-list">
        {situations.map((x) => (
          <li><a href={x.href}>
            <span class="icon"><Icon name={x.icon} /></span>
            <span><b>{x.title}</b><span class="muted">{x.text}</span><span class="route-to">{x.to} <Icon name="arrow" size={16} /></span></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-about-band" id="about">
    <div class="wrap home-about">
      <Image class="home-about-photo" src={headshot} alt="Alexandria Cuellar" width={200} height={200} densities={[1, 2]} />
      <div class="home-about-text">
        <h2 class="mag-head">Practical technology guidance, <em>built around people.</em></h2>
        <p class="lede">Hi, I'm Alexandria, founder of Auva Studio. I bring 20+ years in web development and project management to small businesses, startups, nonprofits, and growing teams. I also hold a Mixed Reality (XR) Certificate and use AI in my work every day.</p>
        <figure class="quote home-about-quote">
        <blockquote>“{featured.quote}”</blockquote>
        <figcaption><b>{featured.name}</b><span class="muted">{featured.role}</span></figcaption>
      </figure>
        <div class="home-about-actions">
          <a class="btn btn-ghost" href="/about/">More about me <Icon name="arrow" size={18} /></a>
          <a class="founder-link" href="https://www.linkedin.com/company/auva-studio/" target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> Follow Auva Studio on LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <Cta promises={strip} />
</Base>
