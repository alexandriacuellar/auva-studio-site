---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Faq from '../components/Faq.astro';
import { site, testimonials, aiOffers as offers, serviceSchema } from '../data/site';

const faqs = [
  { q: 'Do we need technical skills to use AI?', a: 'No. Readiness Plans and workshops are built for non-technical teams, using tools like ChatGPT, Claude, and Gemini in your real work.' },
  { q: 'Is it safe to use AI with our business data?', a: 'It can be, with the right tools and settings. Every Readiness Plan covers privacy and quality risks and recommends tools that fit your rules.' },
  { q: "What's the difference between the AI Readiness Plan and the Technology Assessment?", a: 'The Readiness Plan focuses only on AI. The Assessment reviews all your systems and tools. Both are $650, with three one-hour sessions and a written plan.' },
  { q: 'Will a prototype be ready to launch?', a: 'No. A prototype is a proof of concept. It answers one question with placeholder visuals, so you can decide to build, change, or stop before investing more.' },
  { q: 'Do you build full XR or game productions?', a: 'I plan and manage them. Production Support gives XR, game, and immersive teams producer support, and XR prototypes are built with a developer partner.' },
];

const schema = serviceSchema(offers.map((o) => ({ name: o.title, description: o.text, price: o.price })), '/ai-emerging-tech/');

const audiences = [
  { icon: 'bulb', title: 'Small businesses and nonprofits', text: "You're curious about AI but not sure where it helps, which tools to trust, or how to get your team using them." },
  { icon: 'mail', title: 'Professional offices', text: 'Accountants, law offices, real estate, insurance, and agencies with lots of email, documents, and repeat questions. Find where AI saves hours each week, safely.' },
  { icon: 'key', title: 'Startups', text: 'Teams with an AI product idea. Test a chatbot or AI feature with real users before you build the full thing.' },
  { icon: 'star', title: 'Creative, XR, and game studios', text: 'You need production structure, feasibility checks, or an experienced producer without a full-time hire.' },
  { icon: 'book', title: 'Museums, educators, and cultural organizations', text: "You're planning an immersive or interactive experience and want a realistic scope before you commit." },
  { icon: 'globe', title: 'Venues, brands, and tourism', text: 'Attractions, event spaces, retailers, and visitor centers planning an immersive or interactive experience. Know the budget before you commit.' },
];

const sprint = [
  { title: 'Define', text: 'We agree on the one question the prototype should answer and what success looks like.' },
  { title: 'Build', text: 'I create a small, working version, with a developer partner when needed, using existing tools wherever possible.' },
  { title: 'Test', text: "You and a few real users try it, and I gather what worked and what didn't." },
  { title: 'Decide', text: 'You get a short report with a recommendation: build it, change it, or stop here, before you invest more.' },
];

// Every AI and emerging tech price in one place.
const glance = [
  { name: 'Team AI Workshop', note: '2 hours, up to 10 people', price: 'From $500' },
  { name: 'AI Readiness Plan', note: '3 sessions and a written plan', price: '$650' },
  { name: 'AI Prototype Sprint', note: 'An AI chatbot or workflow, 2–3 weeks', price: 'From $2,500' },
  { name: 'Concept & Feasibility Review', note: 'Is it doable, a rough budget, and the team it takes, about 2 weeks', price: '$650' },
  { name: 'XR Prototype Sprint', note: '4–6 weeks, with a developer partner', price: 'From $7,500' },
  { name: 'Production Support, monthly', note: '3-month minimum', price: '10 hrs $650, 20 hrs $1,200, 40 hrs $2,200' },
  { name: 'Production Support, as needed', price: '$65/hr' },
];

const groups = [
  { key: 'ai', id: 'ai-team', title: 'AI for your team', text: 'For small businesses, startups, nonprofits, and growing teams that want to use AI in the work they already do.' },
  { key: 'xr', id: 'xr', title: 'XR, games, and interactive', text: 'For studios, museums, educators, and venues planning something new to build.' },
];

const quotes = testimonials.filter((t) => t.name !== 'Aaron Sorrels');
---
<Base title="AI & Emerging Tech" seoTitle="AI & Emerging Tech Consulting, Workshops & Prototypes | Auva Studio" schema={schema} description="Practical AI for small businesses and teams, plus feasibility reviews, prototypes, and production support for XR, game, and interactive projects.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <p class="bd-pill" style="view-transition-name: svc-ai">AI & Emerging Tech</p>
      <h1 class="mag-head">New technology, <em>without the expensive experiments.</em></h1>
      <p class="lede">AI, XR, and interactive tools can open real opportunities, or become expensive experiments. I help you find where new technology actually fits, test ideas on a small scale, and move forward with a clear plan.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call</a>
      </div>
      <nav class="bd-sublinks" aria-label="AI and emerging technology services">
        <a href="#ai-team">AI for your team</a>
        <a href="#xr">XR, games, and interactive</a>
      </nav>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Built for teams <em>exploring what's next.</em></h2>
      </div>
      <div class="grid grid-3">
        {audiences.map((a) => (
          <div class="card">
            <div class="icon"><Icon name={a.icon} size={32} /></div>
            <h3>{a.title}</h3>
            <p class="muted">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="offers">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Start small, <em>learn fast.</em></h2>
        <p class="lede">Each offer has a clear scope and price, so you can explore without a big commitment.</p>
      </div>
      {groups.map((g) => (
        <div class="offer-group" id={g.id}>
          <h3 class="offer-group-title">{g.title}</h3>
          <p class="muted">{g.text}</p>
          <div class="grid grid-3">
            {offers.filter((o) => o.group === g.key).map((o) => (
              <div class="card offer" id={o.id}>
                <div class="icon"><Icon name={o.icon} size={32} /></div>
                <h3>{o.title}</h3>
                <p class="muted">{o.text}</p>
                <a class="more" href={`/ai-emerging-tech/?topic=${o.id}#start`} style="margin-top: 12px">Ask about this</a>
              </div>
            ))}
          </div>
        </div>
      ))}
      <h3 class="glance-title">Pricing at a glance</h3>
      <dl class="card glance">
        {glance.map((g) => (
          <div class="glance-row">
            <dt>{g.name}{g.note && <span class="muted small">{g.note}</span>}</dt>
            <dd>{g.price}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="alt" id="sprint">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Test the idea <em>before you invest in it.</em></h2>
        <p class="lede">Prototypes are proofs of concept. They answer one question, use placeholder visuals, and aren't ready for public release.</p>
      </div>
      <ol class="steps steps-4">
        {sprint.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap about-grid">
      <div>
        <h2 class="mag-head">Production experience <em>across games, XR, and interactive work.</em></h2>
        <p class="lede">I've led projects for indie game studios, XR and interactive teams, and creative organizations, managing Agile workflows, design documentation, schedules, and teams of highly creative people. That production background keeps experiments focused and grounded in what can actually ship.</p>
        <div class="stats">
          <div><span class="stat">14+</span><span class="muted">VR experiences and mobile games</span></div>
        </div>
        <p class="small muted" style="margin-top: 20px"><b>Tools I work with.</b> XR and games: Unity, Meta Quest. AI: ChatGPT, Claude, Gemini. Automation: Zapier.</p>
      </div>
      <div class="values">
        {quotes.map((t) => (
          <figure class="card quote">
            <blockquote>“{t.quote}”</blockquote>
            <figcaption><b>{t.name}</b><span class="muted">{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <Faq faqs={faqs} alt />
  <InquiryForm kind="ai" />
</Base>

<style>
  .offer-group + .offer-group { margin-top: 48px; }
  .offer-group-title { font-size: 1.4rem; margin-bottom: 4px; }
  .offer-group > .muted { margin-bottom: 20px; }
</style>
