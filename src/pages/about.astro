---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import '../styles/pages/home.css';
import '../styles/pages/about.css';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import { site, testimonials } from '../data/site';
import bearMountain from '../assets/about/bear-mountain-bridge.jpg';
import nyack from '../assets/about/nyack-broadway.jpg';
import mohonk from '../assets/about/mohonk-new-paltz.jpg';
import centralPark from '../assets/about/central-park-nyc.jpg';
import headshot from '../assets/alexandria-cuellar.jpg';
const places = [
  { src: bearMountain, place: 'Bear Mountain Bridge', alt: 'Bear Mountain Bridge over the Hudson River in autumn' },
  { src: nyack, place: 'Nyack', alt: 'Brick storefronts and a sidewalk café on Broadway in Nyack' },
  { src: mohonk, pos: 'right center', place: 'Mohonk, New Paltz', alt: 'Mohonk Mountain House above Lake Mohonk in fall color' },
  { src: centralPark, place: 'Central Park, New York City', alt: 'Central Park Mall lined with autumn trees and lamps' }
];
---
<Base title="About" seoTitle="About Alexandria Cuellar, Web Developer and XR Producer | Auva Studio" description="Meet Alexandria Cuellar, founder of Auva Studio. Work with her directly on websites, tools, AI, AR, and VR, in English or Spanish, from the Mid-Hudson Valley.">
  <section class="hero about-hero">
    <div class="wrap">
      <Image class="about-photo" src={headshot} alt="Alexandria Cuellar" width={300} height={300} densities={[1, 2]} loading="eager" />
      <div>
        <h1 class="mag-head" set:html={`Hi, I'm Alexandria. <em>Let's make technology work for you.</em>`} />
        <p class="lede">I founded Auva Studio to help small businesses, startups, nonprofits, and growing teams make confident technology decisions, starting with your goals. I help with <a href="/websites/">websites</a>, <a href="/automation-ai-projects/">automation and AI, project management</a>, and <a href="/ar-vr-production/">AR, VR, and game production</a>.</p>
        <p class="about-role">Founder of Auva Studio, based in the Mid-Hudson Valley</p>
        <div class="hero-actions">
          <a class="btn" href="/#services">How I help <Icon name="arrow" size={18} /></a>
          <a class="btn btn-ghost" href="/contact/">Get in touch</a>
        </div>
        <p class="small" style="margin-top: 16px"><a href="https://www.linkedin.com/company/auva-studio/" target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> Follow Auva Studio on LinkedIn</a></p>
      </div>
    </div>
  </section>

  <section class="band-cream about-story">
    <div class="wrap about-grid">
      <div>
        <h2 class="mag-head" set:html={`20+ years of making <em>technology work for people.</em>`} />
        <p>I spent nearly two decades as a developer behind newspaper websites and web apps, from the Times Herald-Record to more than 150 daily newspapers now owned by USA TODAY Co. Early on I also built websites for small businesses, through the paper's website package for new advertisers and later for local designers. Since 2023 I've worked as a technical project manager, managing 14+ VR experiences and mobile games for indie game studios. I've built in Meta Horizon Worlds for years and I'm part of Meta Horizon Start and the Meta Horizon Creator Program. Because my background is in both software development and project management, I understand how the technology works and build plans teams can actually keep up with. Now I bring that experience to businesses that need a website, want more from the tools they have, or are curious about AI and emerging technology.</p>
        <p class="small muted" style="margin-top: 20px"><b>Tools I work with.</b> Projects: Jira, Trello, Notion, ClickUp, and Zapier. AR, VR, and games: Unity, Meta Quest, Meta glasses, Meta Horizon, and AR in the browser. AI: ChatGPT, Claude, Gemini, and Meta AI.</p>
      </div>
      <div class="stats">
          <div><span class="stat">20+</span><span class="muted">years in software and digital technology</span></div>
          <div><span class="stat">14+</span><span class="muted">VR experiences and mobile games</span></div>
          <div class="stat-wide"><span class="stat">Nearly 20</span><span class="muted">years building websites and web apps for newspapers</span></div>
      </div>
    </div>
  </section>

  <section class="about-why">
    <div class="wrap about-home">
      <h2 class="mag-head" set:html={`Why I started <em>Auva Studio.</em>`} />
      <p class="lede">Technology keeps changing, and AI, AR, and VR are changing it faster than ever. I started Auva Studio to put my decades of experience to work for small businesses, startups, nonprofits, and growing teams: to help you stay ahead of those changes and make technology work for you. I use AI tools in my own work, and I'm eager to show you how they can help you too.</p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap about-grid">
      <div>
        <h2 class="mag-head" set:html={`How <em>I work.</em>`} />
        <p class="lede">You work with me directly, from the first call to handover.</p>
      </div>
      <ul class="principles">
        <li><h3>Start with the problem</h3><p class="muted">Technology should make something clearer, easier, or more reliable.</p></li>
        <li><h3>Fit your business</h3><p class="muted">Your goals, budget, and systems shape every recommendation.</p></li>
        <li><h3>Keep it simple</h3><p class="muted">The simplest solution that does the job well.</p></li>
        <li><h3>Leave you confident</h3><p class="muted">Clear explanations and systems you can maintain.</p></li>
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head" set:html={`What people say <em>about working with me.</em>`} />
      </div>
      <div class="grid grid-3 about-quotes">
        {testimonials.map((t) => (
          <figure class="card quote">
            <blockquote>“{t.quote}”</blockquote>
            <figcaption><b>{t.name}</b><span class="muted">{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap about-home">
      <h2 class="mag-head" set:html={`Rooted in <em>the Hudson Valley.</em>`} />
      <p class="lede">I'm based in the Mid-Hudson Valley and work with businesses and organizations across the Hudson Valley, New York City, and anywhere in the US. When I'm not working, you'll find me on long walks with my dog, Midna.</p>
      <ul class="place-strip" aria-label="Places I love in the Hudson Valley and New York City">
        {places.map((pl) => (
          <li>
            <figure>
              <Image src={pl.src} alt={pl.alt} style={pl.pos ? `object-position: ${pl.pos}` : undefined} widths={[360, 560, 760]} sizes="(max-width: 860px) 46vw, 270px" loading="lazy" />
              <figcaption>{pl.place}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Cta />
</Base>
