---
// AR, VR & Production main page: 2 cards that open the AR and studio sub pages (alexandria 2026-11-03). Copy in data/production.ts.
import Base from '../layouts/Base.astro';
import '../styles/pages/production-emerging-tech.css';
import Icon from '../components/Icon.astro';
import ToolGrid from '../components/ToolGrid.astro';
import HelloBand from '../components/HelloBand.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Faq from '../components/Faq.astro';
import { site, aiOffers, serviceSchema } from '../data/site';
import { t, services, audiences, faq } from '../data/production';

const byId = Object.fromEntries(services.map((x) => [x.id, x]));
const faqs = [faq.app, faq.bigger, faq.glasses, faq.underway];
const schema = serviceSchema(aiOffers.filter((o) => o.group !== 'consulting').map((o) => ({ name: o.title, description: o.text, price: o.price })), '/ar-vr-production/');
---
<Base title={t.title} seoTitle={t.seo} schema={schema} description={t.desc}>
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head" set:html={t.heroH} />
      <p class="lede">{t.heroL}</p>
      <div class="hero-actions">
        <a class="btn" href="#services">{t.seeHow} <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="#start">Get in touch</a>
      </div>
    </div>
  </section>

  <HelloBand facts={t.facts} />

  <section class="alt" id="who">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head" set:html={t.whoH} />
      </div>
      <div class="grid grid-3 who">
        {audiences.map((a) => (
          <div class="card">
            <div class="icon"><Icon name={a.icon} size={32} /></div>
            <h3>{a.title}</h3>
            <p class="muted">{a.text}</p>
            <a class="more" href={byId[a.to].href} style="margin-top: 12px">{byId[a.to].link} <Icon name="arrow" size={16} /></a>
          </div>
        ))}
        <div class="card who-other">
          <div class="icon"><Icon name="chat" size={32} /></div>
          <h3>{t.elseH}</h3>
          <p>{t.elseP}</p>
          <a class="more" href="?topic=unsure#start" style="margin-top: 12px">{t.talk} <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head" set:html={t.twoH} />
        <p class="lede">{t.twoL}</p>
      </div>
      <div class="grid grid-2">
        {services.map((x) => (
          <a class="card offer" href={x.href} id={x.id}>
            <div class="icon"><Icon name={x.icon} size={32} /></div>
            <h3>{x.title}</h3>
            <p class="svc-meta"><b>{x.price}</b></p>
            <p class="muted">{x.text}</p>
            <span class="more" style="margin-top: auto; padding-top: 12px">{x.link} <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
      <div class="card card-row bigger next-card" style="margin-top: 32px" id="next">
        <div class="icon"><Icon name="bolt" size={36} /></div>
        <div>
          <span class="idea-tag">{t.nextTag}</span>
          <h3>{t.nextH}</h3>
          <p class="muted">{t.nextP}</p>
          <a class="more" href="?topic=xr-idea#start" style="margin-top: 12px">{t.nextA} <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="alt" id="how">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head" set:html={t.howH} />
        <p class="lede">{t.howL}</p>
      </div>
      <ol class="steps steps-4">
        {t.steps.map(([h, p], i) => <li><span class="num" aria-hidden="true">{i + 1}</span><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
      <p class="muted" style="margin-top: 32px" set:html={t.website} />
    </div>
  </section>

  <Faq faqs={faqs} />
  <InquiryForm kind="ai" alt />
  <ToolGrid set="xr" lede="The headsets, engines, and tools I use to produce games, VR, and AR." />
</Base>
