---
import Base from '../layouts/Base.astro';
import '../styles/pages/websites.css';
import Icon from '../components/Icon.astro';
import PathBand from '../components/PathBand.astro';
import Packages from '../components/Packages.astro';
import InquiryForm from '../components/InquiryForm.astro';
import PhoneViewer from '../components/PhoneViewer.astro';
import Faq from '../components/Faq.astro';
import PaybackCalc from '../components/PaybackCalc.astro';
import { comparison, addons, process, packages, samples, site, serviceSchema } from '../data/site';
import { Image } from 'astro:assets';
import skytopShot from '../assets/samples/skytop-floor-co.jpg';
import eneaShot from '../assets/samples/enea-hudson-cattle-farm.jpg';
import rondoutShot from '../assets/samples/rondout-mercantile.jpg';
import headshot from '../assets/alexandria-cuellar.jpg';
const sampleShots: Record<string, ImageMetadata> = { 'skytop-floor-co': skytopShot, 'enea-hudson-cattle-farm': eneaShot, 'rondout-mercantile': rondoutShot };

const faqs = [
  { id: "faq-founding", q: "What is the founding client offer?", a: "My first 10 website clients get 10% off any package, in exchange for a short review and permission to feature their site. It doesn't combine with the nonprofit discount; if both apply, you get the bigger one." },
  { q: "How long does a website take?", a: "Essential takes 2–3 weeks, Expanded 3–5 weeks, and Complete 6+ weeks, once I have your content. The sooner you send your text and photos, the sooner your site goes live." },
  { q: 'Do I own my website?', a: 'Yes. Once your project is paid in full, your website, content, domain, and accounts are yours. You can move to another host or developer anytime.' },
  { q: "Do I need my copy and photos ready?", a: "No. Rough notes, your old site, and phone photos are a fine start, and I polish what you have and draft what's missing. Want a head start? See how to get ready for your new website.", html: "No. Rough notes, your old site, and phone photos are a fine start, and I polish what you have and draft what's missing. Want a head start? See <a href=\"/websites/get-ready/\">how to get ready for your new website</a>." },
  { q: "Can I update the site myself?", a: "Yes, with a CMS (content management system), a simple dashboard where you change your text, photos, news, and events with no code. It's included in Complete and can be added to Essential or Expanded from $1,750, or you can send changes to me for $59 each." },
  { q: "What if something breaks after launch?", a: "It's rare, since most sites I build have no plugins to break. Fixes are free for 30 days after launch, then see Help After Launch, and I always explain the cause and the cost before fixing anything.", html: "It's rare, since most sites I build have no plugins to break. Fixes are free for 30 days after launch, then see <a href=\"/websites/help-after-launch/\">Help After Launch</a>, and I always explain the cause and the cost before fixing anything." },
  { q: "Will people find me on Google?", a: "Every package is built to be found, with clear page titles, search data, a sitemap, and fast pages that Google and AI tools like ChatGPT can read. No one can honestly promise a ranking, but your site starts with everything search engines look for." },
  { q: "I'm on WordPress, Wix, or Squarespace. Can you move my site?", a: "Most likely, yes. I keep your content and the page addresses Google already knows, so you don't lose visitors, and moving the pages in your package is included. If your site already works well where it is, switching may not be worth it, and I'll tell you honestly." },
];

const schema = serviceSchema([
  ...packages.map((p) => ({ name: `${p.name} website package`, description: p.blurb, price: p.price })),
  ...addons.map((a) => ({ name: a.title, description: a.text, price: a.price })),
], '/websites/');


const audiences = [
  { id: 'hospitality', icon: 'star', title: 'Hospitality & Tourism', text: 'Inns, restaurants, wineries, and farms, with menus, rooms, and events easy to find on a phone.' },
  { id: 'makers', icon: 'layers', title: 'Shops & Makers', text: 'Boutiques, galleries, and artists, showing your work and where to buy it.' },
  { id: 'services', icon: 'wrench', title: 'Local Services', text: 'Trades, wellness, salons, and real estate, with an easy way to call, book, or get a quote.' },
  { id: 'nonprofits', icon: 'book', title: 'Nonprofits & Culture', text: 'Museums, arts groups, rescues, and community groups, sharing your story, events, and ways to give.' },
  { id: 'startups', icon: 'key', title: 'Startups', text: 'Early teams that need a credible first site that collects sign-ups or inquiries.' },
  { id: 'studios', icon: 'bolt', title: 'Game & XR Studios', text: 'Indie game and XR studios, with trailers, a press kit, and store links.' },
];
---
<Base title="Website Services" seoTitle="Small Business Websites in the Hudson Valley, from $1,500 | Auva Studio" schema={schema} description="Fast, mobile-friendly websites for small businesses, startups, nonprofits, and growing teams. One-time packages from $1,500, with free or low-cost hosting.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head" style="max-width: 22ch">A website that helps customers <em>find you, trust you, and reach out.</em></h1>
      <p class="lede">Easy to use on a phone, quick to load, low-cost to run, and fully yours.</p>
      <div class="hero-actions">
        <a class="btn" href="#packages">See packages</a>
        <a class="btn btn-ghost" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
      </div>
      <ul class="hero-strip">{['Fixed prices', 'Fast, accessible sites', 'You own everything', 'Found on Google and AI search'].map((t) => <li><Icon name="tick" size={16} />{t}</li>)}</ul>
    </div>
  </section>

  <section class="hello-band" aria-label="Alexandria Cuellar">
    <div class="wrap hello"><Image src={headshot} alt="" width={120} height={120} densities={[1, 2]} /><span><b>Hi, I'm Alexandria,</b> founder of Auva Studio. I spent nearly 20 years as a developer behind newspaper websites, from the Times Herald-Record to more than 150 daily newspapers. Now I build fast, custom sites for small businesses, and you'll work with me directly from the first call to launch. <a href="/about/">More about me</a><ul class="hello-facts"><li><b>Nearly 20</b> years building websites</li><li><b>20+</b> years in software</li></ul></span></div>
  </section>

  <section class="alt" id="who">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">A site that fits <em>your kind of business.</em></h2>
        <p class="lede">I'm based in the Mid-Hudson Valley and build for businesses and organizations across the Hudson Valley, New York City, and anywhere in the US.</p>
      </div>
      <div class="grid grid-3 who">
        {audiences.map((a) => (
          <div class="card" id={a.id}>
            <div class="icon"><Icon name={a.icon} size={32} /></div>
            <h3>{a.title}</h3>
            <p class="muted">{a.text}</p>
            {a.id === 'nonprofits' && <p class="small who-phone">Ask about my nonprofit discount.</p>}
            <a class="more" href="?topic=website#start" style="margin-top: 12px">Talk about your site</a>
          </div>
        ))}
        <div class="card who-other who-wide">
          <div class="icon"><Icon name="chat" size={32} /></div>
          <h3>Something else?</h3>
          <p>Tell me about your business or project, and I'll recommend the package that fits.</p>
          <a class="more" href="?topic=website#start" style="margin-top: 12px">Talk about your site</a>
        </div>
      </div>
    </div>
  </section>

  <section id="packages">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Choose <em>the right package.</em></h2>
        <p class="lede">Each package builds on the one before it, so you only pay for what you need today.</p>
      </div>
      <Packages />
      <PaybackCalc />
    </div>
  </section>

  <section class="alt" id="samples">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">See what <em>each package looks like.</em></h2>
        <p class="lede">One sample site for each package. The businesses are made up, but every page and feature works the way it would on your site, and the forms show what your visitors would see.</p>
      </div>
      <PhoneViewer />
      <div class="grid grid-3 samples">
        {samples.map((sm) => {
          const pk = packages.find((x) => x.name === sm.package);
          return (
            <a class="card sample" href={`/samples/${sm.slug}/`}>
              <Image class="sample-shot" src={sampleShots[sm.slug]} alt={`The home page of ${sm.name}, a sample ${sm.package} site`} widths={[480, 720, 960]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 380px" />
              <span class="tag">{sm.package}, {pk?.price}</span>
              <h3>{sm.name}</h3>
              <p class="muted">{sm.text}</p>
              <p class="sample-for">{sm.goodFor}</p>
              <span class="sample-go">Visit the sample site <span aria-hidden="true">→</span></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">A clear process <em>from discovery to launch.</em></h2>
        <p class="lede">You work directly with me from start to finish, with a short progress update every week. Your website agreement spells out every detail.</p>
      </div>
      <ol class="steps steps-4">
        {process.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <p class="you"><b>You:</b> {s.you}</p>
            {s.link && <p class="you"><a href={s.link.href}>{s.link.text} <Icon name="arrow" size={14} /></a></p>}
            <ul class="step-terms">{s.terms.map((t) => <li><Icon name="tick" size={16} />{t}</li>)}</ul>
          </li>
        ))}
      </ol>
      <p class="fine">The steps are the same for every package. Smaller sites move through them faster, and larger sites take a little longer.</p>
    </div>
  </section>

  <section class="alt" id="compare">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Fast, affordable, <em>and yours.</em></h2>
        <p class="lede">I build every site with Astro, a modern tool for fast, lightweight websites. It keeps your site fast and my prices fair.</p>
      </div>
      <div class="grid grid-3 plain-grid">
        {comparison.benefits.map((b) => (
          <div><div class="icon"><Icon name={b.icon} /></div><h3>{b.title}</h3><p class="muted">{b.text}</p></div>
        ))}
      </div>
      <p class="fine">71% of real-world Astro sites pass Google's Core Web Vitals check, compared with 48% of WordPress sites (<a href="https://httparchive.org/" target="_blank" rel="noopener">HTTP Archive</a> and <a href="https://developer.chrome.com/docs/crux" target="_blank" rel="noopener">Chrome UX Report</a>). <a href="https://httparchive.org/reports/techreport/tech?client=mobile&tech=Astro,WordPress,Gatsby,Next.js,Nuxt.js&geo=ALL&rank=ALL&page=1" target="_blank" rel="noopener">View the full dataset</a>.</p>
      <div class="proof proof-why">
        <Image src={headshot} alt="Alexandria Cuellar" width={72} height={72} densities={[1, 2]} />
        <div>
          <p class="proof-line">I spent nearly 20 years building websites and web apps for newspapers. Your site gets the same care, from the first call to launch.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="addons">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Add more <em>when you need it.</em></h2>
      </div>
      <div class="grid grid-2">
        {addons.map((a) => (
          <div class="card">
            <div class="icon"><Icon name={a.icon} size={32} /></div>
            <h3>{a.title}</h3>
            <p class="muted">{a.text}</p>
            <p><b style="color: var(--primary)">{a.price}</b></p>
          </div>
        ))}
      </div>

      <div class="card card-row" id="care" style="margin-top: 24px">
        <div class="icon"><Icon name="wrench" size={32} /></div>
        <div>
          <h3>Would you rather I make the changes?</h3>
          <p class="muted">Send me updates when you need them for <b style="color: var(--primary)">$59 each</b>, with no monthly fee, or pick a monthly plan from $99 if your site changes often.</p>
          <a class="more" href="/websites/help-after-launch/" style="margin-top: 8px">See how updates work</a>
        </div>
      </div>

      <div class="band" style="margin-top: 48px" id="brand">
        <div>
          <p class="eyebrow" style="color: var(--tint)">Optional add-on</p>
          <h2>Brand Essentials</h2>
          <p>A recognizable, consistent visual identity that makes a strong first impression, ready for your website and beyond.</p>
        </div>
        <div>
          <p class="price" style="font-size: 4rem">$1,000</p>
          <p>Flat rate. On its own, or with any website package.</p>
          <a class="btn" href="/websites/brand-essentials/">See what you get</a>
        </div>
      </div>
      <p class="muted" style="margin-top: 32px"><b>Once your site is live,</b> I can also help you <a href="/technology-consulting/#automation">automate the busywork</a>, <a href="/technology-consulting/#ai">put AI to work for your team</a>, or <a href="/production-emerging-tech/#ideas">try AR for your business</a>.</p>
    </div>
  </section>

  <section class="alt" id="diagnostic">
    <div class="wrap">
      <PathBand
        eyebrow="Already have a website?"
        title="Find out what's costing you customers."
        text="Phones, speed, Google search, and first impressions: what's working, what isn't, and what to fix first."
        free={{ label: 'Not sure yet?', title: 'Free website check', text: '10 quick questions. Your score and top fixes right away, no email needed.', href: '/website-check/', cta: 'Start the free check' }}
        paid={{ label: 'Want the full picture?', title: 'Website Diagnostic, $199', text: 'A plain-English report with your fixes in order, within 5 business days. Credited toward a new site.', href: '/websites/diagnostic/', cta: 'Get the Diagnostic' }}
      />
      <PathBand
        id="google-business-profile"
        style="margin-top: 24px"
        eyebrow="Have local customers?"
        title="Get found on Google Maps."
        text="It's often the first thing people see when they search for you. Wrong hours or a thin profile send them to someone else."
        free={{ label: 'Not sure yet?', title: 'Free Google profile check', text: 'Your score and top fixes right away, or simple setup steps if you have no profile yet.', href: '/google-profile-check/', cta: 'Start the free check' }}
        paid={{ label: 'Rather have me do it?', title: 'Setup or optimization, $500', text: 'One time, with a guide for keeping it current. $150 credited toward a website.', href: '/websites/google-business-profile/', cta: 'Get it done for you' }}
      />
    </div>
  </section>

  <Faq faqs={faqs} />
  <InquiryForm kind="website" alt />
</Base>
