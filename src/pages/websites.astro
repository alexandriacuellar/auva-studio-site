---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Packages from '../components/Packages.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Faq from '../components/Faq.astro';
import PaybackCalc from '../components/PaybackCalc.astro';
import { comparison, addons, process, packages, samples, site, testimonials, serviceSchema } from '../data/site';
import { Image } from 'astro:assets';
import skytopShot from '../assets/samples/skytop-floor-co.jpg';
import eneaShot from '../assets/samples/enea-hudson-cattle-farm.jpg';
import rondoutShot from '../assets/samples/rondout-mercantile.jpg';
import headshot from '../assets/alexandria-cuellar.jpg';
const featured = testimonials.find((t) => t.name === 'Matthew Udy');
const sampleShots: Record<string, ImageMetadata> = { 'skytop-floor-co': skytopShot, 'enea-hudson-cattle-farm': eneaShot, 'rondout-mercantile': rondoutShot };

const faqs = [
  { q: 'How much does a small business website cost?', a: 'Packages are one-time project fees: Essential Presence is $1,500, Expanded Presence is $2,950, and Complete Presence is $5,500. Larger or custom websites are quoted for your project. After launch, you pay about $20 a year for your domain, and hosting is free or low cost.' },
  { q: 'One page or several: which is right for me?', a: 'One scrolling page works well when you do one main thing, want visitors to take one simple step (call, book, or ask for an estimate), and most people find you on their phones. Several pages work better when you offer services people search for separately, since each page can show up on Google on its own, or when you have more to share, like a menu, a gallery, or your story. Both options cost the same in Essential, and we choose together during Discovery.' },
  { id: 'faq-founding', q: 'What is the founding client offer?', a: "My first 10 website clients get 10% off Essential, Expanded, or Complete Presence, in exchange for a short review and permission to feature their site. It doesn't combine with the nonprofit discount; if both apply, you get the bigger one. The offer ends after 10 projects." },
  { q: 'How long does a website take?', a: 'Essential Presence takes 2–3 weeks, Expanded Presence 3–5 weeks, and Complete Presence 6+ weeks. The timeline starts once you sign your website agreement, pay the deposit, and send me your content, like your text, photos, and logo. The sooner I have everything, the sooner your site goes live.' },
  { q: 'Do I own my website?', a: 'Yes. Once your project is paid in full, your website, content, domain, and accounts are yours. You can move to another host or developer anytime.' },
  { q: 'Do I need my copy and photos ready?', a: "No. Rough notes, your old site, and phone photos are a fine start. I polish what you have and draft what's missing. Copy changes are part of your revision rounds, so we get it right without surprise costs." },
  { q: 'Can I update the site myself?', a: "Yes. A Content Editing Dashboard, also called a CMS (from $1,750, included in Complete Presence), lets you change your page text, photos, and collections like news or events, with no code. The starting price includes 2 collections; more are quoted first. Or send changes to me: $50 per update (up to about 30 minutes of edits, sent together in one request), or a pack of 5 updates for $200, used within 12 months. Most updates are done within 2 business days." },
  { q: 'Do you do SEO, AEO, and GEO?', a: "Yes, in every package. SEO (search engine optimization) helps you show up on Google. AEO and GEO (answer and generative engine optimization) help AI tools like ChatGPT and Google's AI Overviews find and mention your business. I set up clear page titles, structured data (schema), a sitemap, and fast pages from the start. Astro sites usually score well on Core Web Vitals, Google's measures of speed and stability, and I share your PageSpeed scores at launch." },
  { q: 'Can you build an online store?', a: "Yes. I can add a few buy buttons to a small site or build a full online store. Every store is different, so tell me what you sell and about how many products you have, and I'll quote it for you." },
  { q: "I'm on WordPress, Wix, or Squarespace. Can you move my site?", a: "Most likely, yes. I can move you to Astro and keep your content and branding. I keep the pages Google already knows and point each old address to its new page, so you don't lose visitors you've already earned. Moving the pages in your package is included; large blogs or catalogs are quoted separately. Not sure whether to fix or rebuild? Start with a Website Diagnostic." },
];

const schema = serviceSchema([
  ...packages.map((p) => ({ name: `${p.name} website package`, description: p.blurb, price: p.price })),
  ...addons.map((a) => ({ name: a.title, description: a.text, price: a.price })),
], '/websites/');

const essentials = [
  { icon: 'globe', title: 'A clear first impression', text: 'A welcoming home page that says who you are and who you help.' },
  { icon: 'star', title: 'Your services, explained', text: 'What you offer, how it works, and what it costs to get started.' },
  { icon: 'check', title: 'Reasons to trust you', text: 'Your story, experience, testimonials, and credentials.' },
  { icon: 'mail', title: 'An obvious next step', text: 'Inquiry forms, contact details, and the areas you serve.' },
];

const audiences = [
  { id: 'hospitality', icon: 'star', title: 'Hospitality & Tourism', who: 'Inns, B&Bs, restaurants, wineries, breweries, and farms.', text: 'Menus, rooms, hours, and events that are easy to find on a phone, with links to your booking or reservation system.' },
  { id: 'makers', icon: 'layers', title: 'Shops & Makers', who: 'Boutiques, galleries, craft studios, and artists.', text: 'Show your work and point customers to where they can buy. An online store can be added, quoted based on the tools you use.' },
  { id: 'services', icon: 'wrench', title: 'Local Services', who: 'Trades, wellness practitioners, salons, and real estate agents.', text: 'Your services, reviews, and service area, with an easy way to call, book, or request a quote.' },
  { id: 'nonprofits', icon: 'book', title: 'Nonprofits & Culture', who: 'Arts councils, museums, land trusts, animal rescues, and community groups.', text: 'Tell your story, share programs and events, and make it easy to support you. Donations can be added, quoted for your project. Registered nonprofit? Ask about my nonprofit discount.' },
  { id: 'startups', icon: 'key', title: 'Startups', who: 'Early teams launching a product or service.', text: 'A credible first site that explains what you do and collects sign-ups or inquiries.' },
  { id: 'studios', icon: 'bolt', title: 'Game & XR Studios', who: 'Independent game, VR, and interactive studios, anywhere.', text: 'A fast studio site for your games and experiences: trailers, a press kit, your team, and links to Steam, Meta Quest, or app stores.' },
];
---
<Base title="Website Services" seoTitle="Small Business Websites from $1,500 | Auva Studio" schema={schema} description="Fast, mobile-friendly websites for small businesses, startups, nonprofits, and growing teams. One-time packages from $1,500, with free or low-cost hosting.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <p class="bd-pill" style="view-transition-name: svc-websites">Website Services</p>
      <h1 class="mag-head" style="max-width: 22ch">A website that helps customers <em>find you, trust you, and reach out.</em></h1>
      <p class="lede">A website is often the first technology decision a business makes, and the one it lives with longest. I plan each site the way I'd plan any technology project, so it's focused, easy to use on a phone, low-cost to run, and fully yours.</p>
      <div class="hero-actions">
        <a class="btn" href="#packages">See packages</a>
        <a class="btn btn-ghost" href={site.booking} target="_blank" rel="noopener">Book a free 30-minute call <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="alt" id="who">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">A site that fits <em>your kind of business.</em></h2>
        <p class="lede">I'm based in the Mid-Hudson Valley and build for businesses and organizations across the Hudson Valley, New York City, and anywhere in the US.</p>
      </div>
      <div class="grid grid-3 who">
        {audiences.map((a) => (
          <div class="card" id={a.id}>
            <div class="icon"><Icon name={a.icon} size={32} /></div>
            <h3>{a.title}</h3>
            <p class="small muted">{a.who}</p>
            <p class="who-text">{a.text}</p>
            {a.id === 'nonprofits' && <p class="small who-phone">Ask about my nonprofit discount.</p>}
            <a class="more" href="?topic=website#start" style="margin-top: 12px">Talk about your site</a>
          </div>
        ))}
        <div class="card who-other who-wide">
          <div class="icon"><Icon name="chat" size={32} /></div>
          <h3>Something else?</h3>
          <p>Tell me about your business or project, and I'll recommend the package that fits.</p>
          <a class="more" href="?topic=website#start" style="margin-top: 12px">Talk about your site</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Everything <em>your visitors are looking for.</em></h2>
      </div>
      <div class="grid grid-4 plain-grid">
        {essentials.map((e) => (
          <div>
            <div class="icon"><Icon name={e.icon} size={28} /></div>
            <h3>{e.title}</h3>
            <p class="muted">{e.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt" id="compare">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Fast, affordable, <em>and yours.</em></h2>
        <p class="lede">I build every site with Astro, a modern tool for fast, lightweight websites. It keeps your site fast and my prices fair.</p>
      </div>
      <div class="grid grid-3 plain-grid">
        {comparison.benefits.map((b) => (
          <div><div class="icon"><Icon name={b.icon} /></div><h3>{b.title}</h3><p class="muted">{b.text}</p></div>
        ))}
      </div>
      <p class="fine"><b>Built to be found</b> means clear page titles, your hours, services, and location labeled for Google, and a structure AI tools like ChatGPT can read. No one can guarantee rankings or AI mentions, but these steps give your site the best chance.</p>
      <p class="fine">71% of real-world Astro sites pass Google's Core Web Vitals check, compared with 48% of WordPress sites. Based on real-world performance data from <a href="https://httparchive.org/" target="_blank" rel="noopener">HTTP Archive</a> and the <a href="https://developer.chrome.com/docs/crux" target="_blank" rel="noopener">Chrome UX Report</a>. <a href="https://httparchive.org/reports/techreport/tech?client=mobile&tech=Astro,WordPress,Gatsby,Next.js,Nuxt.js&geo=ALL&rank=ALL&page=1" target="_blank" rel="noopener">View the full dataset</a>.</p>
      <p class="fit-note"><b>When Astro isn't the right fit.</b> If your business already runs well on WordPress or another platform, switching may not be worth it. I'll tell you honestly on our first call.</p>
    </div>
  </section>

  <section id="packages">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Choose <em>the right package.</em></h2>
        <p class="lede">Each package builds on the one before it, so you only pay for what you need today.</p>
      </div>
      <Packages />
      <div class="proof">
        <Image src={headshot} alt="Alexandria Cuellar" width={72} height={72} densities={[1, 2]} />
        <div>
          <p class="proof-line">I spent nearly 20 years building websites and digital products for newspaper companies. Your site gets the same care, from the first call to launch.</p>
          <figure class="quote quote-inline">
            <blockquote>“{featured.quote}”</blockquote>
            <figcaption><b>{featured.name}</b><span class="muted">{featured.role}</span></figcaption>
          </figure>
        </div>
      </div>
      <PaybackCalc />
    </div>
  </section>

  <section class="alt" id="samples">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">See what <em>each package looks like.</em></h2>
        <p class="lede">One sample site for each package. The businesses are made up, but every page and feature works the way it would on your site, and the forms show what your visitors would see.</p>
      </div>
      <div class="grid grid-3 samples">
        {samples.map((sm) => {
          const pk = packages.find((x) => x.name === sm.package);
          return (
            <a class="card sample" href={`/samples/${sm.slug}/`}>
              <Image class="sample-shot" src={sampleShots[sm.slug]} alt={`The home page of ${sm.name}, a sample ${sm.package} site`} widths={[480, 720, 960]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 380px" />
              <span class="tag">{sm.package}, {pk?.price}</span>
              <h3>{sm.name}</h3>
              <p class="muted">{sm.text}</p>
              <span class="sample-go">Visit the sample site <span aria-hidden="true">→</span></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Add more <em>when you need it.</em></h2>
      </div>
      <div class="grid grid-3">
        {addons.map((a) => (
          <div class="card">
            <div class="icon"><Icon name={a.icon} size={32} /></div>
            <h3>{a.title}</h3>
            <p class="muted">{a.text}</p>
            <p><b style="color: var(--primary)">{a.price}</b></p>
          </div>
        ))}
      </div>

      <div class="band" style="margin-top: 48px" id="brand">
        <div>
          <p class="eyebrow" style="color: var(--tint)">Optional add-on</p>
          <h2>Brand Essentials</h2>
          <p>A recognizable, consistent visual identity that makes a strong first impression, ready for your website and beyond.</p>
          <p class="small"><a href="/websites/brand-essentials/" style="color: inherit; font-weight: 700">See what's included</a></p>
        </div>
        <div>
          <p class="price" style="font-size: 4rem">$1,000</p>
          <p>Flat rate. Add it to any website package.</p>
          <a class="btn" href="/websites/brand-essentials/#start">Ask about Brand Essentials</a>
        </div>
      </div>
    </div>
  </section>

  <section class="alt" id="care">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">How your site <em>stays up to date.</em></h2>
        <p class="lede">Choose who makes the changes. Your site has no plugins that need constant upkeep, so there's no monthly plan to pay for. Ask for updates when you need them. Sites with a Content Editing Dashboard or connected tools may need occasional upkeep, which I quote first.</p>
      </div>
      <div class="grid grid-2 care-paths">
        <div class="card">
          <div class="icon"><Icon name="wrench" size={36} /></div>
          <h3>I update it for you</h3>
          <p class="muted">Send me what to change and I take care of it.</p>
          <p><b style="color: var(--primary)">$50 per update, or a pack of 5 for $200</b></p>
        </div>
        <div class="card">
          <div class="icon"><Icon name="gear" size={36} /></div>
          <h3>You update it yourself</h3>
          <p class="muted">Add a Content Editing Dashboard and change your text, photos, news, and events whenever you like.</p>
          <p><b style="color: var(--primary)">From $1,750, included in Complete Presence</b></p>
        </div>
      </div>
      <p class="fine"><a class="more" href="/websites/help-after-launch/">How Help After Launch works <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">A clear process <em>from discovery to launch.</em></h2>
        <p class="lede">You work directly with me from start to finish, with a short progress update every week. Your website agreement spells out every detail.</p>
      </div>
      <ol class="steps steps-4">
        {process.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <p class="you"><b>You:</b> {s.you}</p>
            <ul class="step-terms">{s.terms.map((t) => <li><Icon name="tick" size={16} />{t}</li>)}</ul>
          </li>
        ))}
      </ol>
      <p class="fine">The steps are the same for every package. Smaller sites move through them faster, and larger sites take a little longer.</p>
    </div>
  </section>

  <section id="diagnostic">
    <div class="wrap">
      <div class="band">
        <div>
          <p class="eyebrow" style="color: var(--tint)">Already have a website?</p>
          <h2>Website Diagnostic</h2>
          <p>I check how your site works on phones, how easily people find you on Google, how fast it loads, and what to fix first.</p>
        </div>
        <div>
          <p class="price" style="font-size: 4rem">$199</p>
          <p>Credited toward your new website with me.</p>
          <a class="btn" href="/websites/diagnostic/#start">Request a Diagnostic</a>
          <p class="small" style="margin-top: 14px"><a href="/websites/diagnostic/" style="color: inherit; font-weight: 700">See what I check</a></p>
          <p class="small" style="margin-top: 6px">Not sure yet? <a href="/website-check/" style="color: inherit; font-weight: 700">Take the free 2-minute website check</a>.</p>
        </div>
      </div>
      <div class="band" id="google-business-profile" style="margin-top: 24px">
        <div>
          <p class="eyebrow" style="color: var(--tint)">Want to show up on Google Maps?</p>
          <h2>Google Business Profile</h2>
          <p>Your profile is often the first thing people see when they search for you. I set up a new one or improve the one you have, so your hours, services, photos, and website link are right.</p>
        </div>
        <div>
          <p class="price" style="font-size: 4rem">$500</p>
          <p>Setup or optimization, one time. $150 credited toward a website with me within 6 months.</p>
          <a class="btn" href="/websites/google-business-profile/#start">Ask about your profile</a>
          <p class="small" style="margin-top: 14px"><a href="/websites/google-business-profile/" style="color: inherit; font-weight: 700">See what's included</a></p>
          <p class="small" style="margin-top: 6px">Not sure yet? <a href="/google-profile-check/" style="color: inherit; font-weight: 700">Take the free Google profile check</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} alt />
  <InquiryForm kind="website" />
</Base>


<style>
  /* Experience line and a client quote under the package cards. */
  .proof { display: flex; gap: 20px; align-items: flex-start; max-width: 760px; margin: 40px auto 0; }
  .proof img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; flex: none; }
  .proof > div { min-width: 0; }
  .proof-line { margin: 0; font-size: 1.1rem; font-weight: 600; }
  .proof .quote-inline { margin-top: 20px; }
  @media (max-width: 640px) { .proof { flex-direction: column; gap: 14px; } }
</style>
