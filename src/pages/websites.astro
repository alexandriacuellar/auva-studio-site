---
import Base from '../layouts/Base.astro';
import '../styles/pages/websites.css';
import Icon from '../components/Icon.astro';
import ToolGrid from '../components/ToolGrid.astro';
import HelloBand from '../components/HelloBand.astro';
import Packages from '../components/Packages.astro';
import InquiryForm from '../components/InquiryForm.astro';
import PhoneViewer from '../components/PhoneViewer.astro';
import Faq from '../components/Faq.astro';
import { comparison, addons, process, packages, samples, site, serviceSchema } from '../data/site';

const faqs = [
  { id: "faq-founding", q: "What is the founding client offer?", a: "My first 10 website clients get 10% off any package, in exchange for a short review and permission to feature their site. It doesn't combine with the nonprofit discount; if both apply, you get the bigger one." },
  { q: "When does a website pay for itself?", a: "Divide the package price by what your site brings in each month. For example, if one new customer is worth $300 to you and your site brings in 2 a month, Expanded ($2,950) pays for itself in about 5 months." },
  { q: "How long does a website take?", a: "Essential takes 2–3 weeks, Expanded 3–5 weeks, and Complete 6+ weeks, once I have your content. The sooner you send your text and photos, the sooner your site goes live." },
  { q: 'Do I own my website?', a: 'Yes. Once your project is paid in full, your website, content, domain, and accounts are yours. You can move to another host or developer anytime.' },
  { q: "Do I need my copy and photos ready?", a: "No. Rough notes, your old site, and phone photos are a fine start, and I polish what you have and draft what's missing. Want a head start? See how to get ready for your new website.", html: "No. Rough notes, your old site, and phone photos are a fine start, and I polish what you have and draft what's missing. Want a head start? See <a href=\"/websites/get-ready/\">how to get ready for your new website</a>." },
  { q: "Can I update the site myself?", a: "Yes, with a CMS (content management system), a simple dashboard where you change your text, photos, news, and events with no code. It's included in Complete and can be added to Essential or Expanded from $1,750, or you can send changes to me for $59 each." },
  { q: "What if something breaks after launch?", a: "It's rare, since most sites I build have no plugins to break. Fixes are free for 30 days after launch, then see Help After Launch, and I always explain the cause and the cost before fixing anything.", html: "It's rare, since most sites I build have no plugins to break. Fixes are free for 30 days after launch, then see <a href=\"/websites/help-after-launch/\">Help After Launch</a>, and I always explain the cause and the cost before fixing anything." },
  { q: "Will people find me on Google?", a: "Every package is built to be found, with clear page titles, search data, a sitemap, and fast pages that Google and AI tools like ChatGPT can read. No one can honestly promise a ranking, but your site starts with everything search engines look for." },
  { q: "I'm on WordPress, Wix, or Squarespace. Can you move my site?", a: "Most likely, yes. I keep your content and the page addresses Google already knows, so you don't lose visitors, and moving the pages in your package is included. If your site already works well where it is, switching may not be worth it, and I'll tell you honestly." },
  { q: "Why do you build with Astro?", a: "Astro sites load fast, have little to maintain, and cost little to host, which keeps your costs down. 71% of real-world Astro sites pass Google’s Core Web Vitals check, compared with 48% of WordPress sites (HTTP Archive and Chrome UX Report). For web apps, like client portals or custom tools, I use other frameworks that fit the job.", html: "Astro sites load fast, have little to maintain, and cost little to host, which keeps your costs down. 71% of real-world Astro sites pass Google’s Core Web Vitals check, compared with 48% of WordPress sites (<a href=\"https://httparchive.org/reports/techreport/tech?client=mobile&tech=Astro,WordPress&geo=ALL&rank=ALL\" target=\"_blank\" rel=\"noopener\">HTTP Archive</a> and <a href=\"https://developer.chrome.com/docs/crux\" target=\"_blank\" rel=\"noopener\">Chrome UX Report</a>). For web apps, like client portals or custom tools, I use other frameworks that fit the job." },
  { q: "Do you work with agencies or designers?", a: "Yes. I build sites for agencies and independent designers, white-label or credited. See Development Partnerships.", html: "Yes. I build sites for agencies and independent designers, white-label or credited. See <a href=\"/development-partnerships/\">Development Partnerships</a>." },
];

const schema = serviceSchema([
  ...packages.map((p) => ({ name: `${p.name} website package`, description: p.blurb, price: p.price })),
  ...addons.map((a) => ({ name: a.title, description: a.text, price: a.price })),
], '/websites/');


const groups = [
  { id: 'website-checks', title: 'Your website', doors: [
    { label: 'Free', title: 'Website check', text: '10 quick questions. Your score and top fixes, no email needed.', href: '/website-check/', cta: 'Start the free check' },
    { label: 'Full picture', title: 'Website Diagnostic, $199', text: 'Your fixes in order, within 5 business days. Credited toward a new site.', href: '/websites/diagnostic/', cta: 'Get the Diagnostic' },
  ] },
  { id: 'google-business-profile', title: 'Your Google profile', doors: [
    { label: 'Free', title: 'Google profile check', text: 'Your score and top fixes, or setup steps if you have no profile yet.', href: '/google-profile-check/', cta: 'Start the free check' },
    { label: 'Done for you', title: 'Setup or optimization, $500', text: 'One time, with a guide to keep it current. $150 credited toward a website.', href: '/websites/google-business-profile/', cta: 'Get it done for you' },
  ] },
];

const audiences = [
  { id: 'hospitality', icon: 'star', title: 'Hospitality & Tourism', text: 'Inns, restaurants, wineries, and farms, with menus, rooms, and events easy to find on a phone.' },
  { id: 'makers', icon: 'layers', title: 'Shops & Makers', text: 'Boutiques, galleries, and artists, showing your work and where to buy it.' },
  { id: 'services', icon: 'wrench', title: 'Local Services', text: 'Trades, wellness, salons, and real estate, with an easy way to call, book, or get a quote.' },
  { id: 'nonprofits', icon: 'book', title: 'Nonprofits & Culture', text: 'Museums, arts groups, rescues, and community groups, sharing your story, events, and ways to give.' },
  { id: 'startups', icon: 'key', title: 'Startups', text: 'Early teams that need a credible first site that collects sign-ups or inquiries.' },
];
---
<Base title="Website Services" seoTitle="Small Business Websites in the Hudson Valley, from $1,500 | Auva Studio" schema={schema} description="Fast, mobile-friendly websites for small businesses, startups, nonprofits, and growing teams. One-time packages from $1,500, with free or low-cost hosting.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head" style="max-width: 22ch">A website that helps customers <em>find you, trust you, and reach out.</em></h1>
      <p class="lede">A custom design for your business, fast pages on every phone, and a low-cost site you fully own.</p>
      <div class="hero-actions">
        <a class="btn" href="#packages">See packages</a>
        <a class="btn btn-ghost" href="#start">Get in touch</a>
      </div>
    </div>
  </section>

  <HelloBand facts={["<b>20+</b> years in web development", "Built for <b>150+</b> newspapers", "Based in the <b>Hudson Valley</b>"]} />

  <section class="alt" id="who">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">A site that fits <em>your kind of business.</em></h2>
        <p class="lede">I'm based in the Mid-Hudson Valley and build for businesses and organizations across the Hudson Valley, New York City, and anywhere in the US.</p>
      </div>
      <div class="grid grid-3 who">
        {audiences.map((a) => (
          <div class="card" id={a.id}>
            <div class="icon"><Icon name={a.icon} size={32} /></div>
            <h3>{a.title}</h3>
            <p class="muted">{a.text}</p>
            {a.id === 'nonprofits' && <p class="small who-phone">Ask about my nonprofit discount.</p>}
          </div>
        ))}
        <div class="card who-other">
          <div class="icon"><Icon name="chat" size={32} /></div>
          <h3>Something else?</h3>
          <p>Tell me about your business or project, and I'll recommend the package that fits.</p>
          <a class="more" href="?topic=website#start" style="margin-top: 12px">Talk it through <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <section id="packages">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Choose <em>the right package.</em></h2>
        <p class="lede">Each package builds on the one before it, and every price is a one-time fee. Upgrade any time and pay only the difference.</p>
      </div>
      <Packages />
    </div>
  </section>

  <section class="alt" id="samples">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">See what <em>each package looks like.</em></h2>
        <p class="lede">One sample for each package. The businesses are made up, but everything works the way it would on your site. Pick one, then scroll and tap inside the phone.</p>
      </div>
      <PhoneViewer />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">A clear process <em>from discovery to launch.</em></h2>
        <p class="lede">You work directly with me from start to finish, with a short progress update every week. Your website agreement spells out every detail.</p>
      </div>
      <ol class="steps steps-4">
        {process.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <details class="step-more"><summary>See details</summary>
              <p class="you"><b>You:</b> {s.you}</p>
              {s.link && <p class="you"><a href={s.link.href}>{s.link.text} <Icon name="arrow" size={14} /></a></p>}
              <ul class="step-terms">{s.terms.map((t) => <li><Icon name="tick" size={16} />{t}</li>)}</ul>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="alt" id="compare">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Fast, affordable, <em>and yours.</em></h2>
        <p class="lede">I build most websites with Astro, a modern framework for fast, lightweight sites. Here’s what that means for you.</p>
      </div>
      <ul class="benefit-list">
        {comparison.benefits.map((b) => (
          <li><details><summary><Icon name={b.icon} size={22} /><span>{b.title}</span></summary><p class="muted">{b.text}</p></details></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="updates">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Keep your site <em>up to date.</em></h2>
        <p class="lede">After the 30 days of fixes, you make the changes or I do.</p>
      </div>
      <div class="grid grid-2">
        <div class="card" id="cms">
          <div class="icon"><Icon name="gear" size={32} /></div>
          <h3>Update it yourself</h3>
          <p class="muted">A CMS (content management system) is a simple dashboard where you update your text, photos, news, and events yourself. No code needed.</p>
          <p><b style="color: var(--primary)">Included in Complete Presence</b><br /><span class="muted">Add it to Essential or Expanded from $1,750.</span></p>
        </div>
        <div class="card" id="care">
          <div class="icon"><Icon name="wrench" size={32} /></div>
          <h3>Or I make the changes</h3>
          <p class="muted">Works with any package. Send me updates when you need them, with no monthly fee. If your site changes often, use an hour pack or a monthly retainer.</p>
          <p><b style="color: var(--primary)">$59 per update</b></p>
          <a class="more" href="/websites/help-after-launch/">See how updates work <Icon name="arrow" size={16} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="alt" id="addons">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Add more <em>when you need it.</em></h2>
      </div>
      <div class="grid grid-2">
        {addons.filter((a) => a.id !== 'cms').map((a) => (
          <div class="card">
            <div class="icon"><Icon name={a.icon} size={32} /></div>
            <h3>{a.title}</h3>
            <p class="muted">{a.text}</p>
            <p><b style="color: var(--primary)">{a.price}</b></p>
          </div>
        ))}
        <div class="card" id="brand">
          <div class="icon"><Icon name="star" size={32} /></div>
          <h3>Brand Essentials</h3>
          <p class="muted">A logo, colors, and fonts that make a strong first impression. On its own, or with any website package.</p>
          <p><b style="color: var(--primary)">$1,000</b></p>
          <a class="more" href="/websites/brand-essentials/">See what you get <Icon name="arrow" size={16} /></a>
        </div>
      </div>
      <p class="muted" style="margin-top: 32px"><b>Once your site is live,</b> I can also help you <a href="/automation-ai-projects/automation/">automate the busywork</a>, <a href="/automation-ai-projects/ai/">put AI to work for your team</a>, or <a href="/ar-vr-production/ar/">try AR for your business</a>.</p>
    </div>
  </section>

  <section id="diagnostic">
    <div class="wrap">
      <div class="band path-band path-band-4">
        <div>
          <p class="eyebrow" style="color: var(--tint)">Already have a website or a Google profile?</p>
          <h2>Find out what's costing you customers.</h2>
          <p>Start with a free check and get your top fixes right away, or have me do it for you.</p>
        </div>
        <div class="doors doors-4">
          {groups.map((g) => (
            <div class="door-group" id={g.id}>
              <p class="door-group-title">{g.title}</p>
              {g.doors.map((d, i) => (
                <a class:list={['door', { 'door-free': i === 0 }]} href={d.href}>
                  <span class="door-label">{d.label}</span>
                  <span class="door-title">{d.title}</span>
                  <span class="door-text">{d.text}</span>
                  <span class="door-cta">{d.cta} <Icon name="arrow" size={18} /></span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} />
  <InquiryForm kind="website" alt />
  <ToolGrid set="websites" lede="Astro for most websites, and other platforms when a project needs them, like an online store or a web app." />
</Base>
