---
import Base from '../layouts/Base.astro';
import '../styles/pages/website-check.css';
import { site } from '../data/site';

// Free self-check quiz. Scoring runs in the browser; answers are sent only if the visitor chooses to.
const questions = [
  { q: 'Does your site look good and work easily on a phone?', tip: 'Most visitors arrive on a phone. Check that text is readable and buttons are easy to tap.' },
  { q: 'Does it load quickly, even on a phone?', tip: 'Slow pages lose visitors. Large photos and too many plugins are the usual cause.' },
  { q: 'Can a new visitor tell what you do and who you serve within a few seconds?', tip: 'Say it plainly in the first line people see, before anything else.' },
  { q: 'Does every page make the next step clear, like call, book, buy, or donate?', tip: 'Give each page one main button that tells people exactly what to do.' },
  { q: 'Are your phone number, email, hours, and location easy to find?', tip: 'Put them in the footer and on a contact page, not only in a photo or PDF.' },
  { q: 'When you search your business name on Google, does your site show up first?', tip: 'Check your page titles and descriptions, and make sure Google can find your site.' },
  { q: 'Is your Google Business Profile claimed and up to date?', tip: "It's free and often the first thing people see. Add hours, photos, and your website link." },
  { q: 'Does your site show reviews, testimonials, or examples of your work?', tip: 'A few real quotes or photos of your work help people trust you.' },
  { q: 'Is everything on your site current, with no old events, prices, or staff?', tip: "Outdated details make people wonder if you're still open." },
  { q: 'Do you know how many people visit your site and contact you through it?', tip: "Free visitor stats show what's working and what to fix." },
];
const choices = [
  { label: 'Yes', value: 2 },
  { label: 'Not sure', value: 1 },
  { label: 'No', value: 0 },
];
---
<Base title="Free Website Check" description="Answer 10 quick questions about your website and see your score and what to fix first.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <p class="bd-pill">Free website check</p>
      <h1 class="mag-head">Is your website <em>working for you?</em></h1>
      <p class="lede">Answer 10 quick questions about your website. It takes about 2 minutes, and you'll see your score and what to fix first right away.</p>
      <p class="hero-note">Free. No email needed. Includes a free PDF guide you can keep. Your answers stay on your screen unless you choose to send them.</p>
    </div>
  </section>

  <section class="alt">
    <div class="wrap check-wrap">
      <form class="card check" id="check" novalidate>
        <ol class="check-list">
          {questions.map((item, i) => (
            <li>
              <fieldset>
                <legend>{item.q}</legend>
                <div class="choices">
                  {choices.map((c) => (
                    <label><input type="radio" name={`q${i}`} value={c.value} required /><span>{c.label}</span></label>
                  ))}
                </div>
              </fieldset>
            </li>
          ))}
        </ol>
        <div class="check-foot">
          <p class="muted small" id="progress" aria-live="polite">0 of {questions.length} answered</p>
          <button class="btn" type="submit">See my score</button>
        </div>
      </form>

      <div class="results" id="results" hidden tabindex="-1">
        <div class="card score-card">
          <p class="eyebrow">Your score</p>
          <p class="score"><span id="score">0</span><span class="out">/20</span></p>
          <p class="small muted">Yes = 2 points, Not sure = 1, No = 0.</p>
          <h2 class="mag-head" id="band-title"></h2>
          <p class="lede" id="band-text"></p>
          <div class="hero-actions" id="band-actions"></div>
        </div>

        <div class="card" id="tips-card">
          <h3>What to fix first</h3>
          <ul class="tips" id="tips"></ul>
        </div>

        <div class="card">
          <h3>Check it yourself, step by step</h3>
          <p class="muted">A free 2-page guide with simple ways to test each of these questions on your own site, and what to fix first.</p>
          <a class="btn btn-ghost" href="/downloads/website-check-guide.pdf" download>Download the free guide (PDF)</a>
        </div>

        <div class="card offer-card">
          <p class="eyebrow">Ready for the full picture?</p>
          <h3>Website Diagnostic</h3>
          <p class="price">$199</p>
          <p class="muted">This check shows where to look. The Diagnostic shows exactly what to fix: I review your site on a phone and a computer, run it through Google's own tools, and send a plain-English report with your fixes in order within 5 business days. Credited toward a new website with me.</p>
          <div class="hero-actions">
            <a class="btn" href="/websites/diagnostic/">Get the Diagnostic</a>
          </div>
        </div>

        <div class="card">
          <h3>Send me your results</h3>
          <p class="muted">I'll take a look and reply personally with what I'd do first. Free and optional.</p>
          <form action="https://api.web3forms.com/submit" method="POST" class="inquiry" id="send">
            <input type="hidden" name="access_key" value={site.web3formsKey} />
            <input type="hidden" name="subject" value="New website check from auvastudio.com" />
            <input type="hidden" name="from_name" value="Auva Studio website" />
            <input type="hidden" name="score" />
            <input type="hidden" name="answers" />
            <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="form-row">
              <label>Name<input name="name" autocomplete="name" required /></label>
              <label>Email<input type="email" name="email" autocomplete="email" required /></label>
            </div>
            <label><span>Website <span class="opt">(optional)</span></span><input name="website" placeholder="yourbusiness.com" autocomplete="url" /></label>
            <label class="opt-in"><input type="checkbox" name="wants_diagnostic" value="Yes, send a payment link for the $199 Website Diagnostic" /><span>I'd like the $199 Website Diagnostic. Send me a payment link.</span></label>
            <button class="btn" type="submit">Send my results</button>
            <p class="form-status" role="status" aria-live="polite"></p>
          </form>
        </div>

        <p class="small muted"><a href="#check" id="retake">Change my answers</a></p>
      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ questions, booking: site.booking }}>
  const form = document.getElementById('check');
  const progress = document.getElementById('progress');
  const results = document.getElementById('results');
  const total = questions.length;
  const answered = () => questions.filter((_, i) => form.querySelector(`input[name="q${i}"]:checked`)).length;
  form.addEventListener('change', () => { progress.textContent = `${answered()} of ${total} answered`; });

  const bands = [
    { min: 16, title: 'Your site is in <em>good shape.</em>', text: "A few small fixes could help. Book a free 30-minute call if you'd like a second opinion.", actions: [['Book a free call about my results', booking, true]] },
    { min: 9, title: 'A few fixes would make <em>a real difference.</em>', text: "A $199 Website Diagnostic shows exactly what to fix first, and it's credited toward your new website with me.", actions: [['Get the Diagnostic, $199', '/websites/diagnostic/'], ['Book a free call about my results', booking, true]] },
    { min: 0, title: 'Your site may be <em>costing you customers.</em>', text: 'Start with a $199 Website Diagnostic, or see website packages from $1,500.', actions: [['Get the Diagnostic, $199', '/websites/diagnostic/'], ['See website packages', '/websites/#packages']] },
  ];
  const labels = { 2: 'Yes', 1: 'Not sure', 0: 'No' };
  // Calls booked from the results carry the score, so the booking says what the call is for.
  // a1 fills the first question on the Calendly booking form; the utm tags show in the booking details.
  const callUrl = (note) => `${booking}?a1=${encodeURIComponent(note)}&utm_source=auvastudio&utm_campaign=website-check`;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const missing = questions.findIndex((_, i) => !form.querySelector(`input[name="q${i}"]:checked`));
    if (missing !== -1) {
      progress.textContent = `Please answer question ${missing + 1} to see your score.`;
      form.querySelector(`input[name="q${missing}"]`).focus();
      return;
    }
    const values = questions.map((_, i) => Number(form.querySelector(`input[name="q${i}"]:checked`).value));
    const score = values.reduce((a, b) => a + b, 0);
    const band = bands.find((b) => score >= b.min);
    document.getElementById('score').textContent = score;
    document.getElementById('band-title').innerHTML = band.title;
    document.getElementById('band-text').textContent = band.text;
    const actions = document.getElementById('band-actions');
    actions.innerHTML = '';
    band.actions.forEach(([label, href, external], i) => {
      const a = document.createElement('a');
      a.className = i === 0 ? 'btn' : 'btn btn-ghost';
      a.href = href === booking ? callUrl(`Free website check: I scored ${score}/20 and want to talk through my results.`) : href;
      a.textContent = label;
      if (external) { a.target = '_blank'; a.rel = 'noopener'; }
      actions.append(a);
    });
    const tips = document.getElementById('tips');
    tips.innerHTML = '';
    values.forEach((v, i) => {
      if (v === 2) return;
      const li = document.createElement('li');
      li.innerHTML = '<b></b><span></span>';
      li.querySelector('b').textContent = questions[i].q;
      li.querySelector('span').textContent = questions[i].tip;
      tips.append(li);
    });
    document.getElementById('tips-card').hidden = !tips.children.length;
    const send = document.getElementById('send');
    send.score.value = `${score}/20`;
    send.answers.value = questions.map((q, i) => `${i + 1}. ${q.q} ${labels[values[i]]}`).join('\n');
    results.hidden = false;
    // Show the result cards at once instead of waiting for the scroll fade-in.
    results.querySelectorAll('.card').forEach((c) => c.classList.add('is-in'));
    results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    results.focus({ preventScroll: true });
  });

  document.getElementById('retake').addEventListener('click', () => { results.hidden = true; });

  const send = document.getElementById('send');
  const status = send.querySelector('.form-status');
  send.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!send.reportValidity()) return;
    const btn = send.querySelector('button[type="submit"]');
    btn.disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await (await fetch(send.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(send) })).json();
      if (!res.success) throw new Error(res.message);
      window.auvaConvert?.('form');
      status.textContent = send.wants_diagnostic.checked ? "Thanks! I'll confirm your details and send your payment link within 24–48 hours." : "Thanks! I'll look at your results and reply within 24–48 hours.";
      btn.hidden = true;
    } catch {
      status.textContent = 'Something went wrong. Please email me instead.';
    } finally {
      btn.disabled = false;
    }
  });
</script>
