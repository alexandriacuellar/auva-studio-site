---
import Base from '../../layouts/Base.astro';
import '../../styles/pages/contact.css';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { site } from '../../data/site.es';

const faqs = [
  { q: '¿Qué pasa en la llamada gratis de 30 minutos?', a: 'Hablamos de lo que está haciendo, de lo que le estorba y de cómo se vería un buen resultado. Usted se queda con un siguiente paso sugerido, sin compromiso.' },
  { q: '¿Con quién trabaja?', a: 'Con pequeños negocios, startups, organizaciones sin fines de lucro y equipos en crecimiento, además de estudios creativos, de XR y de videojuegos.' },
  { q: '¿Trabaja a distancia?', a: 'Sí. La mayor parte del trabajo es a distancia, con clientes en todo Estados Unidos. Trabajo en persona desde la ciudad de Nueva York y Westchester hasta Albany, con gastos de viaje para visitas fuera del Mid-Hudson Valley.' },
  { q: '¿Cuánto cuesta empezar?', a: 'La primera llamada es gratis. Las sesiones de consultoría cuestan $65 por hora. Los trabajos de precio fijo incluyen un Diagnóstico Web de $199, la configuración de su Perfil de Negocio de Google por $500, un Taller de IA para Equipos desde $500, una Evaluación Tecnológica o un Plan de Preparación para IA de $650, y sitios web desde $1,500. Nada empieza hasta que usted aprueba un alcance y un precio por escrito.' },
];
---
<Base title="Contacto" description="Empiece un proyecto de sitio web, reciba consultoría o apoyo en proyectos, o explore la IA y la Tecnología Emergente con Auva Studio.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <p class="bd-pill">Contacto</p>
      <h1 class="mag-head">Hablemos de <em>lo que está haciendo.</em></h1>
      <p class="lede">Reserve una llamada gratis de 30 minutos, o envíe un mensaje y le respondo en 24–48 horas. No necesita un plan detallado.</p>
      <nav class="bd-sublinks" aria-label="Formas de contactarme">
        <a href={site.booking} target="_blank" rel="noopener">Reserve una llamada gratis de 30 minutos</a>
        <a href="#start">Envíe un mensaje</a>
      </nav>
    </div>
  </section>

  <InquiryForm kind="general" alt />

  <section id="explore">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">¿Prefiere <em>ver más detalles primero?</em></h2>
      </div>
      <div class="grid grid-3 routes">
        <a class="card card-row" href="/es/websites/">
          <div class="icon"><Icon name="globe" /></div>
          <div>
            <h3>Necesito un sitio web</h3>
            <p class="muted small">Un sitio nuevo, mejoras al actual, un Diagnóstico, la configuración de su Perfil de Negocio de Google o ayuda después del lanzamiento.</p>
            <span class="more">Ver servicios de sitios web <Icon name="arrow" size={16} /></span>
          </div>
        </a>
        <a class="card card-row" href="/es/technology-consulting/">
          <div class="icon"><Icon name="compass" /></div>
          <div>
            <h3>Necesito consultoría o apoyo en un proyecto</h3>
            <p class="muted small">Planificación tecnológica, análisis de negocio o gestión de proyectos.</p>
            <span class="more">Ver consultoría <Icon name="arrow" size={16} /></span>
          </div>
        </a>
        <a class="card card-row" href="/es/ai-emerging-tech/">
          <div class="icon"><Icon name="bolt" /></div>
          <div>
            <h3>Quiero explorar la IA y la Tecnología Emergente</h3>
            <p class="muted small">Preparación para IA, talleres para equipos, revisiones de viabilidad, prototipos o apoyo de producción para XR y videojuegos.</p>
            <span class="more">Ver IA y Tecnología Emergente <Icon name="arrow" size={16} /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <Faq alt faqs={faqs} lede="No necesita un plan detallado para escribirme. Empiece por lo que quiere mejorar, resolver o crear." />

  <section class="nr-sec">
    <div class="wrap">
      <div class="not-ready">
        <h2 class="mag-head">Vea primero lo que <em>necesita su sitio web.</em></h2>
        <p class="lede">Un Diagnóstico Web de $199 revisa cómo funciona su sitio en el celular, qué tan fácil le encuentran en Google y qué tan rápido carga, y le dice qué arreglar primero. Se abona a su sitio web nuevo conmigo.</p>
        <div class="hero-actions">
          <a class="btn" href="/es/websites/diagnostic/">Vea lo que reviso</a>
          <a class="btn btn-ghost" href="/es/website-check/">Haga la revisión gratis de su sitio</a>
        </div>
      </div>
    </div>
  </section>
</Base>
