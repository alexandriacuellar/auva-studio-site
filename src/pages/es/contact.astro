---
import Base from '../../layouts/Base.astro';
import '../../styles/pages/contact.css';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { site } from '../../data/site.es';

const faqs = [
  { q: '¿Qué pasa en la llamada gratis de 30 minutos?', a: 'Hablamos de lo que está haciendo, de lo que le estorba y de cómo se vería un buen resultado. Usted se queda con un siguiente paso sugerido, sin compromiso.' },
  { q: "¿Cuánto cuesta empezar?", a: "La primera llamada es gratis. Los precios fijos empiezan en $199 por un Diagnóstico Web y $250 por una Revisión Tecnológica, y nada empieza hasta que usted apruebe un alcance y un precio por escrito." },
];
---
<Base title="Contacto" seoTitle="Contacte a Alexandria Cuellar | Auva Studio" description="Reserve una llamada gratis de 30 minutos o escríbame sobre un sitio web, IA y automatización, o un proyecto de videojuego, XR o AR. Respondo en 24 a 48 horas.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Hablemos de <em>lo que está haciendo.</em></h1>
      <p class="lede">Reserve una llamada gratis de 30 minutos, o envíe un mensaje y le respondo en 24–48 horas. No necesita un plan detallado.</p>
    </div>
  </section>

  <InquiryForm kind="general" alt />

  <section id="explore">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">¿Prefiere <em>ver más detalles primero?</em></h2>
      </div>
      <div class="grid grid-3 routes">
        <a class="card card-row" href="/es/websites/">
          <div class="icon"><Icon name="globe" /></div>
          <div>
            <h3>Necesito un sitio web</h3>
            <p class="muted small">Un sitio nuevo, mejoras al actual, un Diagnóstico, la configuración de su Perfil de Negocio de Google o ayuda después del lanzamiento.</p>
            <span class="more">Ver servicios de sitios web <Icon name="arrow" size={16} /></span>
          </div>
        </a>
        <a class="card card-row" href="/es/technology-consulting/">
          <div class="icon"><Icon name="compass" /></div>
          <div>
            <h3>Necesito ayuda con herramientas, automatización, IA o un proyecto</h3>
            <p class="muted small">Una Revisión Tecnológica, automatizaciones, configuración de espacios de proyectos, talleres de IA o gestión de proyectos.</p>
            <span class="more">Ver Tecnología, Automatización e IA <Icon name="arrow" size={16} /></span>
          </div>
        </a>
        <a class="card card-row" href="/es/production-emerging-tech/">
          <div class="icon"><Icon name="bolt" /></div>
          <div>
            <h3>Tengo un proyecto de videojuego, XR o AR</h3>
            <p class="muted small">Apoyo de producción, una Revisión del Plan de Producción o un proyecto pequeño de AR.</p>
            <span class="more">Ver Producción y Tecnología Emergente <Icon name="arrow" size={16} /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <Faq alt faqs={faqs} lede="No necesita un plan detallado para escribirme. Empiece por lo que quiere mejorar, resolver o crear." />

</Base>
