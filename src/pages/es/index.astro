---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import '../../styles/pages/home.css';
import Icon from '../../components/Icon.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import Cta from '../../components/Cta.astro';
import { categories, site, testimonials } from '../../data/site.es';
const featured = testimonials.find((t) => t.name === 'Matthew Udy');
import headshot from '../../assets/alexandria-cuellar.jpg';

const columns = [
  {
    icon: 'globe', name: 'Sitios web', href: '/es/websites/',
    items: [
      { title: 'Necesito un sitio web', text: 'Está empezando algo nuevo, o nunca ha tenido uno.', href: '/es/websites/', to: 'Paquetes de sitios web' },
      { title: 'Mi sitio web no me está funcionando', text: 'Está desactualizado, es lento o cuesta actualizarlo.', href: '/es/websites/diagnostic/', to: 'Diagnóstico Web' },
      { title: 'Mis clientes no me encuentran en Google Maps', text: 'Su perfil no aparece, está desactualizado o queda escondido.', href: '/es/websites/google-business-profile/', to: 'Perfil de Negocio de Google' },
    ],
  },
  {
    icon: 'bulb', name: 'Automatización, IA y Proyectos', href: '/es/automation-ai-projects/',
    items: [
      { title: 'Hacemos las mismas tareas a mano cada semana', text: 'Seguimientos, captura de datos e informes que podrían hacerse solos.', href: '/es/automation-ai-projects/automation/', to: 'Automatización' },
      { title: 'Quiero usar la IA, pero no sé por dónde empezar', text: 'Ni qué es seguro compartir con ella.', href: '/es/automation-ai-projects/ai/', to: 'IA para usted y su equipo' },
      { title: 'Este proyecto necesita quien lo dirija', text: 'Alcance, calendario, proveedores y equipo, en orden.', href: '/es/automation-ai-projects/project-management/', to: 'Gestión de proyectos' },
    ],
  },
  {
    icon: 'bolt', name: 'AR, VR y Producción', href: '/es/ar-vr-production/',
    items: [
      { title: 'Quiero que mis clientes vean mi producto antes de comprarlo', text: 'Su producto en 3D, en su sala, directo desde el celular. Sin descargar ninguna aplicación.', href: '/es/ar-vr-production/ar/#ar-product', to: 'Paquetes de AR' },
      { title: 'Quiero que mi menú, empaque o volante haga más', text: 'Lo escanean y cobra vida, con botones para pedir o reservar.', href: '/es/ar-vr-production/ar/#ar-menu', to: 'Paquetes de AR' },
      { title: 'Estamos creando un videojuego o un proyecto XR', text: 'Una productora con experiencia que mantiene en orden el alcance, el calendario y el equipo.', href: '/es/ar-vr-production/studios/', to: 'Producción de videojuegos y XR' },
    ],
  },
];
const strip = ['Precios publicados', 'Presupuesto por escrito antes de empezar', 'Todo es suyo', 'Trabaja directamente conmigo'];
---
<Base>
  <section class="hero bd-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Que la tecnología <em>trabaje para su negocio.</em></h1>
      <p class="lede">Sitios web, automatización, IA y gestión de proyectos para pequeños negocios en el Hudson Valley, además de producción de AR, VR y videojuegos.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Reserve una llamada gratis de 30 minutos <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="#services">Cómo le ayudo</a>
      </div>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Tres formas <em>de ayudarle.</em></h2>
        <p class="lede">Empiece con una conversación o una revisión enfocada. Le recomiendo solo lo que necesita y luego le ayudo a ponerlo en marcha.</p>
      </div>
      <ServiceCards categories={categories} lang="es" />
      <p class="hero-checks" style="text-align: center; margin-top: 64px">¿Todavía no quiere hablar? Haga una revisión gratis de 2 minutos: <a href="/es/website-check/">su sitio web</a> o <a href="/es/google-profile-check/">su perfil de Google</a>.</p>
    </div>
  </section>

  <section class="home-routes">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">¿No sabe por dónde empezar? <em>Encuentre su situación.</em></h2>
        <p class="lede">Elija la que más se parezca a la suya.</p>
      </div>
      <div class="sit-board">
        {columns.map((c) => (
          <div class="sit-col">
            <a class="sit-col-head" href={c.href}><Icon name={c.icon} size={20} /> {c.name}</a>
            <ul>
              {c.items.map((x) => (
                <li><a class="sit-card" href={x.href}>
                  <b>{x.title}</b>
                  <span class="muted">{x.text}</span>
                  <span class="sit-to">{x.to} <Icon name="arrow" size={16} /></span>
                </a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="sit-else"><b>¿Otra cosa?</b> ¿No sabe qué necesita? <a href={site.booking} target="_blank" rel="noopener">Reserve una llamada gratis de 30 minutos</a> o <a href="/es/contact/">cuénteme qué está pasando</a>.</p>
    </div>
  </section>

  <section class="home-about-band" id="about">
    <div class="wrap home-about">
      <Image class="home-about-photo" src={headshot} alt="Alexandria Cuellar" width={200} height={200} densities={[1, 2]} />
      <div class="home-about-text">
        <h2 class="mag-head">Orientación tecnológica práctica, <em>pensada para las personas.</em></h2>
        <p class="lede">Hola, soy Alexandria, fundadora de Auva Studio. Pongo más de 20 años en desarrollo web y gestión de proyectos al servicio de pequeños negocios, startups, organizaciones sin fines de lucro y equipos en crecimiento. También tengo un certificado en realidad mixta (XR) y uso IA en mi trabajo todos los días.</p>
        <figure class="quote home-about-quote" lang="en">
        <blockquote>“{featured.quote}”</blockquote>
        <figcaption><b>{featured.name}</b><span class="muted">{featured.role}</span></figcaption>
      </figure>
        <div class="home-about-actions">
          <a class="btn btn-ghost" href="/es/about/">Más sobre mí <Icon name="arrow" size={18} /></a>
          <a class="founder-link" href="https://www.linkedin.com/company/auva-studio/" target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> Siga a Auva Studio en LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <Cta promises={strip} />
</Base>
