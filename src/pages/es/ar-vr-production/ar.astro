---
// AR Packages sub page. Packages come from aiOffers group 'ar' in site.es.ts.
import Base from '../../../layouts/Base.astro';
import '../../../styles/pages/production-emerging-tech.css';
import Icon from '../../../components/Icon.astro';
import InquiryForm from '../../../components/InquiryForm.astro';
import { Image } from 'astro:assets';
import demoRoom from '../../../assets/ar/demo-room.jpg';
import demoCard from '../../../assets/ar/demo-card.jpg';
import demoHouse from '../../../assets/ar/demo-house.jpg';
import demoLabel from '../../../assets/ar/demo-label.jpg';
import Faq from '../../../components/Faq.astro';
import { site, aiOffers, serviceSchema } from '../../../data/site.es';
import { t, ideas, demos, faq } from '../../../data/production.es';

const packages = aiOffers.filter((o) => o.group === 'ar');
const images = { room: demoRoom, card: demoCard, house: demoHouse, label: demoLabel };
const bgs = { room: "#ede9e1", card: "#0f1d52", house: "#e6e8e1", label: "#281e1d" };
const alts = { label: 'Una lata de sidra Hollow Night con el Jinete sin Cabeza galopando junto a ella', house: 'Un modelo de una casa de campo moderna sobre el césped con árboles', room: 'Un maniquí de costura, una lámpara de mesa y un tarro de miel en 3D', card: 'La tarjeta de presentación de Alexandria Cuellar de Auva Studio' };
const demoItems = demos.map((d) => {
  const o = aiOffers.find((x) => x.id === d.pkg)!;
  return { ...d, pkgTitle: o.title, price: o.price, image: images[d.img as keyof typeof images], bg: bgs[d.img as keyof typeof bgs], alt: alts[d.img as keyof typeof alts] };
});
const demoFor = (id: string) => demos.find((d) => d.pkg === id);
const faqs = [faq.app, faq.models, faq.bigger, faq.founding];
const schema = serviceSchema(packages.map((o) => ({ name: o.title, description: o.text, price: o.price })), '/es/ar-vr-production/ar/');
---
<Base title={t.arTitle} seoTitle={t.arSeo} schema={schema} description={t.arDesc}>
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head" set:html={t.arH} />
      <p class="lede">{t.arL}</p>
      <div class="hero-actions">
        <a class="btn" href="#start">Contácteme</a>
        <a class="btn btn-ghost" href="#demos">{t.seeDemos} <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="alt" id="packages">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head" set:html={t.pkH} />
        <p class="lede">{t.pkL}</p>
      </div>
      <div class="grid grid-2">
        {packages.map((p) => (
          <div class="card offer" id={p.id}>
            <div class="icon"><Icon name={p.icon} size={32} /></div>
            <h3>{p.title}</h3>
            <p class="svc-meta"><b>{p.price}</b></p>
            <p class="muted">{p.text}</p>
            <ul class="ticks">{p.items!.map((i) => <li><Icon name="tick" size={18} />{i}</li>)}</ul>
            {demoFor(p.id) && <a class="more" href={demoFor(p.id)!.href} hreflang="en" style="margin-top: 12px">{t.demoLink} <Icon name="arrow" size={16} /></a>}
            <a class="more" href={`?topic=${p.id}#start`} style="margin-top: 12px">{t.ask} <Icon name="arrow" size={16} /></a>
          </div>
        ))}
      </div>
      <div class="card card-row bigger" style="margin-top: 32px">
        <div class="icon"><Icon name="bolt" size={36} /></div>
        <div>
          <h3>{t.bigH}</h3>
          <p class="muted">{t.bigP}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="demos">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head" set:html={t.demosH} />
        <p class="lede">{t.demosL}</p>
      </div>
      <div class="demo-list">
        {demoItems.map((d) => (
          <article class="card demo">
            <Image class="demo-img" style={`background: ${d.bg}`} src={d.image} alt={d.alt} widths={[400, 800]} sizes="(min-width: 760px) 360px, 100vw" />
            <div class="demo-body">
              <p class="demo-meta"><b>{d.pkgTitle}</b> · {d.price}</p>
              <h3>{d.name}</h3>
              <p class="muted">{d.text}</p>
              <p class="small muted">{d.goodFor}</p>
              <p class="small demo-works"><Icon name="tick" size={16} /> {t.demoWorks} {d.works}</p>
              <a class="btn" href={d.href} hreflang="en">{t.demoTry} <Icon name="arrow" size={18} /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="alt" id="ideas">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head" set:html={t.ideasH} />
        <p class="lede">{t.ideasL}</p>
      </div>
      <div class="grid grid-2">
        {ideas.map((i) => (
          <div class="card idea">
            <div class="icon"><Icon name={i.icon} size={32} /></div>
            <span class="idea-tag idea-tag-plain">{i.partner ? t.ideaPartner : t.idea}</span>
            <h3>{i.title}</h3>
            <p class="muted">{i.text}</p>
          </div>
        ))}
      </div>
      <p class="muted" style="margin-top: 32px" set:html={t.website} />
    </div>
  </section>

  <Faq faqs={faqs} />
  <InquiryForm kind="ai" topic="ar-card" alt />
</Base>
