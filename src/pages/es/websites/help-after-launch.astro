---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import InquiryForm from '../../../components/InquiryForm.astro';
import Faq from '../../../components/Faq.astro';
import { care, plans, monthly, serviceSchema, site } from '../../../data/site.es';

const atLaunch = [
  { icon: 'chat', title: 'Un recorrido', text: 'Le muestro su sitio nuevo y respondo sus preguntas.' },
  { icon: 'book', title: 'Una guía práctica', text: 'Pasos sencillos para lo que quiera hacer por su cuenta.' },
  { icon: 'wrench', title: '30 días de arreglos y pequeños ajustes', text: 'Todo lo que haya que ajustar durante el primer mes, sin costo adicional.' },
  { icon: 'key', title: 'Todo a su nombre', text: 'Su dominio, su hosting y sus cuentas, para que nunca dependa de mí para entrar.' },
];

// Cuatro formas de recibir ayuda después del lanzamiento, como las tarjetas de paquetes.
const paths = [
  { tag: 'De vez en cuando', name: 'Pague por cambio', price: '$59', unit: 'por cambio', blurb: 'Envíeme lo que quiere cambiar y yo me encargo.', items: ['Hasta unos 30 minutos de ediciones por cambio, enviadas juntas en una sola solicitud', 'Listo en 2 días hábiles', 'Compre 5 cambios por adelantado por $249 y ahorre $46', 'Páginas y funciones nuevas a $125/hora, con presupuesto previo.', 'Sin compromiso. Pague solo cuando necesite algo.'], cta: 'Enviar un cambio', href: '#start' },
  { tag: 'Un poco cada mes', name: plans[0].name, price: '$99', unit: 'al mes', blurb: 'Para sitios con algunos cambios pequeños casi todos los meses.', items: ['1 hora de cambios al mes, unos 2 cambios', 'Una revisión mensual de que sus formularios, enlaces y botones funcionan', 'Listo en 2 días hábiles', 'El tiempo que no use pasa al mes siguiente', 'Mínimo de 3 meses; después, aviso de 30 días para terminar'], cta: 'Empezar cambios mensuales', href: '#start' },
  { tag: 'Más cada mes', name: plans[1].name, price: '$179', unit: 'al mes', blurb: 'Para sitios con muchos cambios cada mes.', items: ['2 horas al mes para cambios, ajustes en su CMS o una página nueva sencilla con uno de sus diseños de página actuales', 'La misma revisión mensual', 'Una revisión de búsqueda cada 3 meses, con lo que conviene arreglar', 'Listo en 1 día hábil', 'Mínimo de 3 meses; después, aviso de 30 días para terminar'], cta: 'Empezar cambios mensuales plus', href: '#start' },
  { tag: 'Cada mes', name: 'Retainer mensual para su sitio web', price: 'Desde $650', unit: 'al mes por 5 horas', blurb: monthly.text, items: [...monthly.outcomes, 'Ayuda el mismo día con problemas urgentes', 'Mínimo de 3 meses; después, aviso de 30 días para terminar'], cta: 'Hablemos de lo que necesita', href: site.booking, featured: true },
];

const faqs = [
  { q: "¿Qué cuenta como un cambio?", a: "Hasta unos 30 minutos de ediciones, enviadas juntas en una sola solicitud, como un horario nuevo, algunas fotos nuevas y un error de escritura. Si una solicitud va a tomar más, se lo digo antes." },
  { q: "¿Necesito un plan mensual?", a: "No. La mayoría de los sitios que construyo no tienen plugins que mantener al día, así que puede pagar solo cuando quiere un cambio. Si cambia cosas casi todos los meses, un plan es más sencillo, y puede empezarlo, cambiarlo o dejarlo cuando quiera después de los primeros 3 meses." },
  { q: "¿Puede ayudar con un sitio que usted no hizo?", a: "Los cambios sin plan mensual son para sitios que yo construyo. Para un sitio hecho por otra persona, empezamos con un Diagnóstico Web, y luego puede convenir un plan mensual o un cambio puntual pequeño." },
  { q: "¿Cuánto cuesta mantener mi sitio funcionando?", a: "Su dominio cuesta unos $20 al año, y el hosting es gratis o de bajo costo para la mayoría de los sitios que construyo, a su nombre. Si su sitio necesita una plataforma con cuota mensual, se lo digo antes de empezar." },
];

const schema = serviceSchema([
  ...care.map((c) => ({ name: `Ayuda después del lanzamiento: ${c.name}`, description: c.text, price: c.price })),
  ...plans.map((p) => ({ name: `Ayuda después del lanzamiento: ${p.name}`, description: p.text, price: p.price })),
  { name: `Ayuda después del lanzamiento: ${monthly.name}`, description: monthly.text, price: monthly.price },
  { name: 'CMS (sistema de gestión de contenidos)', description: 'Un panel sencillo para actualizar por su cuenta los textos, las fotos y colecciones como noticias o eventos, sin programar.', price: 'Desde $1,750' },
], '/es/websites/help-after-launch/');
---
<Base title="Ayuda después del lanzamiento" seoTitle="Cambios en su sitio web y ayuda después del lanzamiento, $59 por cambio | Auva Studio" schema={schema} description="Cambios en su sitio web cuando los necesite: $59 por cambio, planes mensuales desde $99, retainer mensual desde $650, o un CMS para hacerlos usted.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Ayuda cuando la necesite, <em>o cada mes.</em></h1>
      <p class="lede">Mantenga su sitio al día sin pagar por un mantenimiento que no necesita. Envíeme un cambio cuando haya algo nuevo, actualícelo usted, o cuente conmigo con un retainer mensual para mejorar su sitio cada mes.</p>
      <div class="hero-actions">
        <a class="btn" href={site.booking} target="_blank" rel="noopener">Reserve una llamada gratis de 30 minutos</a>
        <a class="btn btn-ghost" href="/es/websites/#packages">Ver paquetes de sitios web <Icon name="arrow" size={18} /></a>
      </div>
      <p class="hero-note">Los cambios cuestan $59 cada uno, o elija un plan mensual desde $99. Empiece cuando quiera, al lanzar o más adelante.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Incluido con cada sitio web.</h2>
      </div>
      <div class="grid grid-4 plain-grid">
        {atLaunch.map((a) => (
          <div>
            <div class="icon"><Icon name={a.icon} size={28} /></div>
            <h3>{a.title}</h3>
            <p class="muted">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt" id="care">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Después del lanzamiento, <em>cuatro formas de recibir ayuda.</em></h2>
        <p class="lede">Sin tarifa mensual, a menos que usted la quiera. Elija lo que mejor se adapte a la frecuencia con que cambia su sitio, y empiece o cambie de plan cuando quiera.</p>
      </div>
      <div class="grid grid-4 packages">
        {paths.map((p) => (
          <article id={p.featured ? 'monthly' : undefined} class:list={['card', 'package', { featured: p.featured }]}>
            <span class="tag">{p.tag}</span>
            <h3>{p.name}</h3>
            <p class="muted">{p.blurb}</p>
            <p class="price">{p.price} <span class="price-unit">{p.unit}</span></p>
            <ul class="ticks">{p.items.map((i) => <li><Icon name="tick" size={18} />{i}</li>)}</ul>
            <a class:list={['btn', { 'btn-ghost': !p.featured }]} href={p.href} {...(p.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{p.cta}</a>
          </article>
        ))}
      </div>
      <p class="fine"><b>¿Quiere agregar varias páginas o funciones nuevas?</b> Si su sitio tiene Presencia Esencial o Presencia Ampliada, <a href="/es/websites/#packages">pasar al siguiente paquete</a> y pagar solo la diferencia suele costar menos. Las horas mensuales son un solo saldo flexible para cualquier cosa de la lista, y las horas que no use pasan al mes siguiente. Las tarifas de terceros, como plataformas o aplicaciones, se pagan aparte. Mantengo su sitio rápido, seguro y fácil de leer para Google, y le mostraré lo que está funcionando.</p>
    </div>
  </section>

  <section id="cms">
    <div class="wrap">
      <div class="card" style="display:grid;gap:12px">
        <h2 class="mag-head">¿Prefiere <em>actualizarlo usted?</em></h2>
        <p class="muted">Un CMS (sistema de gestión de contenidos) es un panel sencillo donde usted actualiza sus textos, fotos, noticias y eventos. No necesita programar. <b style="color: var(--primary)">Desde $1,750</b>, pago único, con capacitación, una guía para editar y 30 días de apoyo. Hasta 2 colecciones, como noticias o eventos. Incluido en Presencia Completa.</p>
        <p><a class="btn btn-ghost" href="#start">Preguntar por un CMS</a></p>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} />
  <InquiryForm kind="website" topic="care" alt />
</Base>
