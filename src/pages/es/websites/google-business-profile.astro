---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import InquiryForm from '../../../components/InquiryForm.astro';
import Faq from '../../../components/Faq.astro';
import PayBar from '../../../components/PayBar.astro';
import { serviceSchema } from '../../../data/site.es';

const offers = [
  { icon: 'star', name: 'Configuración', cta: 'Configurarlo', price: '$500', who: 'Para un negocio que todavía no tiene perfil, o que no puede entrar al que tiene.', items: ['Crear o reclamar su perfil', 'El nombre de su negocio, dirección o zona de servicio, teléfono y enlace a su sitio web', 'Categorías, servicios y horario', 'Sus fotos', 'Ayuda con la verificación de Google'] },
  { icon: 'wrench', name: 'Optimización', cta: 'Optimizarlo', price: '$500', who: 'Para un perfil que ya tiene y que podría rendir más.', items: ['Una revisión de todo su perfil', 'Mejores categorías y descripción', 'Servicios, atributos y horario revisados', 'Fotos y enlaces a su sitio web mejorados', 'Arreglos para todo lo que no cumpla las reglas de Google'] },
];

const guide = [
  { icon: 'book', title: 'Lo que configuré', text: 'Un registro de sus categorías, servicios y datos, para que sepa qué hay y por qué.' },
  { icon: 'clock', title: 'Una lista mensual de 15 minutos', text: 'Reseñas, fotos, horario y ediciones sugeridas, todo en una rutina breve.' },
  { icon: 'chat', title: 'Cómo responder reseñas', text: 'Consejos sencillos y respuestas de ejemplo para reseñas buenas y malas.' },
  { icon: 'shield', title: 'Cómo protegerse', text: 'Cómo detectar llamadas fraudulentas y ediciones equivocadas, y quién tiene acceso a su perfil.' },
];

const notIncluded = ['Gestión mensual del perfil', 'Responder reseñas por usted', 'Campañas de Google Ads', 'Publicaciones periódicas en su perfil', 'Campañas en directorios y listados', 'Promesas de posiciones o de clientes'];

const faqs = [
  { q: '¿Qué es un Perfil de Empresa en Google?', a: 'Es la ficha gratuita que la gente ve en Google Maps y en la búsqueda de Google cuando busca su negocio o lo que usted ofrece cerca. Muestra su horario, su teléfono, sus reseñas, sus fotos y un enlace a su sitio web. Antes se llamaba Google My Business, y en inglés se llama Google Business Profile.' },
  { q: '¿Cuál necesito, configuración u optimización?', a: 'Si todavía no tiene perfil, o no puede entrar al que existe, necesita la configuración. Si tiene un perfil que puede editar, la optimización lo hace rendir más. ¿Aún tiene dudas? Haga la revisión gratis de su perfil de Google, o pregúnteme.' },
  { q: '¿Cuándo pago?', a: 'Por adelantado. Después de que envíe el formulario, confirmo qué opción le conviene y le envío un enlace de pago. Empiezo cuando está pagado.' },
  { q: '¿Necesito un sitio web primero?', a: 'No. Un perfil funciona por sí solo. Un sitio web le da a Google y a sus clientes más información, y si empieza uno conmigo al mismo tiempo o en los siguientes 6 meses, se le abonan $150.' },
  { q: '¿De quién es mi perfil?', a: 'Suyo. Se queda en su cuenta de Google. Si necesito acceso, usted me agrega como administradora y me quita cuando termine el trabajo.' },
  { q: '¿Cuánto tarda la verificación?', a: 'Google decide cómo verificar cada negocio, por video, teléfono, correo electrónico o tarjeta postal, y cuánto tarda. Le acompaño en cada paso para que nada se atasque de su lado.' },
  { q: '¿Esto forma parte del paquete Presencia Esencial?', a: 'Presencia Esencial incluye orientación sobre su Perfil de Empresa en Google, cuando aplique: reviso su enlace y le doy consejos básicos. La configuración y la optimización son el servicio completo, de manos a la obra.' },
  { q: '¿Me puede garantizar que salga primero en Google Maps?', a: 'Nadie se lo puede garantizar con honestidad. Google decide las posiciones según cosas como la distancia, la relevancia y las reseñas. Me aseguro de que su perfil esté completo, correcto y cumpla las reglas de Google, lo que le da la mejor oportunidad.' },
];

const schema = serviceSchema([
  { name: 'Configuración del Perfil de Empresa en Google', description: 'Crear o reclamar un Perfil de Empresa en Google y configurar los datos del negocio, categorías, servicios, horario, fotos y verificación.', price: '$500' },
  { name: 'Optimización del Perfil de Empresa en Google', description: 'Revisar un Perfil de Empresa en Google existente y mejorar sus categorías, descripción, servicios, atributos, fotos y enlaces al sitio web.', price: '$500' },
], '/es/websites/google-business-profile/');
---
<Base title="Configuración y optimización del Perfil de Empresa en Google" seoTitle="Configuración del Perfil de Empresa en Google, $500 | Auva Studio" schema={schema} description="Configuración u optimización de su Perfil de Empresa en Google (Google Business Profile) para pequeños negocios del Hudson Valley y más allá. Pago único de $500, con una guía para mantenerlo al día por su cuenta.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <a class="bd-pill" href="/es/websites/">Servicios de sitios web</a>
      <h1 class="mag-head">Aparezca <em>en Google Maps.</em></h1>
      <p class="lede">Su Perfil de Empresa en Google muchas veces es lo primero que ve la gente cuando le busca. Configuro uno nuevo o arreglo el que tiene, para que los clientes adecuados le encuentren y le llamen.</p>
      <div class="hero-actions">
        <a class="btn" href="#start">Empezar, $500</a>
        <a class="btn btn-ghost" href="/es/google-profile-check/">¿Aún tiene dudas? Haga la revisión gratis <Icon name="arrow" size={18} /></a>
      </div>
      <p class="hero-note">Pago único, sin plan mensual. Pague con un enlace seguro una vez que yo confirme qué opción le conviene. Su perfil sigue a su nombre.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Dos formas de ayudarle.</h2>
        <p class="lede">Para negocios del Hudson Valley y cualquiera con clientes locales. Las dos son de pago único, sin plan mensual.</p>
      </div>
      <div class="grid grid-2">
        {offers.map((o) => (
          <div class="card">
            <div class="icon"><Icon name={o.icon} size={32} /></div>
            <h3>{o.name}</h3>
            <p class="price">{o.price}</p>
            <p class="muted">{o.who}</p>
            <ul class="ticks">{o.items.map((i) => <li><Icon name="tick" size={18} />{i}</li>)}</ul>
            <a class="btn" href="#start">{o.cta}, {o.price}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Una guía para mantenerlo al día.</h2>
        <p class="lede">No administro su perfil mes a mes, así que recibe una guía breve para cuidarlo usted.</p>
      </div>
      <div class="grid grid-4 plain-grid">
        {guide.map((g) => (
          <div>
            <div class="icon"><Icon name={g.icon} size={28} /></div>
            <h3>{g.title}</h3>
            <p class="muted">{g.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="grid grid-2">
        <div>
          <h2 class="mag-head">Lo que no incluye.</h2>
          <p class="lede">Son servicios de configuración y mejora, no de marketing continuo. Con gusto le oriento sobre cualquiera de estos.</p>
        </div>
        <ul class="ticks not-included">{notIncluded.map((n) => <li><span class="dash" aria-hidden="true">–</span>{n}</li>)}</ul>
      </div>
      <div class="band" style="margin-top: 48px">
        <div>
          <h2>Ahorre $150 en un sitio web.</h2>
          <p>Si empieza un sitio web conmigo al mismo tiempo o en los siguientes 6 meses, se abonan $150 del servicio de su perfil.</p>
        </div>
        <div>
          <p class="price" style="font-size: 4rem">$150 menos</p>
          <p>Se abonan a cualquier paquete de sitio web.</p>
          <a class="btn" href="/es/websites/#packages">Ver paquetes de sitios web</a>
        </div>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} alt />
  <InquiryForm kind="website" topic="gbp" />
  <PayBar label="Empezar, $500" />
</Base>
