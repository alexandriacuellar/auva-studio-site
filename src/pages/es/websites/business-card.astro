---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import InquiryForm from '../../../components/InquiryForm.astro';
import Faq from '../../../components/Faq.astro';
import PayBar from '../../../components/PayBar.astro';
import PhoneViewer from '../../../components/PhoneViewer.astro';
import { serviceSchema } from '../../../data/site.es';
import { cardStyles } from '../../../data/cardDemos';

// Escrito para alguien que nunca ha oído hablar de un código QR ni de un Perfil de Negocio de Google.
const steps = [
  { title: 'Escanean su tarjeta', text: 'Sus clientes apuntan la cámara del teléfono al código cuadrado de su tarjeta impresa, volante o ventana. No necesitan ninguna app.' },
  { title: 'Se abre su tarjeta', text: 'Su negocio aparece en su teléfono: su nombre, foto, horario y lo que ofrece.' },
  { title: 'Le contactan con un toque', text: 'Un toque para llamarle o escribirle, ver cómo llegar o guardar su número en su teléfono.' },
];

const included = [
  'Su tarjeta digital, hecha con sus colores y su logo o foto',
  'Botones para llamar, enviar un mensaje o un correo, y ver cómo llegar',
  'Su horario (muestra cuándo está abierto), sus servicios y su Facebook o Instagram',
  'Un botón "Guardar contacto" que le agrega a su teléfono',
  'Un diseño de tarjeta impresa con el código para escanear, listo para enviar a una imprenta',
  'Su propio enlace para compartir por mensaje o correo',
  'Una ronda de cambios, lista en una semana aproximadamente',
];

const addons = [
  { title: 'Su Perfil de Negocio de Google', price: '+$500', text: 'Configuro su perfil, o mejoro el que ya tiene, para que la gente encuentre su horario, fotos y reseñas, y lo enlazo a su tarjeta. $850 por ambos.' },
  { title: 'Dos idiomas', price: '+$150', text: 'Su tarjeta en un segundo idioma de su elección, como inglés, con un botón para cambiar. Incluye las tarjetas de su equipo.' },
  { title: 'Tarjetas para su equipo', price: '$95 por persona', text: 'Una tarjeta igual para cada persona de su equipo, con su propio nombre, foto, enlace y diseño de tarjeta impresa. ¿Diez personas o más? Le doy un precio para su equipo.' },
  { title: '¿Necesita un logo?', price: '$1,000', text: 'No necesita un logo para su tarjeta digital ni para la impresa. Su foto o sus iniciales funcionan muy bien. Si quiere uno, una diseñadora con quien trabajo puede crear su logo y sus colores, y lo agrego a su tarjeta cuando esté listo.', href: '/es/websites/brand-essentials/' },
];

const groups = cardStyles.map((g, i) => ({
  label: `Estilo ${i + 1}`,
  meta: `${g.length} variantes`,
  looksLabel: `Variantes del estilo ${i + 1}`,
  items: g.map((d) => ({ slug: d.slug, name: d.name, short: d.lookEs, href: `/samples/cards/${d.slug}/` })),
}));

const faqs = [
  { q: '¿Qué tengo que enviarle?', a: 'Su logo o una foto suya, su teléfono y correo, su horario, una lista corta de lo que ofrece, una foto de su trabajo o su local, y el enlace a su Perfil de Negocio de Google si tiene uno.' },
  { q: '¿Hay una cuota mensual?', a: 'No. Paga $350 una sola vez. El único costo que sigue es su dirección web (como sunegocio.com), unos $20 al año, que paga a la compañía donde la compra, a su nombre.' },
  { q: '¿Usted imprime las tarjetas?', a: 'Yo las diseño y le envío los archivos, y usted las pide en cualquier imprenta en línea. Así elige el papel y la cantidad, y le paga directamente a la imprenta.' },
  { q: '¿Necesito tener un sitio web?', a: 'No. Su tarjeta digital puede ser el primer lugar donde la gente le encuentra en línea. Si ya tiene un sitio web, la tarjeta puede estar en él y enlazar a él. En ambos casos, su tarjeta va en sunegocio.com/card, así que el código de sus tarjetas impresas sigue funcionando si después agrega un sitio web completo.' },
  { q: '¿Necesito el extra del Perfil de Negocio de Google?', a: 'No. Pero si todavía no tiene un perfil, es buena idea crear uno, porque así la gente le encuentra en Google y Google Maps. Puedo configurarlo por usted, o mejorar el que ya tiene.' },
  { q: '¿Puedo cambiarla después?', a: 'Sí. Los arreglos son gratis durante 30 días. Después, cada cambio cuesta $59.' },
  { q: '¿Es lo mismo que un sitio web completo?', a: 'No. Su tarjeta es una pantalla con lo básico. Un sitio web completo tiene espacio para su historia, fotos, reseñas y un formulario de contacto, y empieza en $1,500. Si agrega el Perfil de Negocio de Google y quiere un sitio web completo dentro de 6 meses, ahorra de $150 a $550.' },
];

const schema = serviceSchema([
  { name: 'Tarjeta de presentación digital', description: 'Una tarjeta de presentación digital que se abre en cualquier teléfono: botones para llamar, escribir y ver cómo llegar, horario, servicios, guardar contacto y un diseño de tarjeta impresa con código QR.', price: '$350' },
], '/es/websites/business-card/');
---
<Base title="Tarjeta de presentación digital" seoTitle="Tarjeta de presentación digital, $350 | Auva Studio" schema={schema} description="Una tarjeta de presentación digital para pequeños negocios del Hudson Valley. Sus clientes la escanean y le llaman, le escriben o guardan su número con un toque. $350, pago único, sin cuota mensual.">
  <section class="hero bd-hero bd-inner-hero">
    <div class="wrap bd-hero-inner">
      <h1 class="mag-head">Una tarjeta de presentación <em>que se abre en su teléfono.</em></h1>
      <p class="lede">Las tarjetas de papel suelen terminar en un cajón. Su nueva tarjeta impresa lleva un código que sus clientes escanean con la cámara del teléfono, y su tarjeta digital se abre ahí mismo, con un toque para llamarle, escribirle, encontrarle o guardar su número.</p>
      <div class="hero-actions">
        <a class="btn" href="#start">Pedir la suya, $350</a>
        <a class="btn btn-ghost" href="#demos">Ver ejemplos <Icon name="arrow" size={18} /></a>
      </div>
      <p class="hero-note">Un solo pago. Sin cuota mensual, y sin ninguna app para sus clientes.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Cómo <em>funciona.</em></h2>
      </div>
      <ol class="steps steps-3">
        {steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band-cream">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Lo que recibe <em>por $350.</em></h2>
        <p class="lede">Hecha para usted, y lista en una semana aproximadamente.</p>
      </div>
      <div class="grid grid-2">
        <div class="card">
          <div class="icon"><Icon name="mail" size={32} /></div>
          <h3>Su tarjeta de presentación digital</h3>
          <p class="price">$350</p>
          <ul class="ticks">{included.map((i) => <li><Icon name="tick" size={18} />{i}</li>)}</ul>
          <a class="btn" href="#start">Pedir la suya, $350</a>
        </div>
        <div class="card">
          <div class="icon"><Icon name="layers" size={32} /></div>
          <h3>Agregue si quiere</h3>
          <ul style="list-style:none;margin:8px 0 0;padding:0">
            {addons.map((a) => (
              <li style="display:grid;gap:2px;padding:10px 0;border-bottom:1px solid var(--line, #e3e7ef)">
                <strong>{a.href ? <a href={a.href}>{a.title}</a> : a.title}, {a.price}</strong>
                <span class="muted">{a.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="alt" id="demos">
    <div class="wrap">
      <div class="section-head">
        <h2 class="mag-head">Vea <em>ejemplos.</em></h2>
        <p class="lede">Seis estilos y 19 variantes, en negocios de ejemplo con datos inventados (los ejemplos están en inglés). Elija un estilo y una variante, y desplácese y toque dentro del teléfono, como lo harán sus clientes. ¿Quiere ver una real? <a href="/es/card/">Esta es la mía.</a></p>
      </div>
      <PhoneViewer lang="es" groups={groups} tabsLabel="Estilos de tarjeta" frameLabel="tarjeta de ejemplo en un teléfono" />
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="band">
        <div>
          <h2>Sin app. Sin cuota mensual.</h2>
          <p>Las tarjetas de apps se ven como la app, llevan su logo y dejan de funcionar cuando deja de pagar. La suya se hace con sus colores, vive en su propia dirección web, incluye el diseño de su tarjeta impresa y es suya.</p>
        </div>
        <div>
          <p class="price" style="font-size: 4rem">$350</p>
          <p>Una vez. Es suya.</p>
          <a class="btn" href="#start">Pedir la suya</a>
        </div>
      </div>
    </div>
  </section>

  <Faq faqs={faqs} alt />
  <InquiryForm kind="website" topic="card" />
  <PayBar label="Pedir la suya, $350" />
</Base>
